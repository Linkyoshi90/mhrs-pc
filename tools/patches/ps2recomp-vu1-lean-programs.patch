+            const int previous = std::fegetround();
+            std::fesetround(FE_TOWARDZERO);
+            int mismatches = 0, overflows = 0, big = 0;
+            for (int round = 0; round < 200000; ++round)
+            {
+                const uint32_t dest = 1u + rng() % 15u;
+                const uint32_t opIndex = rng() % 5u;
+                const uint32_t upper = (dest << 21) | (2u << 16) | (1u << 11) | (3u << 6) | ops[opIndex];
+                VU1Interpreter vu;
+                vu.reset();
+                float expect[4];
+                uint32_t zero = 0u, sign = 0u, under = 0u, over = 0u;
