+// ps2x_vu1_lean_gen [--files N] <outdir> <dump>...: compile VU1 microprograms into lean C++ (ps2_vu1_lean.h).
+//
+// Each <dump> is a vu1-<hash>.bin code image (16 KiB) with a vu1-<hash>.entries list of hex pcs runs started
+// at (PS2_VU1_DUMP_DIR captures them; directories are searched for both). Every entry is compiled as a program
+// that starts from settled pipelines. Its nodes are found by stepping the interpreter (VU1Interpreter on a
+// scratch state, LeanAccess::simPair) along each path from the entry: a node starts at a pc in a timing state
+// and runs to the delay slot of a branch or of the E bit. Programs are keyed by entry and the words they cover,
+// so images that share a program share its code. Writes N (default 8) files <outdir>/vu1_lean_<n>.cpp.
+#include "runtime/ps2_vu1_lean.h"
+#include "runtime/gs/gs_frontend.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <set>
+#include <stdexcept>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace
+{
+    using L = VU1Interpreter::LeanAccess;
+    using Timing = L::Timing;
+    constexpr uint32_t kCodeSize = 0x4000u;
+    constexpr uint64_t kBase = 1u << 20; // the scratch cycle a node starts at
+    constexpr size_t kMaxVariants = 8;   // timing states compiled per pc; more go to the interpreter
+    constexpr size_t kMaxNodes = 4096;   // per program
+    constexpr size_t kMaxNodePairs = 256;
+
+    uint32_t word(const std::vector<uint8_t> &code, uint32_t at)
+    {
+        uint32_t w = 0;
+        std::memcpy(&w, code.data() + at, 4);
+        return w;
+    }
+
+    int32_t imm11(uint32_t lower)
+    {
+        const int32_t v = static_cast<int32_t>(lower & 0x7FFu);
+        return (v & 0x400) != 0 ? v - 0x800 : v;
+    }
+
+    // Lower branch ops: B 0x20, BAL 0x21, JR 0x24, JALR 0x25, IBxx 0x28/0x29/0x2C-0x2F.
+    uint32_t branchOp(uint32_t lower, uint32_t upper)
+    {
+        if ((upper & 0x80000000u) != 0u)
+            return 0u;
+        const uint32_t op = lower >> 25;
+        return op == 0x20u || op == 0x21u || op == 0x24u || op == 0x25u || op == 0x28u || op == 0x29u || (op >= 0x2Cu && op <= 0x2Fu) ? op : 0u;
+    }
+
+    uint32_t branchTarget(uint32_t pc, uint32_t lower) { return (pc + 8u + static_cast<uint32_t>(imm11(lower) * 8)) & (kCodeSize - 1u); }
+
+    // Return addresses of BAL/JALR reachable from entry: the targets a JR of the program is compiled for.
+    std::vector<uint32_t> returnAddresses(const std::vector<uint8_t> &code, uint32_t entry)
+    {
+        std::set<uint32_t> seen, rets;
+        std::vector<uint32_t> work{entry};
+        while (!work.empty())
+        {
+            uint32_t pc = work.back();
+            work.pop_back();
+            while (pc + 8u <= kCodeSize && seen.insert(pc).second)
+            {
+                const uint32_t lower = word(code, pc), upper = word(code, pc + 4u);
+                const uint32_t op = branchOp(lower, upper);
+                if (op == 0x21u || op == 0x25u)
+                {
+                    rets.insert((pc + 16u) & (kCodeSize - 1u));
+                    work.push_back((pc + 16u) & (kCodeSize - 1u));
+                }
+                if (op != 0u && op != 0x24u && op != 0x25u)
+                    work.push_back(branchTarget(pc, lower));
+                if (op == 0x20u || op == 0x21u || op == 0x24u || op == 0x25u || (upper & 0x40000000u) != 0u)
+                    break; // the delay slot is part of this path, nothing after it
+                pc += 8u;
+            }
+        }
+        return {rets.begin(), rets.end()};
+    }
+
+    struct Exit
+    {
+        enum Kind { Goto, Cond, Jump, End, Leave } kind = Leave;
+        uint32_t pc = 0;          // Goto/Leave: target; Cond: taken target; End: the pc after the program
+        uint32_t fallthrough = 0; // Cond
+        Timing timing{};          // the successors' (or the leave's) timing state
+        uint32_t rel = 0;         // cycle, relative to the node's start, the exit happens at
+        std::vector<int> targets; // successor node ids (Goto: 1, Cond: taken, not taken; Jump: per candidate)
+        std::vector<uint32_t> candidates; // Jump
+    };
+
+    struct PairCode
+    {
+        uint32_t pc = 0, lower = 0, upper = 0;
+        uint32_t from = 0, issue = 0; // relative to the node start
+        uint8_t saveUpper = 0, saveLower = 0;
+        bool viPending = false, saveVi = false;
+        bool store = false, kick = false, branch = false;
+        bool fmacFlags = false, readsFlags = false; // queues a MAC/status entry; reads MAC or status
+        bool elide = false;                        // its entry is never observed: only its sticky bits count
+        Timing before{};           // kick: the timing state at from, for leaving there
+        uint32_t settle = 0;       // kick: from this cycle on (relative) a wait has landed everything in flight
+        int settled = -1;          // kick: the node at this pc after such a wait
+        std::vector<uint32_t> commits; // Q/P result cycles landing before this pair (relative)
+    };
+
+    struct Node
+    {
+        uint32_t pc = 0;
+        Timing timing{};
+        std::vector<PairCode> pairs;
+        std::vector<uint32_t> exitCommits;
+        Exit exit;
+        uint32_t lastIssue = 0;
+    };
+
+    struct Program
+    {
+        uint32_t entry = 0;
+        std::vector<Node> nodes;
+        std::map<uint32_t, std::pair<uint32_t, uint32_t>> covered; // pc -> words
+        size_t pairCount() const { return covered.size(); }
+    };
+
+    GS g_gs;
+    VU1Interpreter g_sim;
+    std::array<uint8_t, 0x4000> g_simData{};
+
+    // Cycles until everything in flight in t has landed.
+    uint32_t settleTime(const Timing &t)
+    {
+        uint32_t m = std::max({t.fdiv, t.efu[0], t.efu[1], t.efuResource, t.inflight});
+        for (uint8_t r : t.ready)
+            m = std::max<uint32_t>(m, r);
+        for (uint32_t i = 0; i < t.flagCount; ++i)
+            m = std::max<uint32_t>(m, t.flags[i]);
+        return m;
+    }
+
+    void pendingOf(const Timing &t, std::vector<L::Pending> &out)
+    {
+        out.clear();
+        for (size_t slot = 0; slot < t.ready.size(); ++slot)
+            if (t.ready[slot] != 0u)
+                out.push_back({static_cast<uint8_t>(slot), t.ready[slot]});
+    }
+
+    // Simulates the node at pc in timing t. Successor (pc, timing) keys go into exit.
+    Node simulateNode(const std::vector<uint8_t> &code, uint32_t startPc, const Timing &t, const std::vector<uint32_t> &returns,
+                      Program &program)
+    {
+        Node node;
+        node.pc = startPc;
+        node.timing = t;
+        L::simLoad(g_sim, t, kBase);
+        // Owner of each scoreboard slot's in-flight write chain in this node: {pair, 0 upper / 1 lower / 2 VI}.
+        std::array<std::pair<int, int>, 144> owner;
+        owner.fill({-1, 0});
+        std::set<uint64_t> outstanding; // Q/P due cycles
+        {
+            uint64_t due[3];
+            L::simQueued(g_sim, due);
+            for (uint64_t d : due)
+                if (d != 0u)
+                    outstanding.insert(d);
+        }
+        std::vector<uint32_t> landed; // commit cycles not yet placed
+        const auto markPending = [&](const std::array<uint64_t, 144> &ready, uint64_t at)
+        {
+            for (size_t slot = 0; slot < ready.size(); ++slot)
+                if (ready[slot] > at && owner[slot].first >= 0)
+                {
+                    PairCode &p = node.pairs[owner[slot].first];
+                    if (owner[slot].second == 0)
+                        p.saveUpper |= static_cast<uint8_t>(1u << (3u - slot % 4u));
+                    else if (owner[slot].second == 1)
+                        p.saveLower |= static_cast<uint8_t>(1u << (3u - slot % 4u));
+                    else
+                        p.saveVi = true;
+                }
+        };
+        const auto leaveBefore = [&](uint32_t pc, const Timing &before, uint32_t fromRel)
+        {
+            node.exit.kind = Exit::Leave;
+            node.exit.pc = pc;
+            node.exit.timing = before;
+            node.exit.rel = fromRel;
+        };
+
+        uint32_t pc = startPc;
+        int branchAt = -1;
+        bool endAfterNext = false;
+        bool ranToEnd = true;
+        for (;;)
+        {
+            const uint32_t lower = word(code, pc), upper = word(code, pc + 4u);
+            const auto pair = L::decode(lower, upper);
+            const bool inDelaySlot = branchAt >= 0 || endAfterNext;
+            const uint64_t from = L::cycle(g_sim);
+            const Timing before = L::simSave(g_sim);
+            const uint32_t fromRel = static_cast<uint32_t>(from - kBase);
+            const uint32_t op = branchOp(lower, upper);
+            bool unsupported = L::reserved(pair);
+            if (!inDelaySlot && (op != 0u || pair.eBit))
+            {
+                // The delay slot runs inside this node: anything it cannot hold leaves before this pair.
+                const uint32_t next = (pc + 8u) & (kCodeSize - 1u);
+                const auto slot = L::decode(word(code, next), word(code, next + 4u));
+                unsupported |= L::reserved(slot) || branchOp(slot.lower, slot.upper) != 0u || slot.eBit || L::isXgkick(slot) ||
+                               slot.fmacUndeclaredFs != 0u || slot.fmacUndeclaredFt != 0u || (op != 0u && pair.eBit);
+            }
+            if (!unsupported && !inDelaySlot && (pair.fmacUndeclaredFs != 0u || pair.fmacUndeclaredFt != 0u))
+            {
+                // Lanes read without a stall: the lean code reads the register as it is, so none may be in flight.
+                // The issue cycle is not known yet; any write still due after from is in flight then or later.
+                for (int lane : L::undeclaredLanes(pair))
+                    if (lane >= 0 && L::simReady(g_sim)[lane] > from)
+                        unsupported = true;
+            }
+            if (unsupported)
+            {
+                if (inDelaySlot)
+                    throw std::runtime_error("unsupported pair in a delay slot"); // excluded above
+                markPending(L::simReady(g_sim), from);
+                leaveBefore(pc, before, fromRel);
+                ranToEnd = false;
+                break;
+            }
+
+            const std::array<uint64_t, 144> readyBefore = L::simReady(g_sim);
+            PairCode code_{};
+            code_.pc = pc;
+            code_.lower = lower;
+            code_.upper = upper;
+            code_.from = fromRel;
+            code_.store = L::storesVuData(pair);
+            code_.fmacFlags = L::queuesMacFlags(pair);
+            code_.readsFlags = L::readsMacFlags(pair);
+            code_.kick = L::isXgkick(pair);
+            code_.branch = op != 0u;
+            if (code_.kick)
+            {
+                code_.before = before;
+                code_.settle = fromRel + settleTime(before);
+                markPending(readyBefore, from); // it may leave before this pair
+            }
+            const uint64_t issue = L::simPair(g_sim, pc, pair);
+            code_.issue = static_cast<uint32_t>(issue - kBase);
+            // Q/P results that landed while this pair stepped (stall cycles and the step after it).
+            {
+                uint64_t due[3];
+                L::simQueued(g_sim, due);
+                std::set<uint64_t> now;
+                for (uint64_t d : due)
+                    if (d != 0u)
+                        now.insert(d);
+                for (uint64_t d : outstanding)
+                    if (!now.count(d))
+                        landed.push_back(static_cast<uint32_t>(d - kBase));
+                outstanding = now;
+            }
+            const size_t index = node.pairs.size();
+            // Chain starts: a write to a slot with nothing in flight at issue starts a chain.
+            const auto w = L::vfWrites(pair);
+            for (int which = 0; which < 2; ++which)
+            {
+                const uint8_t reg = w[which * 2], lanes = w[which * 2 + 1];
+                if (reg == 0u)
+                    continue;
+                for (uint32_t c = 0; c < 4u; ++c)
+                    if ((lanes & (1u << (3u - c))) != 0u && readyBefore[reg * 4u + c] <= issue)
+                        owner[reg * 4u + c] = {static_cast<int>(index), which};
+            }
+            if (const uint8_t vi = L::viWrite(pair); vi != 0u)
+            {
+                const size_t slot = 128u + vi;
+                code_.viPending = readyBefore[slot] > issue;
+                if (!code_.viPending)
+                    owner[slot] = {static_cast<int>(index), 2};
+                else if (L::recordsBranchBackup(pair) && owner[slot].first >= 0)
+                    node.pairs[owner[slot].first].saveVi = true; // its old value comes from the chain start
+            }
+            node.pairs.push_back(code_);
+            program.covered[pc] = {lower, upper};
+            node.lastIssue = code_.issue;
+
+            if (inDelaySlot)
+                break;
+            if (op != 0u)
+                branchAt = static_cast<int>(index);
+            else if (pair.eBit)
+                endAfterNext = true;
+            pc = (pc + 8u) & (kCodeSize - 1u);
+            if (branchAt < 0 && !endAfterNext && node.pairs.size() >= kMaxNodePairs)
+            {
+                node.exit.kind = Exit::Goto;
+                node.exit.pc = pc;
+                break;
+            }
+        }
+
+        const uint64_t x = L::cycle(g_sim);
+        if (ranToEnd)
+        {
+            // The node ran to its end: exits at x.
+            node.exit.rel = static_cast<uint32_t>(x - kBase);
+            node.exit.timing = L::simSave(g_sim);
+            if (!endAfterNext) // the program end lands everything
+                markPending(L::simReady(g_sim), x);
+            if (endAfterNext)
+            {
+                node.exit.kind = Exit::End;
+                node.exit.pc = (node.pairs.back().pc + 8u) & (kCodeSize - 1u);
+            }
+            else if (branchAt >= 0)
+            {
+                const PairCode &b = node.pairs[branchAt];
+                const uint32_t bop = branchOp(b.lower, b.upper);
+                if (bop == 0x20u || bop == 0x21u)
+                {
+                    node.exit.kind = Exit::Goto;
+                    node.exit.pc = branchTarget(b.pc, b.lower);
+                }
+                else if (bop == 0x24u || bop == 0x25u)
+                {
+                    node.exit.kind = Exit::Jump;
+                    node.exit.candidates = returns;
+                }
+                else
+                {
+                    node.exit.kind = Exit::Cond;
+                    node.exit.pc = branchTarget(b.pc, b.lower);
+                    node.exit.fallthrough = (b.pc + 16u) & (kCodeSize - 1u);
+                }
+            }
+        }
+        // MAC/status entries nothing observes: at each point that can (a MAC/status read at its issue, an XGKICK at
+        // from: it may leave or wait, the node exit), keep the entries still in flight and the latest landed one.
+        {
+            std::vector<uint32_t> points;
+            for (const PairCode &p : node.pairs)
+            {
+                if (p.readsFlags)
+                    points.push_back(p.issue);
+                if (p.kick)
+                    points.push_back(p.from);
+            }
+            points.push_back(node.exit.rel);
+            for (PairCode &p : node.pairs)
+                p.elide = p.fmacFlags;
+            for (uint32_t t : points)
+            {
+                int latest = -1;
+                for (size_t i = 0; i < node.pairs.size(); ++i)
+                {
+                    PairCode &p = node.pairs[i];
+                    if (!p.fmacFlags || p.issue > t)
+                        continue;
+                    if (p.issue + L::kFlagLatency > t)
+                        p.elide = false; // in flight
+                    else if (latest < 0 || p.issue >= node.pairs[latest].issue)
+                        latest = static_cast<int>(i);
+                }
+                if (latest >= 0)
+                    node.pairs[latest].elide = false;
+            }
+        }
+        // Place the landed Q/P results: before the first pair issuing at or after them, else at the exit.
+        std::sort(landed.begin(), landed.end());
+        landed.erase(std::unique(landed.begin(), landed.end()), landed.end());
+        size_t next = 0;
+        for (PairCode &p : node.pairs)
+            while (next < landed.size() && landed[next] <= p.issue)
+                p.commits.push_back(landed[next++]);
+        while (next < landed.size() && landed[next] <= node.exit.rel)
+            node.exitCommits.push_back(landed[next++]);
+        return node;
+    }
+
+    struct TimingLess
+    {
+        bool operator()(const Timing &a, const Timing &b) const
+        {
+            return std::memcmp(&a, &b, sizeof(Timing)) < 0;
+        }
+    };
+
+    Program compileProgram(const std::vector<uint8_t> &code, uint32_t entry)
+    {
+        Program program;
+        program.entry = entry;
+        const std::vector<uint32_t> returns = returnAddresses(code, entry);
+        std::map<uint32_t, std::map<Timing, int, TimingLess>> ids;
+        std::vector<std::pair<uint32_t, Timing>> work;
+        const auto idOf = [&](uint32_t pc, const Timing &t) -> int
+        {
+            auto &variants = ids[pc];
+            if (auto it = variants.find(t); it != variants.end())
+                return it->second;
+            if (variants.size() >= kMaxVariants || work.size() >= kMaxNodes)
+                return -1;
+            const int id = static_cast<int>(work.size());
+            variants.emplace(t, id);
+            work.push_back({pc, t});
+            return id;
+        };
+        idOf(entry, Timing{});
+        // Nodes get ids in creation order; simulate in that order so node i is program.nodes[i].
+        for (size_t i = 0; i < work.size(); ++i)
+        {
+            const auto [pc, t] = work[i];
+            program.nodes.push_back(simulateNode(code, pc, t, returns, program));
+            Node &node = program.nodes.back();
+            for (PairCode &p : node.pairs)
+                if (p.kick)
+                {
+                    Timing settled{}; // a wait at the kick lands everything; the VI a branch reads stays
+                    settled.backupReg = p.before.backupReg;
+                    p.settled = idOf(p.pc, settled);
+                }
+            Exit &e = node.exit;
+            const Timing succ = e.timing;
+            if (e.kind == Exit::Goto)
+                e.targets = {idOf(e.pc, succ)};
+            else if (e.kind == Exit::Cond)
+                e.targets = {idOf(e.pc, succ), idOf(e.fallthrough, succ)};
+            else if (e.kind == Exit::Jump)
+                for (uint32_t c : e.candidates)
+                    e.targets.push_back(idOf(c, succ));
+        }
+        return program;
+    }
+
+    std::string hex(uint32_t v)
+    {
+        char buf[16];
+        std::snprintf(buf, sizeof(buf), "0x%Xu", v);
+        return buf;
+    }
+
+    void emitPending(std::ostream &os, const std::string &name, const Timing &t)
+    {
+        std::vector<L::Pending> pending;
+        pendingOf(t, pending);
+        if (pending.empty())
+            return;
+        os << "    static constexpr L::Pending " << name << "[] = {";
+        for (size_t i = 0; i < pending.size(); ++i)
+            os << (i ? ", " : "") << "{" << unsigned(pending[i].slot) << ", " << unsigned(pending[i].rel) << "}";
+        os << "};\n";
+    }
+
+    std::string leaveCall(const std::string &name, const Timing &t, const std::string &cycle, const std::string &pc)
+    {
+        std::vector<L::Pending> pending;
+        pendingOf(t, pending);
+        std::ostringstream os;
+        os << "return L::leave(vu, " << cycle << ", " << pc << ", " << (pending.empty() ? "nullptr" : name) << ", "
+           << pending.size() << "u, " << unsigned(t.inflight) << "u);";
+        return os.str();
+    }
+
+    void emitProgram(std::ostream &os, const Program &program, size_t index)
+    {
+        bool fsset = false;
+        for (const auto &[pc, words] : program.covered)
+            fsset |= L::isFsset(L::decode(words.first, words.second));
+        os << "namespace p" << index << "\n{\n";
+        for (size_t n = 0; n < program.nodes.size(); ++n)
+            os << "int n" << n << "(VU &vu, uint64_t base, uint64_t budgetEnd);\n";
+        for (size_t n = 0; n < program.nodes.size(); ++n)
+        {
+            const Node &node = program.nodes[n];
+            os << "\n// " << hex(node.pc) << "\nVU1_NO_STACK_PROTECTOR int n" << n << "(VU &vu, uint64_t base, uint64_t budgetEnd)\n{\n";
+            emitPending(os, "kEntry", node.timing);
+            os << "    if (!L::enter(vu, base, budgetEnd, " << node.lastIssue << "u))\n        "
+               << leaveCall("kEntry", node.timing, "base", hex(node.pc)) << "\n";
+            for (size_t i = 0; i < node.pairs.size(); ++i)
+            {
+                const PairCode &p = node.pairs[i];
+                os << "    // " << hex(p.pc) << "\n";
+                size_t c = 0;
+                for (; c < p.commits.size() && p.commits[c] <= p.from; ++c)
+                    os << "    L::commit(vu, base + " << p.commits[c] << "u);\n";
+                if (p.kick)
+                {
+                    const std::string name = "kKick" + std::to_string(i);
+                    os << "    {\n";
+                    emitPending(os, name, p.before);
+                    std::vector<L::Pending> pending;
+                    pendingOf(p.before, pending);
+                    os << "    if (L::kickBusy(vu, base + " << p.issue << "u))\n    {\n"
+                       << "        const uint64_t cycle = L::kickWait(vu, base + " << p.issue << "u, budgetEnd);\n";
+                    if (p.settled >= 0)
+                        os << "        if (cycle >= base + " << p.settle << "u && cycle < budgetEnd)\n"
+                           << "            VU1_MUSTTAIL return n" << p.settled << "(vu, cycle, budgetEnd);\n";
+                    os << "        return L::leaveAfterWait(vu, base + " << p.from << "u, cycle, " << hex(p.pc) << ", "
+                       << (pending.empty() ? "nullptr" : name) << ", " << pending.size() << "u, " << unsigned(p.before.inflight)
+                       << "u);\n    }\n    }\n";
+                }
+                for (; c < p.commits.size(); ++c)
+                    os << "    L::commit(vu, base + " << p.commits[c] << "u);\n";
+                os << "    L::at(vu, base + " << p.issue << "u);\n";
+                if (p.store)
+                    os << "    L::beforeStore(vu, base + " << p.issue << "u);\n";
+                if (p.branch)
+                    os << "    vu.state().pc = " << hex(p.pc) << ";\n";
+                os << "    L::pair<" << hex(p.lower) << ", " << hex(p.upper) << ", " << unsigned(p.saveUpper) << ", "
+                   << unsigned(p.saveLower) << ", " << (p.viPending ? "true" : "false") << ", " << (p.saveVi ? "true" : "false")
+                   << (p.elide && !fsset ? ", true" : "") << ">(vu);\n";
+                if (p.branch)
+                    os << "    const bool taken = L::taken(vu);\n    const uint32_t target = L::target(vu);\n    (void)taken, (void)target;\n";
+            }
+            for (uint32_t c : node.exitCommits)
+                os << "    L::commit(vu, base + " << c << "u);\n";
+            const Exit &e = node.exit;
+            const std::string at = "base + " + std::to_string(e.rel) + "u";
+            const auto go = [&](int target, uint32_t pc, const std::string &name) -> std::string
+            {
+                if (target < 0)
+                    return leaveCall(name, e.timing, at, hex(pc));
+                return "VU1_MUSTTAIL return n" + std::to_string(target) + "(vu, " + at + ", budgetEnd);";
+            };
+            if (e.kind != Exit::Leave && e.kind != Exit::End)
+                emitPending(os, "kExit", e.timing);
+            switch (e.kind)
+            {
+            case Exit::Leave:
+                emitPending(os, "kLeave", e.timing);
+                os << "    " << leaveCall("kLeave", e.timing, at, hex(e.pc)) << "\n";
+                break;
+            case Exit::Goto:
+                os << "    " << go(e.targets[0], e.pc, "kExit") << "\n";
+                break;
+            case Exit::Cond:
+                os << "    if (taken)\n        " << go(e.targets[0], e.pc, "kExit") << "\n    " << go(e.targets[1], e.fallthrough, "kExit") << "\n";
+                break;
+            case Exit::Jump:
+            {
+                std::vector<L::Pending> pending;
+                pendingOf(e.timing, pending);
+                os << "    switch (target)\n    {\n";
+                for (size_t c = 0; c < e.candidates.size(); ++c)
+                    if (e.targets[c] >= 0)
+                        os << "    case " << hex(e.candidates[c]) << ":\n        " << go(e.targets[c], e.candidates[c], "kExit") << "\n";
+                os << "    default:\n        " << leaveCall("kExit", e.timing, at, "target") << "\n    }\n";
+                break;
+            }
+            case Exit::End:
+                os << "    return L::end(vu, " << at << ", " << hex(e.pc) << ", " << unsigned(e.timing.inflight) << "u);\n";
+                break;
+            }
+            os << "}\n";
+        }
+        os << "const uint32_t kPairs[] = {";
+        size_t k = 0;
+        for (const auto &[pc, words] : program.covered)
+            os << (k++ % 4 == 0 ? "\n    " : " ") << hex(pc) << ", " << hex(words.first) << ", " << hex(words.second) << ",";
+        os << "\n};\n} // namespace p" << index << "\n\n";
+    }
+
+    bool readFile(const std::filesystem::path &path, std::vector<uint8_t> &out)
+    {
+        std::ifstream in(path, std::ios::binary);
+        if (!in)
+            return false;
+        out.assign(std::istreambuf_iterator<char>(in), {});
+        return true;
+    }
+}
+
+int main(int argc, char **argv)
+{
+    size_t files = 8;
+    std::vector<std::string> args(argv + 1, argv + argc);
+    if (args.size() >= 2 && args[0] == "--files")
+    {
+        files = std::max<size_t>(1, std::stoul(args[1]));
+        args.erase(args.begin(), args.begin() + 2);
+    }
+    if (args.size() < 2)
+    {
+        std::fprintf(stderr, "usage: ps2x_vu1_lean_gen [--files N] <outdir> <dump.bin|program.txt|dir>...\n");
+        return 2;
+    }
+    const std::filesystem::path outDir = args[0];
+    std::vector<std::filesystem::path> dumps;
+    for (size_t i = 1; i < args.size(); ++i)
+    {
+        if (std::filesystem::is_directory(args[i]))
+        {
+            for (const auto &entry : std::filesystem::directory_iterator(args[i]))
+                if (entry.path().extension() == ".bin" || entry.path().extension() == ".txt")
+                    dumps.push_back(entry.path());
+        }
+        else
+            dumps.push_back(args[i]);
+    }
+    std::sort(dumps.begin(), dumps.end());
+
+    L::simStart(g_sim, g_gs, g_simData.data(), static_cast<uint32_t>(g_simData.size()));
+    std::map<std::string, Program> programs; // by entry + covered words
+    size_t compiled = 0;
+    for (const auto &dump : dumps)
+    {
+        std::vector<uint8_t> code;
+        if (dump.extension() == ".txt")
+        {
+            // A program as text: one "lower upper" hex word pair per line from pc 0 ('#' comments), entered at 0.
+            code.assign(kCodeSize, 0u);
+            std::ifstream text(dump);
+            std::string textLine;
+            for (uint32_t pc = 0; pc + 8u <= kCodeSize && std::getline(text, textLine);)
+            {
+                std::istringstream fields(textLine.substr(0, textLine.find('#')));
+                std::string lower, upper;
+                if (!(fields >> lower >> upper))
+                    continue;
+                const uint32_t words[2] = {static_cast<uint32_t>(std::stoul(lower, nullptr, 16)),
+                                           static_cast<uint32_t>(std::stoul(upper, nullptr, 16))};
+                std::memcpy(code.data() + pc, words, sizeof(words));
+                pc += 8u;
+            }
+        }
+        else if (!readFile(dump, code) || code.size() != kCodeSize)
+            continue;
+        std::vector<uint32_t> entries;
+        std::ifstream in(std::filesystem::path(dump).replace_extension(".entries"));
+        std::string line;
+        while (in >> line)
+            entries.push_back(static_cast<uint32_t>(std::stoul(line, nullptr, 16)) & (kCodeSize - 1u) & ~7u);
+        if (entries.empty())
+            entries.push_back(0u);
+        std::sort(entries.begin(), entries.end());
+        entries.erase(std::unique(entries.begin(), entries.end()), entries.end());
+        for (uint32_t entry : entries)
+        {
+            Program program = compileProgram(code, entry);
+            ++compiled;
+            if (program.pairCount() == 0u)
+                continue; // it leaves before its first pair: the interpreter runs it
+            std::string key = std::to_string(entry);
+            for (const auto &[pc, words] : program.covered)
+                key += "," + std::to_string(pc) + ":" + std::to_string(words.first) + ":" + std::to_string(words.second);
+            programs.emplace(std::move(key), std::move(program));
+        }
+    }
+
+    std::filesystem::create_directories(outDir);
+    for (const auto &entry : std::filesystem::directory_iterator(outDir))
+        if (entry.path().filename().string().starts_with("vu1_lean_") && entry.path().extension() == ".cpp")
+            std::filesystem::remove(entry.path());
+    std::vector<std::ostringstream> outs(files);
+    std::vector<size_t> sizes(files);
+    std::vector<std::vector<std::pair<size_t, uint32_t>>> registered(files);
+    size_t index = 0, nodes = 0, pairs = 0, leaves = 0;
+    for (const auto &[key, program] : programs)
+    {
+        const size_t f = static_cast<size_t>(std::min_element(sizes.begin(), sizes.end()) - sizes.begin());
+        emitProgram(outs[f], program, index);
+        registered[f].push_back({index, program.entry});
+        size_t programPairs = 0;
+        for (const Node &node : program.nodes)
+        {
+            programPairs += node.pairs.size();
+            leaves += node.exit.kind == Exit::Leave;
+        }
+        sizes[f] += programPairs;
+        nodes += program.nodes.size();
+        pairs += programPairs;
+        ++index;
+    }
+    for (size_t f = 0; f < files; ++f)
+    {
+        std::ofstream out(outDir / ("vu1_lean_" + std::to_string(f) + ".cpp"));
+        out << "// Generated by ps2x_vu1_lean_gen. Do not edit.\n#include \"runtime/ps2_vu1_lean.h\"\n\nnamespace\n{\n"
+               "using L = VU1Interpreter::LeanAccess;\nusing VU = VU1Interpreter;\n\n"
+            << outs[f].str() << "const VU1Interpreter::LeanProgram kPrograms[] = {\n";
+        for (const auto &[i, entry] : registered[f])
+            out << "    {" << hex(entry) << ", static_cast<uint32_t>(std::size(p" << i << "::kPairs) / 3u), p" << i << "::kPairs, &p" << i << "::n0},\n";
+        out << "};\nstruct Register\n{\n    Register() { VU1Interpreter::registerLeanPrograms(kPrograms, std::size(kPrograms)); }\n} registerPrograms;\n}\n";
+    }
+    std::printf("%zu entries -> %zu programs, %zu nodes, %zu pairs (%zu nodes leave to the interpreter) in %zu files\n", compiled,
+                programs.size(), nodes, pairs, leaves, files);
+    return 0;
+}
