+        tc.Run("FMAC results at and above 2^127 match a long double reference", [](TestCase &t)
+        {
+            // The exact path decides overflow from the double result unless it is within 2^-50 of FLT_MAX: compare it
+            // with the long double result (value, MAC and status flags) on big operands, FLT_MAX ones and sums that
+            // cancel to just around FLT_MAX.
+            std::mt19937 rng(127u);
+            const auto randomFloat = [&]() -> float
+            {
+                uint32_t exponent;
+                switch (rng() % 4u)
+                {
+                case 0: exponent = 0xF0u + rng() % 16u; break;
+                case 1: exponent = 0x7Fu + rng() % 8u; break;
+                case 2: return (rng() & 1u) ? -std::numeric_limits<float>::max() : std::numeric_limits<float>::max();
+                default: exponent = 0x40u + rng() % 0xC0u; break;
+                }
+                return std::bit_cast<float>(static_cast<uint32_t>(((rng() & 1u) << 31) | (exponent << 23) | (rng() & 0x7FFFFFu)));
+            };
+            // The VU's operands: denormals are zero, Inf/NaN are FLT_MAX.
+            const auto vuOperand = [](float v)
+            {
+                const uint32_t bits = std::bit_cast<uint32_t>(v);
+                if ((bits & 0x7F800000u) == 0u)
+                    return std::bit_cast<float>(bits & 0x80000000u);
+                if ((bits & 0x7F800000u) == 0x7F800000u)
+                    return std::bit_cast<float>((bits & 0x80000000u) | 0x7F7FFFFFu);
+                return v;
+            };
