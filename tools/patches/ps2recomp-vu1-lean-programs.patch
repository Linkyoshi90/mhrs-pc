+        vu.m_viBranchBackupValid = false;
+        if constexpr (writtenVi != 0u)
+        {
+            vu.m_state.vi[writtenVi] = static_cast<int16_t>(vu.m_state.vi[writtenVi]);
+            if constexpr (kSaveVi)
+                vu.m_viChainStart[writtenVi] = oldVi;
+            if constexpr (kPair.lowerUsage.delaysNextBranchRead)
+                vu.recordViWriteForBranch(writtenVi, oldVi);
+        }
+        vu.m_state.vf[0][0] = 0.0f;
+        vu.m_state.vf[0][1] = 0.0f;
+        vu.m_state.vf[0][2] = 0.0f;
+        vu.m_state.vf[0][3] = 1.0f;
+        vu.m_state.vi[0] = 0;
+    }
+
+    // After a branch pair: whether it branches (JR/JALR/B/BAL always do), and where to.
+    static VU1_ALWAYS_INLINE bool taken(VU1Interpreter &vu)
+    {
+        const bool branch = vu.m_state.branchPending;
+        vu.m_state.branchPending = false;
+        vu.m_state.branchDelay = 0u; // stepPair counts it down through the branch pair
+        return branch;
+    }
+    static VU1_ALWAYS_INLINE uint32_t target(const VU1Interpreter &vu) { return vu.m_state.branchTarget & 0x3FFFu; }
+
+    // Back to the interpreter before the pair at pc, at cycle: the scoreboard entries and in-flight
+    // bookkeeping of the writes still in flight (pending, inflightRel: the latest write's due cycle), and PATH1.
+    static VU1_NOINLINE int leave(VU1Interpreter &vu, uint64_t cycle, uint32_t pc, const Pending *pending, uint32_t count,
+                                  uint32_t inflightRel)
+    {
+        vu.m_cycle = cycle;
+        vu.m_state.cycles = cycle;
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            const uint32_t slot = pending[i].slot;
+            vu.m_ready[slot] = cycle + pending[i].rel;
+            if (slot < kViSlot)
+                vu.m_vfWrittenLanes[slot / 4u] |= laneForComponent(slot % 4u);
+            else
+                vu.m_viWritten |= static_cast<uint16_t>(1u << (slot - kViSlot));
+        }
+        vu.m_inflightReady = std::max(vu.m_inflightReady, cycle + inflightRel);
+        kickTo(vu, cycle);
+        vu.m_state.pc = pc;
+        return CompiledAccess::kLeave;
+    }
+
+    // leave() with the timing state of cycle from, after a wait until cycle (kickWait).
+    static VU1_NOINLINE int leaveAfterWait(VU1Interpreter &vu, uint64_t from, uint64_t cycle, uint32_t pc,
+                                           const Pending *pending, uint32_t count, uint32_t inflightRel)
+    {
+        leave(vu, from, pc, pending, count, inflightRel);
+        vu.m_cycle = cycle;
+        vu.m_state.cycles = cycle;
+        return CompiledAccess::kLeave;
+    }
+
+    // The program ended after the pair before cycle; the interpreter's run() flushes the pipelines.
+    static VU1_NOINLINE int end(VU1Interpreter &vu, uint64_t cycle, uint32_t nextPc, uint32_t inflightRel)
+    {
+        vu.m_cycle = cycle;
+        vu.m_inflightReady = std::max(vu.m_inflightReady, cycle + inflightRel);
+        kickTo(vu, cycle);
+        vu.m_state.pc = nextPc;
+        return CompiledAccess::kEnded;
+    }
+
+    // ---- used by the generator: the interpreter's timing on a scratch VU1Interpreter ----
+
+    // Timing state relative to a cycle: everything that decides when later pairs issue and when results land.
+    struct Timing
+    {
+        std::array<uint8_t, kViSlot + 16u> ready{}; // cycles until each scoreboard slot's write lands
+        uint8_t fdiv = 0;                            // until a queued Q lands (0: none)
+        std::array<uint8_t, 2> efu{};                // until queued P results land
+        uint8_t efuResource = 0;
+        std::array<uint8_t, 8> flags{};              // until flag entries still in flight land, oldest first
+        uint8_t flagCount = 0;
+        uint8_t inflight = 0;                        // until the latest issued VF/VI write lands
+        uint8_t backupReg = 0;                       // VI whose pre-write value a branch next reads (0: none)
+        bool operator==(const Timing &) const = default;
+    };
+
+    // data: VU data memory for the scratch run (its contents do not matter).
+    static void simStart(VU1Interpreter &sim, GS &gs, uint8_t *data, uint32_t dataSize)
+    {
+        sim.reset();
+        sim.m_activeVuData = data;
+        sim.m_activeVuDataSize = dataSize;
+        sim.m_activeGs = &gs;
+        sim.m_activeMemory = nullptr;
+    }
+
+    static uint64_t cycle(const VU1Interpreter &sim) { return sim.m_cycle; }
+
+    static void simLoad(VU1Interpreter &sim, const Timing &t, uint64_t now)
+    {
+        sim.resetScheduler();
+        sim.m_cycle = now;
+        for (size_t slot = 0; slot < t.ready.size(); ++slot)
+            sim.m_ready[slot] = t.ready[slot] != 0u ? now + t.ready[slot] : 0u;
+        if (t.fdiv != 0u)
+        {
+            sim.m_fdiv.valid = true;
+            sim.m_fdiv.readyCycle = now + t.fdiv;
+            sim.noteReadyCycle(sim.m_fdiv.readyCycle);
+        }
+        for (size_t i = 0; i < 2u; ++i)
+            if (t.efu[i] != 0u)
+            {
+                sim.m_efu[i].valid = true;
+                sim.m_efu[i].readyCycle = now + t.efu[i];
+                sim.noteReadyCycle(sim.m_efu[i].readyCycle);
+            }
+        sim.m_efuResourceReady = t.efuResource != 0u ? now + t.efuResource : 0u;
+        for (uint32_t i = 0; i < t.flagCount; ++i)
+        {
+            FlagPipelineEntry &entry = sim.m_flagPipeline[i];
+            entry = {};
+            entry.valid = true;
+            entry.issueCycle = now - 1u;
+            entry.readyCycle = now + t.flags[i];
+        }
+        sim.m_flagCount = t.flagCount;
+        sim.m_inflightReady = now + t.inflight;
+        sim.m_viBranchBackupValid = t.backupReg != 0u;
+        sim.m_viBranchBackupReg = t.backupReg;
+    }
+
+    static Timing simSave(const VU1Interpreter &sim)
+    {
+        const uint64_t now = sim.m_cycle;
+        const auto rel = [now](uint64_t at) { return static_cast<uint8_t>(at > now ? at - now : 0u); };
+        Timing t;
+        for (size_t slot = 0; slot < t.ready.size(); ++slot)
+            t.ready[slot] = rel(sim.m_ready[slot]);
+        t.fdiv = sim.m_fdiv.valid ? rel(sim.m_fdiv.readyCycle) : 0u;
+        for (size_t i = 0; i < 2u; ++i)
+            t.efu[i] = sim.m_efu[i].valid ? rel(sim.m_efu[i].readyCycle) : 0u;
+        t.efuResource = rel(sim.m_efuResourceReady);
+        for (uint32_t i = 0; i < sim.m_flagCount; ++i)
+        {
+            const FlagPipelineEntry &entry = sim.m_flagPipeline[(sim.m_flagHead + i) % kMaxFlagEntries];
+            if (entry.readyCycle > now && t.flagCount < t.flags.size())
+                t.flags[t.flagCount++] = rel(entry.readyCycle);
+        }
+        t.inflight = rel(sim.m_inflightReady);
+        t.backupReg = sim.m_viBranchBackupValid ? sim.m_viBranchBackupReg : 0u;
+        return t;
+    }
+
+    // The latest cycle a Q or P result is due (0: none queued), for the generator's commit points.
+    static void simQueued(const VU1Interpreter &sim, uint64_t (&due)[3])
+    {
+        due[0] = sim.m_fdiv.valid ? sim.m_fdiv.readyCycle : 0u;
+        due[1] = sim.m_efu[0].valid ? sim.m_efu[0].readyCycle : 0u;
+        due[2] = sim.m_efu[1].valid ? sim.m_efu[1].readyCycle : 0u;
+    }
+
+    static const std::array<uint64_t, kViSlot + 16u> &simReady(const VU1Interpreter &sim) { return sim.m_ready; }
+
+    // One pair as the interpreter steps it (never a branch or program end: control flow is the generator's);
+    // returns its issue cycle.
+    static uint64_t simPair(VU1Interpreter &sim, uint32_t pc, const DecodedInstructionPair &pair)
+    {
+        sim.m_state.pc = pc;
+        sim.m_state.branchPending = false;
+        sim.m_state.ebit = false;
+        sim.m_state.haltAfterDelaySlot = false;
+        sim.m_state.dBitEnabled = sim.m_state.tBitEnabled = false;
+        const bool kick = isXgkick(pair);
+        if (kick) // zeroed GIF tags never end the packet in the one step it gets
+            std::memset(sim.m_activeVuData, 0, sim.m_activeVuDataSize);
+        sim.stepPair<false>(pair, kCompiledCodeSize, UINT64_MAX);
+        if (kick) // how long a transfer takes is the lean code's business (LeanAccess::kickBusy)
+            sim.m_xgkick = {};
+        sim.m_state.branchPending = false;
+        sim.m_state.ebit = false;
+        sim.m_stopRequested = false;
+        return sim.m_cycle - 1u;
+    }
+
+    // The FMAC lanes read without a declared (stalling) read: OPMSUB/OPMULA cross lanes, as reg*4+component.
+    static std::array<int, 8> undeclaredLanes(const DecodedInstructionPair &pair)
+    {
+        std::array<int, 8> lanes;
+        lanes.fill(-1);
+        const uint8_t fs = VFS(pair.upper), ft = VFT(pair.upper);
+        for (uint32_t c = 0; c < 4u; ++c)
+        {
+            if ((pair.fmacUndeclaredFs & laneForComponent(c)) != 0u)
+                lanes[c] = fs * 4 + static_cast<int>(c);
+            if ((pair.fmacUndeclaredFt & laneForComponent(c)) != 0u)
+                lanes[4 + c] = ft * 4 + static_cast<int>(c);
+        }
+        return lanes;
+    }
+
+    static DecodedInstructionPair decode(uint32_t lower, uint32_t upper) { return decodePair(lower, upper, Unit::VU1); }
+    static bool reserved(const DecodedInstructionPair &p) { return p.upperUsage.reserved || p.lowerUsage.reserved; }
+    static bool isBranch(const DecodedInstructionPair &p) { return !p.iBit && p.lowerUsage.pipeline == PipelineBranch; }
+    static bool isXgkick(const DecodedInstructionPair &p) { return !p.iBit && p.lowerUsage.pipeline == PipelineXgkick; }
+    // An FMAC that queues a MAC/status flag entry; lower ops that read MAC or status (FSEQ/FSAND/FSOR, FMEQ/FMAND/FMOR),
+    // and FSSET (rewrites sticky bits and entries issued with it: no elision in its program).
+    static bool queuesMacFlags(const DecodedInstructionPair &p) { return p.fmacForm != FmacNone && DEST(p.upper) != 0u; }
+    static bool readsMacFlags(const DecodedInstructionPair &p)
+    {
+        const uint32_t op = p.lower >> 25;
+        return !p.iBit && (op == 0x14u || op == 0x16u || op == 0x17u || op == 0x18u || op == 0x1Au || op == 0x1Bu);
+    }
+    static bool isFsset(const DecodedInstructionPair &p) { return !p.iBit && (p.lower >> 25) == 0x15u; }
+    static constexpr uint32_t kFlagLatency = kFmacLatency;
+    static bool storesVuData(const DecodedInstructionPair &p)
+    {
+        if (p.iBit)
+            return false;
+        const uint32_t op = p.lower >> 25;
+        if (op == 0x01u || op == 0x05u) // SQ, ISW
+            return true;
+        if (op != 0x40u || (p.lower & 0x3Cu) != 0x3Cu)
+            return false;
+        const uint32_t special = (p.lower & 3u) | ((p.lower >> 4) & 0x7Cu);
+        return special == 0x35u || special == 0x37u || special == 0x3Fu; // SQI, SQD, ISWR
+    }
+    // The upper and the (distinct) lower VF write as stepPair notes them: {reg, lanes}, reg 0 = none.
+    static std::array<uint8_t, 4> vfWrites(const DecodedInstructionPair &p)
+    {
+        const VfAccess up = p.upperUsage.vfWrite, low = p.lowerUsage.vfWrite;
+        const bool hasUp = up.reg != 0u;
+        const bool hasLow = low.reg != 0u && p.suppressedLowerVf != low.reg && (!hasUp || low.reg != up.reg);
+        return {hasUp ? up.reg : uint8_t{0}, hasUp ? up.lanes : uint8_t{0}, hasLow ? low.reg : uint8_t{0}, hasLow ? low.lanes : uint8_t{0}};
+    }
+    static uint8_t viWrite(const DecodedInstructionPair &p)
+    {
+        const uint32_t w = p.lowerUsage.viWrite & 0xFFFEu;
+        return w != 0u ? static_cast<uint8_t>(std::countr_zero(w)) : 0u;
+    }
+    static bool recordsBranchBackup(const DecodedInstructionPair &p) { return viWrite(p) != 0u && p.lowerUsage.delaysNextBranchRead; }
+};
