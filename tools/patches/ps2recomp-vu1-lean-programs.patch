index 0000000..01a7796
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_vu1_lean.h
@@ -0,0 +1,363 @@
+#ifndef PS2_VU1_LEAN_H
+#define PS2_VU1_LEAN_H
+
+// Lean VU1 programs: microprograms compiled by ps2x_vu1_lean_gen (ps2xRuntime/tools/vu1_lean_gen.cpp) with
+// their timing worked out ahead of time. A program starts from settled pipelines (every MSCAL does), so its
+// timing state is known at every pair: the generator runs the interpreter's own stepPair on a scratch
+// VU1Interpreter along each path to get it (the timing does not depend on register values; only branch
+// outcomes and how long a PATH1 transfer takes do). The generated code is split into nodes, straight-line
+// pairs from a pc to a branch's delay slot, specialized for the timing state they start in.
+//
+// A node only runs the pairs' ops (execPairOps) at their issue cycles. Everything the interpreter keeps per
+// cycle is left out or placed by the generator: Q/P results land at their known cycles (commit), flag
+// entries go through the real flag pipeline (exact, since m_cycle is set at each issue), and the scoreboard,
+// the in-flight bookkeeping and the PATH1 copy are only brought up to date where the run goes back to the
+// interpreter (leave) or ends: so every state the interpreter can see is the one it would have had.
+
+#include "runtime/ps2_vu1_exec.h"
+
+#if defined(__GNUC__) && !defined(__clang__) && __GNUC__ >= 15
+#define VU1_MUSTTAIL __attribute__((musttail))
+#elif defined(__clang__)
+#define VU1_MUSTTAIL [[clang::musttail]]
+#else
+#define VU1_MUSTTAIL
+#endif
+
+struct VU1Interpreter::LeanAccess
+{
+    // A scoreboard slot (VF lane reg*4+component, VI kViSlot+reg) with a write landing rel cycles later.
+    struct Pending
+    {
+        uint8_t slot;
+        uint8_t rel;
+    };
+
+    // ---- used by generated nodes ----
+
+    // A node that would issue a pair at or after the budget end goes to the interpreter, which stops there.
+    static VU1_ALWAYS_INLINE bool enter(VU1Interpreter &vu, uint64_t base, uint64_t budgetEnd, uint32_t lastIssue)
+    {
+        return base + lastIssue < budgetEnd && !vu.m_stopRequested;
+    }
+
+    static VU1_ALWAYS_INLINE void at(VU1Interpreter &vu, uint64_t cycle) { vu.m_cycle = cycle; }
+
+    // Q/P results due at cycle land, as the interpreter's step into that cycle lands them.
+    static VU1_ALWAYS_INLINE void commit(VU1Interpreter &vu, uint64_t cycle)
+    {
+        vu.m_cycle = cycle;
+        vu.commitDuePipelines();
+    }
+
+    // PATH1 copies through cycle (the interpreter copies one qword every second cycle as it steps).
+    static VU1_NOINLINE void kickTo(VU1Interpreter &vu, uint64_t cycle)
+    {
+        while (vu.m_xgkick.active && vu.m_xgkick.progressedCycle < cycle)
+        {
+            ++vu.m_xgkick.progressedCycle;
+            vu.progressXgkick();
+        }
+    }
+
+    // Before a store issued at cycle: PATH1 has read VU memory up to then.
+    static VU1_ALWAYS_INLINE void beforeStore(VU1Interpreter &vu, uint64_t cycle)
+    {
+        if (vu.m_xgkick.active)
+            kickTo(vu, cycle);
+    }
+
+    // An XGKICK that would issue at cycle issue: true if the previous transfer still runs then (PATH1 has
+    // copied through issue), so the interpreter waits for it (kickWait).
+    static VU1_ALWAYS_INLINE bool kickBusy(VU1Interpreter &vu, uint64_t issue)
+    {
+        if (!vu.m_xgkick.active)
+            return false;
+        kickTo(vu, issue);
+        return vu.m_xgkick.active;
+    }
+
+    // The interpreter's wait at a busy XGKICK, one cycle at a time: the cycle it issues at, once the transfer
+    // has ended, or budgetEnd (the run stops before it). Q/P results due by then have landed.
+    static VU1_NOINLINE uint64_t kickWait(VU1Interpreter &vu, uint64_t issue, uint64_t budgetEnd)
+    {
+        uint64_t cycle = issue;
+        do
+            kickTo(vu, ++cycle);
+        while (vu.m_xgkick.active && cycle < budgetEnd);
+        vu.m_cycle = cycle;
+        vu.commitDuePipelines();
+        return cycle;
+    }
+
+    // One pair's ops, with what stepPair does around them that is not timing. kSaveUpper/kSaveLower: VF lanes
+    // whose old value must be kept as the start of an in-flight write chain (the run may go back to the
+    // interpreter while the write is in flight); kViPending: the VI it writes has a write in flight;
+    // kSaveVi: keep the VI's old value as its chain start.
+    template <uint32_t Lower, uint32_t Upper, uint8_t kSaveUpper, uint8_t kSaveLower, bool kViPending, bool kSaveVi,
+              bool kElideFlags = false>
+    static VU1_ALWAYS_INLINE void pair(VU1Interpreter &vu)
+    {
+        static constexpr DecodedInstructionPair kPair = decodePair(Lower, Upper, Unit::VU1);
+        constexpr uint32_t viWrites = kPair.lowerUsage.viWrite & 0xFFFEu;
+        constexpr uint8_t writtenVi = viWrites != 0u ? static_cast<uint8_t>(std::countr_zero(viWrites)) : 0u;
+        int32_t oldVi = 0;
+        if constexpr (writtenVi != 0u)
+            oldVi = kViPending ? vu.m_viChainStart[writtenVi] : vu.m_state.vi[writtenVi];
+        if constexpr (kPair.lowerReadsFlags)
+            vu.syncFlags();
