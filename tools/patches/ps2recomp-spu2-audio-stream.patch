+
+// ---- SNDDRV software-mixed PCM stream (SPU2 core0 DMA tap) -------------------
+// The game mixes everything in IOP RAM and DMAs 2048-byte blocks (512 stereo frames at
+// 48 kHz, laid out [L x256][R x256][L x256][R x256]) toward SPU2 core0. The runtime's
+// instant DMA completion makes it re-send the current block until the next mix tick, so
+// only fresh blocks advance the stream. SPSC lock-free ring: producer = IOP thread
+// (onSpuStreamBlock), consumer = the miniaudio callback thread.
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <atomic>
+
+namespace
+{
+    constexpr uint32_t kSpuStreamRate = 48000u;
+    constexpr uint32_t kSpuRingFrames = 1u << 15u; // ~0.68 s of stereo
+
+    struct SpuStreamState
+    {
+        std::atomic<uint32_t> head{0}; // frames written (monotonic, wraps via mask)
+        std::atomic<uint32_t> tail{0}; // frames read
+        std::array<int16_t, kSpuRingFrames * 2u> pcm{};
+        AudioStream stream{};
+        bool live = false;
+        std::vector<uint8_t> lastBlock;
+        bool hasLast = false;
+    };
+    SpuStreamState g_spuStream;
+
+    void spuStreamCallback(void *buffer, unsigned int frames)
+    {
+        int16_t *out = static_cast<int16_t *>(buffer);
+        const uint32_t tail = g_spuStream.tail.load(std::memory_order_relaxed);
+        const uint32_t head = g_spuStream.head.load(std::memory_order_acquire);
+        const uint32_t got = std::min<uint32_t>(frames, head - tail);
+        for (uint32_t i = 0; i < got; ++i)
+        {
+            const uint32_t slot = (tail + i) & (kSpuRingFrames - 1u);
+            out[i * 2] = g_spuStream.pcm[slot * 2];
+            out[i * 2 + 1] = g_spuStream.pcm[slot * 2 + 1];
+        }
+        for (uint32_t i = got; i < frames; ++i)
+            out[i * 2] = out[i * 2 + 1] = 0; // underrun: silence
+        g_spuStream.tail.store(tail + got, std::memory_order_release);
+    }
+}
+
+void PS2AudioBackend::startSpuStream()
+{
+#if defined(PLATFORM_VITA)
+    return;
+#else
+    if (!m_audioReady || g_spuStream.live)
+        return;
+    g_spuStream.stream = LoadAudioStream(kSpuStreamRate, 16u, 2u);
+    if (!IsAudioStreamValid(g_spuStream.stream))
+        return;
+    SetAudioStreamCallback(g_spuStream.stream, spuStreamCallback);
+    SetAudioStreamVolume(g_spuStream.stream, 1.0f);
+    PlayAudioStream(g_spuStream.stream);
+    g_spuStream.live = true;
+    std::fprintf(stderr, "[audio] SPU stream live (48 kHz stereo)\n");
+#endif
+}
+
+void PS2AudioBackend::onSpuStreamBlock(uint32_t madr, const uint8_t *data, uint32_t sizeBytes)
+{
+    (void)madr;
+    if (!g_spuStream.live || !data || sizeBytes != 2048u)
+        return;
+
+    if (g_spuStream.hasLast && std::memcmp(g_spuStream.lastBlock.data(), data, sizeBytes) == 0)
+        return;
+    g_spuStream.lastBlock.assign(data, data + sizeBytes);
+    g_spuStream.hasLast = true;
+
+    const int16_t *in = reinterpret_cast<const int16_t *>(data);
+    uint32_t head = g_spuStream.head.load(std::memory_order_relaxed);
+    const uint32_t tail = g_spuStream.tail.load(std::memory_order_acquire);
+    if (head - tail + 512u > kSpuRingFrames)
+        return; // emulation outran playback: drop the block rather than overwrite unread audio
+    for (uint32_t half = 0u; half < 2u; ++half)
+    {
+        for (uint32_t i = 0; i < 256u; ++i)
+        {
+            const uint32_t slot = head & (kSpuRingFrames - 1u);
+            g_spuStream.pcm[slot * 2] = in[half * 512u + i];
+            g_spuStream.pcm[slot * 2 + 1] = in[half * 512u + 256u + i];
+            ++head;
+        }
+    }
+    g_spuStream.head.store(head, std::memory_order_release);
+}
