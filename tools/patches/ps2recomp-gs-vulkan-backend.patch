+PresentationFrame GSVulkanBackend::Present(const GSPresentationRequest &request)
+{
+    if (m_gpuOk && m_gpuPresent)
+    {
+#if defined(PS2X_HAS_VULKAN)
+        // TEMP-DEBUG(mhrs): PS2X_VK_PRESENT_VERIFY=1 runs both paths on the same VRAM
+        // contents and reports pixel differences (deterministic deswizzle A/B).
+        static const bool verify = std::getenv("PS2X_VK_PRESENT_VERIFY") != nullptr;
+        if (verify)
+        {
+            PresentationFrame gpuFrame = presentGpu(request);
+            PresentationFrame cpuFrame = m_cpu.Present(request);
+            static uint64_t checks = 0, mismatches = 0;
+            ++checks;
+            if (gpuFrame.width != cpuFrame.width || gpuFrame.height != cpuFrame.height ||
+                gpuFrame.sourceFbp != cpuFrame.sourceFbp || gpuFrame.usedPreferred != cpuFrame.usedPreferred ||
+                gpuFrame.pixels.size() != cpuFrame.pixels.size() ||
+                (!gpuFrame.pixels.empty() && std::memcmp(gpuFrame.pixels.data(), cpuFrame.pixels.data(), gpuFrame.pixels.size()) != 0))
+            {
+                ++mismatches;
+                uint64_t diffBytes = 0, firstDiff = UINT64_MAX;
+                const size_t n = std::min(gpuFrame.pixels.size(), cpuFrame.pixels.size());
+                for (size_t i = 0; i < n; ++i)
+                    if (gpuFrame.pixels[i] != cpuFrame.pixels[i])
+                    {
+                        ++diffBytes;
+                        if (firstDiff == UINT64_MAX)
+                            firstDiff = i;
+                    }
+                std::cerr << "[gs-vulkan-verify] MISMATCH #" << mismatches << "/" << checks
+                          << " gpu=" << gpuFrame.width << "x" << gpuFrame.height << " src=0x" << std::hex << gpuFrame.sourceFbp
+                          << " pref=" << gpuFrame.usedPreferred << " cpu=" << cpuFrame.width << "x" << cpuFrame.height
+                          << " src=0x" << cpuFrame.sourceFbp << " pref=" << cpuFrame.usedPreferred << std::dec
+                          << " diffBytes=" << diffBytes << " first=" << firstDiff
+                          << " (pixel " << (firstDiff != UINT64_MAX ? firstDiff / 4u : 0u) % 640u << ","
+                          << (firstDiff != UINT64_MAX ? firstDiff / 4u : 0u) / 640u << ")" << std::endl;
+            }
+            else if (checks % 300 == 0)
+            {
+                std::cerr << "[gs-vulkan-verify] " << checks << " presents, all identical so far" << std::endl;
+            }
+            return gpuFrame;
+        }
+#endif
+        return presentGpu(request);
+    }
+    return m_cpu.Present(request);
+}
