+void GSVulkanBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    if (m_gpuOk && m_vk && m_vk->vramMapped && vramSize <= m_vk->vramBufferSize)
+    {
+        std::memcpy(m_vk->vramMapped, vram, vramSize);
+        m_cpu.Initialize(static_cast<uint8_t *>(m_vk->vramMapped), vramSize);
+    }
+    else
+    {
+        if (m_gpuOk)
+        {
+            std::cerr << "[gs-vulkan] VRAM size mismatch, CPU fallback" << std::endl;
+            m_gpuOk = false;
+        }
+        m_cpu.Initialize(vram, vramSize);
+    }
+}
