diff --git a/ps2xRuntime/src/lib/gs/shaders/present_deswizzle.comp b/ps2xRuntime/src/lib/gs/shaders/present_deswizzle.comp
new file mode 100755
index 0000000..5d5f34c
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/shaders/present_deswizzle.comp
@@ -0,0 +1,125 @@
+#version 450
+
+// Display deswizzle for the Vulkan GS backend: one invocation per output pixel of the
+// 640x512 host frame buffer. Reads a CT32/CT24/CT16/CT16S display source out of swizzled
+// GS VRAM (mirrors GSCpuBackend::CopyFrameToHostRgba with useLocalMemoryLayout=true) and
+// writes packed RGBA8. Pixels outside width/height are zeroed, matching the CPU backend's
+// zero-filled outPixels.
+
+layout(local_size_x = 64) in;
+
+layout(set = 0, binding = 0, std430) readonly buffer Vram
+{
+    uint vram[];
+};
+
+layout(set = 0, binding = 1, std430) writeonly buffer OutPixels
+{
+    uint outPixels[];
+};
+
+layout(push_constant) uniform PushConstants
+{
+    uint basePtr; // display base in 8KB-word blocks (framePageBaseToBlock applied by caller)
+    uint fbw;     // frame buffer width in pages (64 pixels)
+    uint psm;     // 0 = CT32, 1 = CT24, 2 = CT16, 10 = CT16S
+    uint width;
+    uint height;
+    uint originX;
+    uint originY;
+    uint flags;      // bit0: preserveAlpha
+    uint wordMask;   // vram word count - 1
+    uint byteMask16; // vram byte count - 2 (CT16 wrap)
+} pc;
+
+const uint HOST_W = 640u;
+const uint HOST_H = 512u;
+
+// CT32 page: 64x32 pixels, 8x4 blocks, 8x8 column per block (matches BlockTableC32/ColumnTable32).
+const uint BlockTableC32[32] = uint[](
+    0u, 1u, 4u, 5u, 16u, 17u, 20u, 21u,
+    2u, 3u, 6u, 7u, 18u, 19u, 22u, 23u,
+    8u, 9u, 12u, 13u, 24u, 25u, 28u, 29u,
+    10u, 11u, 14u, 15u, 26u, 27u, 30u, 31u);
+
+const uint ColumnTable32[64] = uint[](
+    0u, 1u, 4u, 5u, 8u, 9u, 12u, 13u,
+    2u, 3u, 6u, 7u, 10u, 11u, 14u, 15u,
+    16u, 17u, 20u, 21u, 24u, 25u, 28u, 29u,
+    18u, 19u, 22u, 23u, 26u, 27u, 30u, 31u,
+    32u, 33u, 36u, 37u, 40u, 41u, 44u, 45u,
+    34u, 35u, 38u, 39u, 42u, 43u, 46u, 47u,
+    48u, 49u, 52u, 53u, 56u, 57u, 60u, 61u,
+    50u, 51u, 54u, 55u, 58u, 59u, 62u, 63u);
+
+// CT16 page: 64x64 pixels, 4x8 blocks, 16x8 column per block (matches BlockTableC16/ColumnTable16).
+const uint BlockTableC16[32] = uint[](
+    0u, 2u, 8u, 10u,
+    1u, 3u, 9u, 11u,
+    4u, 6u, 12u, 14u,
+    5u, 7u, 13u, 15u,
+    16u, 18u, 24u, 26u,
+    17u, 19u, 25u, 27u,
+    20u, 22u, 28u, 30u,
+    21u, 23u, 29u, 31u);
+
+const uint ColumnTable16[128] = uint[](
+    0u, 2u, 8u, 10u, 16u, 18u, 24u, 26u, 1u, 3u, 9u, 11u, 17u, 19u, 25u, 27u,
+    4u, 6u, 12u, 14u, 20u, 22u, 28u, 30u, 5u, 7u, 13u, 15u, 21u, 23u, 29u, 31u,
+    32u, 34u, 40u, 42u, 48u, 50u, 56u, 58u, 33u, 35u, 41u, 43u, 49u, 51u, 57u, 59u,
+    36u, 38u, 44u, 46u, 52u, 54u, 60u, 62u, 37u, 39u, 45u, 47u, 53u, 55u, 61u, 63u,
+    64u, 66u, 72u, 74u, 80u, 82u, 88u, 90u, 65u, 67u, 73u, 75u, 81u, 83u, 89u, 91u,
+    68u, 70u, 76u, 78u, 84u, 86u, 92u, 94u, 69u, 71u, 77u, 79u, 85u, 87u, 93u, 95u,
+    96u, 98u, 104u, 106u, 112u, 114u, 120u, 122u, 97u, 99u, 105u, 107u, 113u, 115u, 121u, 123u,
+    100u, 102u, 108u, 110u, 116u, 118u, 124u, 126u, 101u, 103u, 109u, 111u, 117u, 119u, 125u, 127u);
+
+void main()
+{
+    const uint gid = gl_GlobalInvocationID.x;
+    if (gid >= HOST_W * HOST_H)
+        return;
+
+    const uint x = gid % HOST_W;
+    const uint y = gid / HOST_W;
+
+    uint rgba = 0u;
+    if (x < pc.width && y < pc.height)
+    {
+        const uint sx = pc.originX + x;
+        const uint sy = pc.originY + y;
+        const uint basePage = pc.basePtr >> 5u;
+        const uint baseBlock = pc.basePtr & 31u;
+        const bool preserveAlpha = (pc.flags & 1u) != 0u;
+
+        if (pc.psm == 0u || pc.psm == 1u) // CT32 / CT24
+        {
+            const uint page = basePage + (sy >> 5u) * pc.fbw + (sx >> 6u);
+            const uint block = BlockTableC32[((sy >> 3u) & 3u) * 8u + ((sx >> 3u) & 7u)];
+            const uint column = ColumnTable32[(sy & 7u) * 8u + (sx & 7u)];
+            const uint pixel = page * 2048u + (baseBlock + block) * 64u + column;
+            const uint word = vram[pixel & pc.wordMask];
+            const uint alpha = (preserveAlpha && pc.psm == 0u) ? (word >> 24u) : 255u;
+            rgba = (word & 0x00FFFFFFu) | (alpha << 24u);
+        }
+        else // CT16 / CT16S
+        {
+            const uint page = basePage + (sy >> 6u) * pc.fbw + (sx >> 6u);
+            const uint block = BlockTableC16[((sy >> 3u) & 7u) * 4u + ((sx >> 4u) & 3u)];
+            const uint column = ColumnTable16[(sy & 7u) * 16u + (sx & 15u)];
+            const uint pixel = page * 4096u + (baseBlock + block) * 128u + column;
+            const uint byteAddr = (pixel * 2u) & pc.byteMask16;
+            const uint word = vram[byteAddr >> 2u];
+            const uint c16 = (word >> ((byteAddr & 2u) * 8u)) & 0xFFFFu;
+            const uint r5 = c16 & 31u;
+            const uint g5 = (c16 >> 5u) & 31u;
+            const uint b5 = (c16 >> 10u) & 31u;
+            const uint r = (r5 << 3u) | (r5 >> 2u);
+            const uint g = (g5 << 3u) | (g5 >> 2u);
+            const uint b = (b5 << 3u) | (b5 >> 2u);
+            const uint alpha = preserveAlpha ? (((c16 & 0x8000u) != 0u) ? 0x80u : 0u) : 255u;
+            rgba = r | (g << 8u) | (b << 16u) | (alpha << 24u);
+        }
+    }
+
+    outPixels[gid] = rgba;
+}
