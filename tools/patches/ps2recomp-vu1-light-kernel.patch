+    // The game's point-light loop in its steady timing state, which LeanAccess::pointLightLoop runs: node n has
+    // the loop's 26 pairs at cycles 0..25 (Q lands at 9), saves vf22.x at 24 and vf15 at 25, loops to itself, and
+    // no FMAC but the MSUBw at 20 queues a flag entry. Returns -1 if not, else whether the MSUBw queues one.
+    int pointLightHead(const Program &program, size_t n)
+    {
+        static constexpr uint32_t kWords[26][2] = {
+            {0x8000033Cu, 0x000002FFu}, {0x81EE2B7Cu, 0x01ED64ECu}, {0x8000033Cu, 0x000002FFu}, {0x8000033Cu, 0x000002FFu},
+            {0x81ED1B7Cu, 0x0116B62Au}, {0x8000033Cu, 0x01D3956Au}, {0x8000033Cu, 0x01D39D2Au}, {0x8000033Cu, 0x000002FFu},
+            {0x8000033Cu, 0x011392BEu}, {0x81F2237Cu, 0x0100C65Cu}, {0x8000033Cu, 0x011550BDu}, {0x8000033Cu, 0x0115554Au},
+            {0x8000033Cu, 0x01C079BFu}, {0x8000033Cu, 0x01D95C08u}, {0x8000033Cu, 0x01139ABEu}, {0x8000033Cu, 0x011450BDu},
+            {0x437F0000u, 0x8114550Au}, {0x8000033Cu, 0x01E0841Fu}, {0x8000033Cu, 0x0100ADEBu}, {0x12021001u, 0x010051BFu},
+            {0x8000033Cu, 0x010CA58Fu}, {0x8000033Cu, 0x01F1817Cu}, {0x8014BBBEu, 0x000002FFu}, {0x8000033Cu, 0x000002FFu},
+            {0x520207E7u, 0x0100B5ABu}, {0x81C68B7Du, 0x01EF713Cu}};
+        const Node &x = program.nodes[n];
+        if (x.pairs.size() != 26u || !x.exitCommits.empty() || x.exit.kind != Exit::Cond || x.exit.rel != 26u ||
+            x.exit.pc != x.pc || x.exit.targets.empty() || x.exit.targets[0] != static_cast<int>(n))
+            return -1;
+        int msubFlags = 0;
+        for (size_t i = 0; i < 26u; ++i)
+        {
+            const PairCode &p = x.pairs[i];
+            const std::vector<uint32_t> commits = i == 9u ? std::vector<uint32_t>{9u} : std::vector<uint32_t>{};
+            const uint8_t save = i == 24u ? 8u : i == 25u ? 15u : 0u;
+            if (p.pc != x.pc + 8u * i || p.lower != kWords[i][0] || p.upper != kWords[i][1] || p.issue != i || p.from != i ||
+                p.commits != commits || p.kick || p.saveUpper != save || p.saveLower != 0u || p.viPending || p.saveVi)
+                return -1;
+            if (i == 20u)
+                msubFlags = p.fmacFlags && !p.elide ? 1 : 0;
+            else if (p.fmacFlags && !p.elide)
+                return -1;
+        }
+        return msubFlags;
+    }
