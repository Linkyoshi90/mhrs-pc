diff --git a/ps2xTest/gs_cache/gs_async_backend_tests.cpp b/ps2xTest/gs_cache/gs_async_backend_tests.cpp
new file mode 100644
index 0000000..96f825c
--- /dev/null
+++ b/ps2xTest/gs_cache/gs_async_backend_tests.cpp
@@ -0,0 +1,73 @@
+#include "gs_test_support.h"
+#include "runtime/gs/gs_async_backend.h"
+
+#include <memory>
+
+using namespace GSTest;
+
+namespace
+{
+    // Runs the same calls on a direct backend and on one behind GSAsyncBackend.
+    struct AsyncFixture
+    {
+        std::vector<uint8_t> directVram = std::vector<uint8_t>(kVramSize);
+        std::vector<uint8_t> asyncVram = std::vector<uint8_t>(kVramSize);
+        GSCpuBackend direct;
+        GSAsyncBackend async{std::make_unique<GSCpuBackend>()};
+
+        AsyncFixture()
+        {
+            direct.Initialize(directVram.data(), kVramSize);
+            async.Initialize(asyncVram.data(), kVramSize);
+        }
+
+        template <typename Fn>
+        void both(Fn &&fn)
+        {
+            fn(static_cast<GSRasterBackend &>(direct));
+            fn(static_cast<GSRasterBackend &>(async));
+        }
+    };
+
+    void readbackWaitsForQueuedWork()
+    {
+        AsyncFixture f;
+        const auto tex = texture();
+        f.both([&](GSRasterBackend &b) { b.WriteVram(tex.psm, tex.tbp0, tex.tbw, 0, 0, kRed); });
+        // Many draws then an upload: a readback must see all of them, in order.
+        for (uint32_t i = 0; i < 2000u; ++i)
+        {
+            auto batch = sprite(tex, 0, 0);
+            batch.state.prim.tme = false;
+            for (auto &vertex : batch.vertices)
+            {
+                vertex.r = static_cast<uint8_t>(i);
+                vertex.g = static_cast<uint8_t>(i >> 8);
+            }
+            f.both([&](GSRasterBackend &b) { b.Submit(batch); });
+        }
+        GSTransferCommand transfer{};
+        transfer.direction = 0;
+        transfer.bitbltbuf.dbp = tex.tbp0;
+        transfer.bitbltbuf.dbw = tex.tbw;
+        transfer.bitbltbuf.dpsm = tex.psm;
+        transfer.trxreg.rrw = transfer.trxreg.rrh = 1;
+        uint32_t pixel = kGreen;
+        f.both([&](GSRasterBackend &b) { b.BeginTransfer(transfer); });
+        f.both([&](GSRasterBackend &b) { b.UploadImage(reinterpret_cast<const uint8_t *>(&pixel), sizeof(pixel)); });
+        pixel = kBlue; // the queued upload must have taken its own copy
+
+        expectEqual(f.async.ReadVram(GS_PSM_CT32, kOutputPage * 32u, 1u, 0u, 0u),
+                    f.direct.ReadVram(GS_PSM_CT32, kOutputPage * 32u, 1u, 0u, 0u), "last draw visible");
+        expectEqual(f.async.ReadVram(tex.psm, tex.tbp0, tex.tbw, 0, 0), kGreen, "upload visible");
+        std::vector<uint8_t> a, d;
+        f.async.SnapshotVram(a);
+        f.direct.SnapshotVram(d);
+        require(a == d, "same GS memory as the direct backend");
+    }
+}
+
+int main(int argc, char **argv)
+{
+    return run(argc, argv, {{"readback_waits", readbackWaitsForQueuedWork}});
+}
