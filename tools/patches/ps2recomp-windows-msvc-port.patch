diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
index bae132b..d38ce4a 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -470,6 +470,16 @@ else()
     )
 endif()
 
+# register_functions.cpp is a single ~230k-line static initializer; MSVC's optimizer
+# effectively never finishes it. The table contents are plain stores — /Od loses nothing.
+if(MSVC AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/src/runner/register_functions.cpp")
+    set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/src/runner/register_functions.cpp" PROPERTIES
+        SKIP_UNITY_BUILD_INCLUSION TRUE
+        SKIP_PRECOMPILE_HEADERS TRUE
+        COMPILE_OPTIONS "/Od"
+    )
+endif()
+
 # Compiles dumped VU1 microcode into lean programs (ps2_vu1_lean.h) for the runner: see tools/vu1_lean_gen.cpp.
 # The stubs provide the recompiled-function table symbols ps2_runtime expects, which only
 # exist in generated runner code; the generator itself never looks up EE functions.
@@ -549,7 +559,23 @@ find_program(PS2X_GLSLANG_VALIDATOR
     NAMES glslangValidator
     HINTS "$ENV{GLSLANG_VALIDATOR_BIN}" "$ENV{HOME}/bin"
 )
-if(Vulkan_FOUND AND PS2X_GLSLANG_VALIDATOR AND NOT PS2X_IS_VITA AND NOT PS2X_IS_ANDROID)
+# Prebuilt SPIR-V headers (generated by glslangValidator elsewhere, e.g. WSL) let
+# Windows builds skip the shader-compiler dependency entirely.
+set(PS2X_VK_PREBUILT_SHADERS "" CACHE PATH "Directory with prebuilt shader .h files")
+if(Vulkan_FOUND AND PS2X_VK_PREBUILT_SHADERS AND NOT PS2X_IS_VITA AND NOT PS2X_IS_ANDROID)
+    set(PS2X_VK_SHADER_HEADERS "")
+    foreach(PS2X_VK_SHADER_NAME IN ITEMS present_deswizzle raster_sprite raster_triangle)
+        set(PS2X_VK_SHADER_HEADER "${CMAKE_CURRENT_BINARY_DIR}/shaders/${PS2X_VK_SHADER_NAME}.h")
+        configure_file("${PS2X_VK_PREBUILT_SHADERS}/${PS2X_VK_SHADER_NAME}.h" "${PS2X_VK_SHADER_HEADER}" COPYONLY)
+        list(APPEND PS2X_VK_SHADER_HEADERS "${PS2X_VK_SHADER_HEADER}")
+    endforeach()
+    add_custom_target(ps2x_gs_vulkan_shaders DEPENDS ${PS2X_VK_SHADER_HEADERS})
+    add_dependencies(ps2_runtime ps2x_gs_vulkan_shaders)
+    target_compile_definitions(ps2_runtime PRIVATE PS2X_HAS_VULKAN=1)
+    target_include_directories(ps2_runtime PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/shaders")
+    target_link_libraries(ps2_runtime PUBLIC Vulkan::Vulkan)
+    message(STATUS "ps2xRuntime: Vulkan GS backend enabled (prebuilt shaders: ${PS2X_VK_PREBUILT_SHADERS})")
+elseif(Vulkan_FOUND AND PS2X_GLSLANG_VALIDATOR AND NOT PS2X_IS_VITA AND NOT PS2X_IS_ANDROID)
     set(PS2X_VK_SHADER_HEADERS "")
     foreach(PS2X_VK_SHADER IN ITEMS "present_deswizzle:kPresentDeswizzleSpv" "raster_sprite:kRasterSpriteSpv" "raster_triangle:kRasterTriangleSpv")
         string(REGEX MATCH "^([^:]+):(.+)$" _ "${PS2X_VK_SHADER}")
diff --git a/ps2xRuntime/cmake/ReleaseMode.cmake b/ps2xRuntime/cmake/ReleaseMode.cmake
index 92ef0d5..d6d3653 100644
--- a/ps2xRuntime/cmake/ReleaseMode.cmake
+++ b/ps2xRuntime/cmake/ReleaseMode.cmake
@@ -5,17 +5,19 @@ check_ipo_supported(RESULT IPO_SUPPORTED OUTPUT IPO_ERROR)
 function(EnableFastReleaseMode TargetName)
     message("> Enabling optimization for: ${TargetName}")
     if(MSVC)
+        # NOTE(mhrs): /fp:precise, not /fp:fast — the GS CPU rasterizer and the EE float
+        # semantics depend on strict IEEE rounding. /GL+/LTCG dropped: link-time codegen
+        # over ~10k generated files takes forever and buys nothing we measured.
         target_compile_options(${TargetName} PRIVATE
             $<$<CONFIG:Release>:
                 /O2 # speed
                 /Ob2 # inline aggressively
                 /Oi # intrinsics
-                /GL # whole program opt
                 /Gy # function-level linking
                 /Gw # global data in COMDAT
                 /GF # string pooling
                 /Zc:inline # remove unreferenced inline
-                /fp:fast # fast math (graphics friendly)
+                /fp:precise # strict IEEE: recompiled EE FPU + GS raster depend on it
                 /DNDEBUG
                 /arch:AVX2 # Advanced Vector Extensions 2
                 /GS- # Disable Buffer Security Check (faster)
@@ -26,7 +28,6 @@ function(EnableFastReleaseMode TargetName)
         if(TARGET ${TargetName})
             target_link_options(${TargetName} PRIVATE
                 $<$<CONFIG:Release>:
-                    /LTCG # link-time code generation
                     /OPT:REF # remove unreferenced
                     /OPT:ICF # fold identical COMDATs
                 >
@@ -34,9 +35,5 @@ function(EnableFastReleaseMode TargetName)
         endif()
     endif()
 
-    if(IPO_SUPPORTED)
-        set_property(TARGET ${TargetName} PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELEASE TRUE)
-    else()
-        message(WARNING "Interprocedural optimization not supported: ${ipo_error}")
-    endif()
-endfunction()
\ No newline at end of file
+    # IPO disabled: same reason as dropping /GL+/LTCG above.
+endfunction()
