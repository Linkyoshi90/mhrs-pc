diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -328,7 +328,8 @@ elseif(WIN32)
         bcrypt
         secur32
         ws2_32
-        user32
+        # no user32 here: listed before raylib, it binds raylib's ShowCursor/CloseWindow calls to the Win32
+        # functions of the same name (raylib links user32 itself, after its own symbols)
         advapi32
         ole32
         shell32
@@ -470,13 +471,13 @@ else()
     )
 endif()
 
-# register_functions.cpp is a single ~230k-line static initializer; MSVC's optimizer
-# effectively never finishes it. The table contents are plain stores — /Od loses nothing.
-if(MSVC AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/src/runner/register_functions.cpp")
+# register_functions.cpp is a single ~230k-line static initializer; MSVC's and mingw GCC 13's optimizers
+# effectively never finish it. The table contents are plain stores, so -O0 loses nothing.
+if((MSVC OR MINGW) AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/src/runner/register_functions.cpp")
     set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/src/runner/register_functions.cpp" PROPERTIES
         SKIP_UNITY_BUILD_INCLUSION TRUE
         SKIP_PRECOMPILE_HEADERS TRUE
-        COMPILE_OPTIONS "/Od"
+        COMPILE_OPTIONS "$<IF:$<CXX_COMPILER_ID:MSVC>,/Od,-O0>"
     )
 endif()
 
