                expect(executor.lastGp == 0x89AB0u, "timer callback lost the registering module GP") &&
                expect(timrman.nextEventCycle(1000u) == 300u, "timer callback return did not rearm compare");
     }
+    bool testSpuAutoDmaPacing()
+    {
+        IopMemory memory;
+        memory.write32(0x1F8010C4u, (4u << 16u) | 16u); // DMA4: 4 blocks of 16 words
+        memory.write32(0x1F8010C8u, 0x01000201u);
+        const auto plain = memory.takeDmaStart();
+        memory.write16(0x1F9001B0u, 1u); // core0 ADMAS: auto-DMA
+        memory.write32(0x1F8010C8u, 0x01000201u);
+        const auto paced = memory.takeDmaStart();
+        memory.write32(0x1F801504u, (4u << 16u) | 16u); // DMA7 (core1)
+        memory.write32(0x1F801508u, 0x01000201u);
+        const auto plainCore1 = memory.takeDmaStart();
+        memory.write16(0x1F9005B0u, 2u); // core1 ADMAS
+        memory.write32(0x1F801508u, 0x01000201u);
+        const auto pacedCore1 = memory.takeDmaStart();
+        const bool ok = plain && plain->delayCycles == 128u && paced && paced->delayCycles == 64u * 768u &&
+                        plainCore1 && plainCore1->delayCycles == 128u && pacedCore1 && pacedCore1->irq == 0x28 &&
+                        pacedCore1->delayCycles == 64u * 768u;
+        if (!ok)
+            std::cerr << "SPU2 auto-DMA should complete at 48 kHz (768 IOP cycles per word), other transfers at 2 per word\n";
+        return ok;
+    }
 }
 
