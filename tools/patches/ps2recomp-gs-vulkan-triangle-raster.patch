-void writeVram8(uint byteAddr, uint value)
-{
-    const uint shift = (byteAddr & 3u) * 8u;
-    const uint wordAddr = byteAddr >> 2u;
-    vram[wordAddr] = (vram[wordAddr] & ~(0xFFu << shift)) | ((value & 0xFFu) << shift);
