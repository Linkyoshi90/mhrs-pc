+#version 450
+
+// Triangle rasterizer for the Vulkan GS backend: one dispatch per GS triangle primitive,
+// one invocation per candidate output pixel (mirrors GSCpuBackend::DrawTriangle).
+
+#extension GL_EXT_shader_explicit_arithmetic_types_float64 : enable
+#extension GL_GOOGLE_include_directive : enable
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+#include "gs_raster_common.glsl"
+
+void main()
+{
+    const int x = pr.triMinX + int(gl_GlobalInvocationID.x);
+    const int y = pr.triMinY + int(gl_GlobalInvocationID.y);
+    if (x > pr.triMaxX || y > pr.triMaxY)
+        return;
+
+    // Edge functions at pixel centers — same operation order as the CPU path
+    // (precise: no FMA contraction, rounding must match the scalar float ops).
+    precise const float px = float(x) + 0.5;
+    precise const float py = float(y) + 0.5;
+    precise const float dx = px - pr.fx2;
+    precise const float rowTerm0 = (pr.fx2 - pr.fx1) * (py - pr.fy2);
+    precise const float rowTerm1 = (pr.fx0 - pr.fx2) * (py - pr.fy2);
+    precise const float w0 = ((pr.edgeA0 * dx + rowTerm0) * pr.winding) * pr.invAbsDenom;
+    precise const float w1 = ((pr.edgeA1 * dx + rowTerm1) * pr.winding) * pr.invAbsDenom;
+    precise const float w2 = (1.0 - w0) - w1;
+
+    // TRI_DEBUG: dev-only per-pixel writeback into sprite-only params slots.
+    const bool dbg = pr.drawX0 == 1 && x == pr.unclippedX0 && y == pr.unclippedY0;
+    if (dbg)
+    {
+        pr.u0f = w0;
+        pr.v0f = w1;
+        pr.u1f = w2;
+        pr.vertG = 0x11111111u; // marker: reached edge test
+    }
+
+    if (w0 < -0.0001 || w1 < -0.0001 || w2 < -0.0001)
+        return;
+
+    uint r, g, b, a;
+    if (pr.iip != 0u)
+    {
+        precise const float ir = (pr.attrR0 * w0 + pr.attrR1 * w1) + pr.attrR2 * w2;
+        precise const float ig = (pr.attrG0 * w0 + pr.attrG1 * w1) + pr.attrG2 * w2;
+        precise const float ib = (pr.attrB0 * w0 + pr.attrB1 * w1) + pr.attrB2 * w2;
+        precise const float ia = (pr.attrA0 * w0 + pr.attrA1 * w1) + pr.attrA2 * w2;
+        r = clampU8(int(ir));
+        g = clampU8(int(ig));
+        b = clampU8(int(ib));
+        a = clampU8(int(ia));
+    }
+    else
+    {
+        // Flat shading: vertex 2 color (exact small ints in float).
+        r = uint(pr.attrR2);
+        g = uint(pr.attrG2);
+        b = uint(pr.attrB2);
+        a = uint(pr.attrA2);
+    }
+
+    if (pr.tme != 0u)
+    {
+        uint texel;
+        if (pr.fst != 0u)
+        {
+            // FST interpolates the raw 4.12 fixed-point UVs; the CPU truncates to u16.
+            precise const float iuf = (pr.attrS0 * w0 + pr.attrS1 * w1) + pr.attrS2 * w2;
+            precise const float ivf = (pr.attrT0 * w0 + pr.attrT1 * w1) + pr.attrT2 * w2;
+            const uint iu = uint(int(iuf)) & 0xFFFFu;
+            const uint iv = uint(int(ivf)) & 0xFFFFu;
+            texel = sampleTexture(0.0, 0.0, 1.0, iu, iv, dbg);
+            if (dbg)
+            {
+                pr.spriteW = iuf;
+                pr.spriteH = ivf;
+                pr.vertG = iu;
+                pr.vertB = iv;
+            }
+        }
+        else
+        {
+            // The GS DDA interpolates homogeneous S, T, Q; texel coordinates come from
+            // S/Q and T/Q only after interpolation (done inside sampleTexture).
+            precise const float isv = (pr.attrS0 * w0 + pr.attrS1 * w1) + pr.attrS2 * w2;
+            precise const float itv = (pr.attrT0 * w0 + pr.attrT1 * w1) + pr.attrT2 * w2;
+            precise const float iqv = (pr.attrQ0 * w0 + pr.attrQ1 * w1) + pr.attrQ2 * w2;
+            texel = sampleTexture(isv, itv, iqv, 0u, 0u, dbg);
+            if (dbg)
+            {
+                pr.spriteW = isv;
+                pr.spriteH = itv;
+                pr.v1f = iqv;
+            }
+        }
+        if (dbg)
+            pr.vertR = texel;
+
+        const uint tr = texel & 0xFFu;
+        const uint tg = (texel >> 8u) & 0xFFu;
+        const uint tb = (texel >> 16u) & 0xFFu;
+        const uint ta = (texel >> 24u) & 0xFFu;
+        combineTexture(tr, tg, tb, ta, r, g, b, a);
+    }
+
+    // Fog is always interpolated, independent of IIP.
+    precise const float fogf = (pr.attrFog0 * w0 + pr.attrFog1 * w1) + pr.attrFog2 * w2;
+    const uint fog = clampU8(int(fogf));
+
+    // Z in double precision like the CPU; trunc(z + 0.5) matches static_cast<u32>.
+    // precise: no reassociation/FMA of the double chain — 1 ulp flips the truncated Z.
+    precise const float64_t zw0 = pr.triZ0 * float64_t(w0);
+    precise const float64_t zw1 = pr.triZ1 * float64_t(w1);
+    precise const float64_t zw2 = pr.triZ2 * float64_t(w2);
+    precise const float64_t z = (zw0 + zw1) + zw2;
+    // static_cast<u32> on x86 truncates toward zero and wraps two's-complement;
+    // GLSL's uint() is undefined for negatives, so wrap explicitly.
+    float64_t zt = trunc(z + 0.5);
+    if (zt < 0.0)
+        zt += 4294967296.0;
+    const uint zValue = uint(min(zt, 4294967295.0));
+
+    if (dbg)
+    {
+        pr.vertA = a;
+        pr.vertFog = fog;
+        pr.z1 = zValue;
+        pr.drawY1 = 0x22222222; // marker: reached writePixelPipe
+    }
+
+    writePixelPipe(x, y, zValue, r, g, b, a, fog);
+}
