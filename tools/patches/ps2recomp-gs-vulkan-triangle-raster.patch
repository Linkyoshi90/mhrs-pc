-uint lookupClut(uint index)
-{
-    const bool sixteenBit = pr.cpsm == PSM_CT16 || pr.cpsm == PSM_CT16S;
-    const uint csaMask = sixteenBit ? 0x1Fu : 0x0Fu;
-    const uint clutBase = (pr.csa & csaMask) << 4u;
-    const bool fourBit = pr.texPsm == PSM_T4 || pr.texPsm == PSM_T4HL || pr.texPsm == PSM_T4HH;
-    const uint sourceIndex = fourBit ? (index & 0x0Fu) : index;
-
-    uint clutIndex = (clutBase + sourceIndex) & (sixteenBit ? 0x1FFu : 0x0FFu);
-    if (!sixteenBit && pr.csm == 0u && (pr.texPsm == PSM_T8 || pr.texPsm == PSM_T8H))
-    {
-        const uint block = min((sourceIndex & 0xF0u) + clutBase, 240u);
-        clutIndex = block + (sourceIndex & 0x0Fu);
-    }
-
-    if (pr.cpsm == PSM_CT32)
-    {
-        const uint raw = clut[clutIndex] | (clut[clutIndex + 256u] << 16u);
-        return applyTexa(pr.cpsm, raw);
-    }
-    if (pr.cpsm == PSM_CT24)
-    {
-        const uint raw = clut[clutIndex] | (clut[clutIndex + 256u] << 16u);
-        return applyTexa(pr.cpsm, raw & 0x00FFFFFFu);
-    }
-    if (sixteenBit)
-        return applyTexa(pr.cpsm, rgba5551to8888(clut[clutIndex]));
-    return 0xFFFF00FFu;
-}
-
-uint fetchTexel(int u, int v)
-{
-    const uint raw = readPixel(pr.texPsm, pr.tbp0, pr.tbw, uint(u), uint(v));
-    if (pr.texPsm == PSM_CT32 || pr.texPsm == PSM_Z32 || pr.texPsm == PSM_CT24 || pr.texPsm == PSM_Z24)
-        return applyTexa(pr.texPsm, raw);
-    if (is16Family(pr.texPsm))
-        return applyTexa(pr.texPsm, rgba5551to8888(raw));
-    // indexed formats
-    return lookupClut(raw & 0xFFu);
-}
