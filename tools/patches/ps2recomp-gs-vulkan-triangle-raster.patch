+void GSVulkanBackend::submitTriangleGpu(const GSPrimitiveBatch &batch)
+{
+    const GSDrawState &state = batch.state;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const GSVertex &v2 = batch.vertices[2];
+    const GSContext &ctx = state.context;
+
+    // DrawTriangle's coordinate setup with identical rounding.
+    const int ofx = ctx.xyoffset.ofx >> 4;
+    const int ofy = ctx.xyoffset.ofy >> 4;
+    const float fx0 = v0.x - static_cast<float>(ofx);
+    const float fy0 = v0.y - static_cast<float>(ofy);
+    const float fx1 = v1.x - static_cast<float>(ofx);
+    const float fy1 = v1.y - static_cast<float>(ofy);
+    const float fx2 = v2.x - static_cast<float>(ofx);
+    const float fy2 = v2.y - static_cast<float>(ofy);
+
+    int minX = static_cast<int>(std::floor(std::min({fx0, fx1, fx2})));
+    int maxX = static_cast<int>(std::ceil(std::max({fx0, fx1, fx2})));
+    int minY = static_cast<int>(std::floor(std::min({fy0, fy1, fy2})));
+    int maxY = static_cast<int>(std::ceil(std::max({fy0, fy1, fy2})));
+    minX = GSInternal::clampInt(minX, ctx.scissor.x0, ctx.scissor.x1);
+    maxX = GSInternal::clampInt(maxX, ctx.scissor.x0, ctx.scissor.x1);
+    minY = GSInternal::clampInt(minY, ctx.scissor.y0, ctx.scissor.y1);
+    maxY = GSInternal::clampInt(maxY, ctx.scissor.y0, ctx.scissor.y1);
+
+    const float denom = (fy1 - fy2) * (fx0 - fx2) + (fx2 - fx1) * (fy0 - fy2);
+    if (std::fabs(denom) < 0.001f)
+        return; // degenerate: the CPU draws nothing
+    if (minX > maxX || minY > maxY)
+        return; // fully clipped: the CPU's loops run zero iterations
+
+    SpriteParams p{};
+    fillPipeParams(p, state);
+
+    // TRI_DEBUG (dev-only): PS2X_TRI_DEBUG=x,y makes the shader write per-pixel
+    // intermediates back into sprite-only params slots for that pixel.
+    {
+        static int dbgX = -1, dbgY = -1;
+        static bool dbgParsed = false;
+        if (!dbgParsed)
+        {
+            dbgParsed = true;
+            if (const char *env = std::getenv("PS2X_TRI_DEBUG"))
+                std::sscanf(env, "%d,%d", &dbgX, &dbgY);
+        }
+        if (dbgX >= 0)
+        {
+            p.drawX0 = 1; // debug flag (sprite-only field)
+            p.unclippedX0 = dbgX;
+            p.unclippedY0 = dbgY;
+            p.u0f = p.v0f = p.u1f = p.v1f = p.spriteW = p.spriteH = -777.0f;
+            p.vertR = 0xDEAD0001u;
+            p.vertG = 0xDEAD0002u;
+            p.vertB = 0xDEAD0003u;
+            p.vertA = 0xDEAD0004u;
+            p.vertFog = 0xDEAD0005u;
+            p.z1 = 0xDEADBEEFu;
+            p.drawY1 = 0;
+        }
+    }
+
+    p.fx0 = fx0;
+    p.fy0 = fy0;
+    p.fx1 = fx1;
+    p.fy1 = fy1;
+    p.fx2 = fx2;
+    p.fy2 = fy2;
+    p.winding = (denom < 0.0f) ? -1.0f : 1.0f;
+    p.invAbsDenom = 1.0f / std::fabs(denom);
+    p.edgeA0 = fy1 - fy2;
+    p.edgeA1 = fy2 - fy0;
+    p.triMinX = minX;
+    p.triMinY = minY;
+    p.triMaxX = maxX;
+    p.triMaxY = maxY;
+
+    p.attrR0 = static_cast<float>(v0.r);
+    p.attrR1 = static_cast<float>(v1.r);
+    p.attrR2 = static_cast<float>(v2.r);
+    p.attrG0 = static_cast<float>(v0.g);
+    p.attrG1 = static_cast<float>(v1.g);
+    p.attrG2 = static_cast<float>(v2.g);
+    p.attrB0 = static_cast<float>(v0.b);
+    p.attrB1 = static_cast<float>(v1.b);
+    p.attrB2 = static_cast<float>(v2.b);
+    p.attrA0 = static_cast<float>(v0.a);
+    p.attrA1 = static_cast<float>(v1.a);
+    p.attrA2 = static_cast<float>(v2.a);
+    if (state.prim.fst)
+    {
+        // FST interpolates the raw 4.12 fixed-point UVs (u16 widened to float).
+        p.attrS0 = static_cast<float>(v0.u);
+        p.attrS1 = static_cast<float>(v1.u);
+        p.attrS2 = static_cast<float>(v2.u);
+        p.attrT0 = static_cast<float>(v0.v);
+        p.attrT1 = static_cast<float>(v1.v);
+        p.attrT2 = static_cast<float>(v2.v);
+    }
+    else
+    {
+        p.attrS0 = v0.s;
+        p.attrS1 = v1.s;
+        p.attrS2 = v2.s;
+        p.attrT0 = v0.t;
+        p.attrT1 = v1.t;
+        p.attrT2 = v2.t;
+        p.attrQ0 = v0.q;
+        p.attrQ1 = v1.q;
+        p.attrQ2 = v2.q;
+    }
+    p.attrFog0 = static_cast<float>(v0.fog);
+    p.attrFog1 = static_cast<float>(v1.fog);
+    p.attrFog2 = static_cast<float>(v2.fog);
+    p.iip = state.prim.iip ? 1u : 0u;
+    p.triZ0 = v0.z;
+    p.triZ1 = v1.z;
+    p.triZ2 = v2.z;
+
+    runRasterDispatch(batch, true, &p, sizeof(p),
+                      static_cast<uint32_t>((maxX - minX) / 8 + 1),
+                      static_cast<uint32_t>((maxY - minY) / 8 + 1),
+                      "triangle");
+}
