-bool is32Family(uint psm) { return psm == PSM_CT32 || psm == PSM_CT24 || psm == PSM_Z32 || psm == PSM_Z24; }
-bool is16Family(uint psm) { return psm == PSM_CT16 || psm == PSM_CT16S || psm == PSM_Z16 || psm == PSM_Z16S; }
-bool isZFamily(uint psm) { return psm == PSM_Z32 || psm == PSM_Z24 || psm == PSM_Z16 || psm == PSM_Z16S; }
