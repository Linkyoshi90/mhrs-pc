-void writeVram16(uint byteAddr, uint value)
-{
-    const uint shift = (byteAddr & 2u) * 8u;
-    const uint wordAddr = byteAddr >> 2u;
-    vram[wordAddr] = (vram[wordAddr] & ~(0xFFFFu << shift)) | ((value & 0xFFFFu) << shift);
-}
