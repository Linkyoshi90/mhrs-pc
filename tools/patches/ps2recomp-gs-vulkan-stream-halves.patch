+// The open batch goes out, this half's work gets a fence, and recording continues in the other half once the GPU is
+// done with what was recorded there before.
+void GSVulkanBackend::VkState::switchHalf()
+{
+    closeBatch();
+    submit();
+    vkResetFences(device, 1, &halfFences[half]);
+    vkQueueSubmit(queue, 0, nullptr, halfFences[half]); // signals once everything submitted so far has run
+    half ^= 1u;
+    const auto t0 = std::chrono::steady_clock::now();
+    vkWaitForFences(device, 1, &halfFences[half], VK_TRUE, UINT64_MAX);
+    stats.waitMs += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+    switchPending = false;
+    commandIndex = halfStart(half, kCommandBuffers);
+    uploadUsed = halfStart(half, kUploadBytes);
+    states.used = states.copied = halfStart(half, kMaxStates);
+    geoms.used = geoms.copied = halfStart(half, kMaxGeoms);
+    tiles.used = tiles.copied = halfStart(half, kTileWords);
+    cluts.used = cluts.copied = halfStart(half, kClutSlots);
+    stateIndex = kNone; // both point into the half left behind
+    clutSlot = kNone;
+}
