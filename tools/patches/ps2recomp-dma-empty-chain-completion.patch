+            const uint64_t endTag = 0x70000000ull; // ID 7 (end) in bits 28-30, QWC 0
+            std::memcpy(mem.getRDRAM() + kTag, &endTag, sizeof(endTag));
+            std::memset(mem.getRDRAM() + kTag + 8u, 0, 8u);
+
+            std::vector<std::vector<uint8_t>> captured;
+            mem.setGifPacketCallback([&](const uint8_t *data, uint32_t sizeBytes)
