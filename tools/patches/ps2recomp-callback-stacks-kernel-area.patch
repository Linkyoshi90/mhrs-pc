diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index bb03879..30f284b 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -986,9 +986,22 @@ bool PS2Runtime::loadELF(const std::string &elfPath)
     }
     {
         std::lock_guard<std::mutex> lock(m_asyncCallbackStackMutex);
-        const uint32_t hardLimit = std::min(kGuestHeapHardLimit, PS2_RAM_SIZE);
-        m_asyncCallbackStackFloor = std::min(std::max(hardLimit, suggestedHeapBase), PS2_RAM_SIZE);
-        m_asyncCallbackStackTop = PS2_RAM_SIZE;
+        // SetupThread(stack = -1) puts the main stack at the top of RAM, as the kernel does, so callback
+        // stacks carved from there overwrite its live frames. Retail programs load at 0x100000 or above;
+        // the kernel-reserved range below them is free for these stacks.
+        constexpr uint32_t kUserMemoryBase = 0x00100000u;
+        constexpr uint32_t kKernelReservedCallbackFloor = 0x00080000u;
+        if (moduleBase != std::numeric_limits<uint32_t>::max() && (moduleBase & 0x1FFFFFFFu) >= kUserMemoryBase)
+        {
+            m_asyncCallbackStackFloor = kKernelReservedCallbackFloor;
+            m_asyncCallbackStackTop = kUserMemoryBase;
+        }
+        else
+        {
+            const uint32_t hardLimit = std::min(kGuestHeapHardLimit, PS2_RAM_SIZE);
+            m_asyncCallbackStackFloor = std::min(std::max(hardLimit, suggestedHeapBase), PS2_RAM_SIZE);
+            m_asyncCallbackStackTop = PS2_RAM_SIZE;
+        }
     }
 
     LoadedModule module;
