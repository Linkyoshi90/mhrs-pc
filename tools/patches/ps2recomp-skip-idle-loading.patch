+int64_t EeScheduler::hostMsSinceDisplayWrite()
+{
+    extern std::atomic<int64_t> g_lastDisplayWriteNs; // ps2_memory.cpp
+    const int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    return (now - g_lastDisplayWriteNs.load(std::memory_order_relaxed)) / 1000000;
+}
+
+// Set by sceMpegGetPicture, which a playing movie calls for every picture.
+std::atomic<int64_t> g_lastMoviePictureNs{0};
+
+static bool skipIdleNow(PS2Runtime &runtime)
+{
+    const EeScheduler::SkipIdleFn whileFn = g_skipIdleWhile.load(std::memory_order_relaxed);
+    if (whileFn == nullptr || !whileFn(runtime.memory().getRDRAM()))
+        return false;
+    // Never during a movie: its pictures follow the guest clock, and a load can run under one.
+    constexpr int64_t kMovieQuietNs = 200 * 1000000ll;
+    const int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    return now - g_lastMoviePictureNs.load(std::memory_order_relaxed) >= kMovieQuietNs;
+}
