diff --git a/ps2xRuntime/include/runtime/ps2_pad_keys.h b/ps2xRuntime/include/runtime/ps2_pad_keys.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_pad_keys.h
@@ -0,0 +1,33 @@
+#ifndef PS2_PAD_KEYS_H
+#define PS2_PAD_KEYS_H
+
+#include <cstdint>
+#include <cstdlib>
+
+// Stick byte for a pair of opposing digital keys: full deflection (0x00 / 0xFF), 0x80 when
+// neither or both are held. Own header so ps2_runtime.h users don't rebuild on changes.
+inline uint8_t ps2PadKeyAxis(bool negative, bool positive)
+{
+    return negative == positive ? 0x80 : (negative ? 0x00 : 0xFF);
+}
+
+// PS2X_MOUSE_LOOK=<sensitivity> turns on mouse look: stick units per pixel of mouse motion per
+// host frame (e.g. 8). Unset or 0 = off.
+inline float ps2PadMouseLookScale()
+{
+    static const float scale = []
+    {
+        const char *env = std::getenv("PS2X_MOUSE_LOOK");
+        return env ? std::strtof(env, nullptr) : 0.0f;
+    }();
+    return scale;
+}
+
+// Stick byte for one frame of mouse motion, clamped to the stick range.
+inline uint8_t ps2PadMouseAxis(float delta, float scale)
+{
+    const float v = 128.0f + delta * scale;
+    return v <= 0.0f ? 0x00 : (v >= 255.0f ? 0xFF : static_cast<uint8_t>(v + 0.5f));
+}
+
+#endif
