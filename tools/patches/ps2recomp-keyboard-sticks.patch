@@ -89,13 +90,26 @@ bool PSPadBackend::readState(int /*port*/, int /*slot*/, uint8_t *data, size_t s
     }
     else
     {
-        if (IsKeyDown(KEY_UP) || IsKeyDown(KEY_W))
+        // WASD = left stick (move), arrows (or mouse, PS2X_MOUSE_LOOK) = right stick (look), IJKL = D-pad.
+        data[6] = ps2PadKeyAxis(IsKeyDown(KEY_A), IsKeyDown(KEY_D));
+        data[7] = ps2PadKeyAxis(IsKeyDown(KEY_W), IsKeyDown(KEY_S));
+        data[4] = ps2PadKeyAxis(IsKeyDown(KEY_LEFT), IsKeyDown(KEY_RIGHT));
+        data[5] = ps2PadKeyAxis(IsKeyDown(KEY_UP), IsKeyDown(KEY_DOWN));
+        if (const float mouseLook = ps2PadMouseLookScale(); mouseLook > 0.0f && data[4] == 0x80 && data[5] == 0x80)
+        {
+            // ponytail: samples only the last host frame's motion; if the game polls slower than
+            // the host frame rate, motion in between is lost. Accumulate between polls if that bites.
+            const Vector2 delta = GetMouseDelta(); // arrows win while held
+            data[4] = ps2PadMouseAxis(delta.x, mouseLook);
+            data[5] = ps2PadMouseAxis(delta.y, mouseLook);
+        }
+        if (IsKeyDown(KEY_I))
             clearBit(PAD_UP);
-        if (IsKeyDown(KEY_DOWN) || IsKeyDown(KEY_S))
+        if (IsKeyDown(KEY_K))
             clearBit(PAD_DOWN);
-        if (IsKeyDown(KEY_LEFT) || IsKeyDown(KEY_A))
+        if (IsKeyDown(KEY_J))
             clearBit(PAD_LEFT);
-        if (IsKeyDown(KEY_RIGHT) || IsKeyDown(KEY_D))
+        if (IsKeyDown(KEY_L))
             clearBit(PAD_RIGHT);
         if (IsKeyDown(KEY_X) || IsKeyDown(KEY_SPACE))
             clearBit(PAD_CROSS);
