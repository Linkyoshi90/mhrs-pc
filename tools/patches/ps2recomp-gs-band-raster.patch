+// End of the longest run from begin that may be drawn band by band: sprites and triangles into one frame and
+// depth buffer that no step of the run reads as a texture or palette, with no stale cached page among those.
+size_t GSCpuBackend::BandRunEnd(const GSDrawStep *steps, size_t begin, size_t count) const
+{
+    if (RowWorkerPool::instance().workers() == 0)
+        return begin;
+    const GSContext *first = nullptr;
+    int x0 = INT32_MAX, y0 = INT32_MAX, x1 = -1, y1 = -1;
+    bool depthAccess = false, cacheChecked = false;
+    PageSpan reads{UINT32_MAX, 0}; // texture and palette pages, empty while first > last
+    size_t i = begin;
+    for (; i < count; ++i)
+    {
+        PageSpan nReads = reads;
+        auto addRead = [&](const PageSpan &span)
+        {
+            nReads.first = std::min(nReads.first, span.first);
+            nReads.last = std::max(nReads.last, span.last);
+        };
+        int nx0 = x0, ny0 = y0, nx1 = x1, ny1 = y1;
+        bool nDepth = depthAccess;
+        const GSContext *nFirst = first;
+        if (!steps[i].draw)
+        {
+            const GSTex0Reg &tex0 = steps[i].tex0;
+            const bool indexed = isFourBitIndexedPsm(tex0.psm) || isEightBitIndexedPsm(tex0.psm);
+            if (indexed && tex0.cld >= 1u && tex0.cld <= 5u)
+            {
+                const GSTexClutReg &clut = steps[i].texclut;
+                const uint32_t entries = isFourBitIndexedPsm(tex0.psm) ? 16u : 256u;
+                PageSpan span;
+                // CSM1 reads a 16x16 CT32/CT16 block of blocks cbp..cbp+3.
+                const bool ok = tex0.csm == 0u
+                                    ? (span = PageSpan{tex0.cbp / 32u, (tex0.cbp + 3u) / 32u}).last < 512u
+                                    : pageSpan(tex0.cpsm, tex0.cbp, clut.cbw != 0u ? clut.cbw : 1u, clut.cou * 16u, clut.cov,
+                                               clut.cou * 16u + entries - 1u, clut.cov, span);
+                if (!ok)
+                    break;
+                addRead(span);
+            }
+        }
+        else
+        {
+            const GSPrimitiveBatch &batch = *steps[i].draw;
+            if (batch.vertexCount == 0u)
+                continue;
+            const auto type = batch.state.prim.type;
+            if (type != GS_PRIM_SPRITE && type != GS_PRIM_TRIANGLE && type != GS_PRIM_TRISTRIP && type != GS_PRIM_TRIFAN)
+                break;
+            // Large primitives keep the row-parallel raster, which decodes their texture up front.
+            int px0, px1, py0, py1;
+            primitiveSpan(batch, true, px0, px1);
+            primitiveSpan(batch, false, py0, py1);
+            if (static_cast<int64_t>(px1 - px0 + 1) * (py1 - py0 + 1) >= 16384)
+                break;
+            const auto &ctx = batch.state.context;
+            if (!nFirst)
+                nFirst = &ctx;
+            else if (ctx.frame.fbp != nFirst->frame.fbp || ctx.frame.fbw != nFirst->frame.fbw ||
+                     ctx.frame.psm != nFirst->frame.psm || ctx.zbuf.zbp != nFirst->zbuf.zbp || ctx.zbuf.psm != nFirst->zbuf.psm)
+                break;
+            // Every pixel lies in the scissor rectangle.
+            nx0 = std::min<int>(nx0, std::min(ctx.scissor.x0, ctx.scissor.x1));
+            ny0 = std::min<int>(ny0, std::min(ctx.scissor.y0, ctx.scissor.y1));
+            nx1 = std::max<int>(nx1, std::max(ctx.scissor.x0, ctx.scissor.x1));
+            ny1 = std::max<int>(ny1, std::max(ctx.scissor.y0, ctx.scissor.y1));
+            if (static_cast<uint32_t>(nx1) >= std::max<uint32_t>(ctx.frame.fbw, 1u) * 64u)
+                break; // wider rows alias other rows of the buffer
+            nDepth = nDepth || ((ctx.test >> 17) & 3u) >= 2u || !ctx.zbuf.zmask;
+            if (batch.state.prim.tme)
+            {
+                const auto &tex = ctx.tex0;
+                const uint32_t maxU = (ctx.clamp & 0x2u) != 0u ? 1023u : std::max<uint32_t>(batch.state.textureWidth, 1u) - 1u;
+                const uint32_t maxV = ((ctx.clamp >> 2) & 0x2u) != 0u ? 1023u : std::max<uint32_t>(batch.state.textureHeight, 1u) - 1u;
+                PageSpan span;
+                if (!pageSpan(tex.psm, tex.tbp0, tex.tbw, 0u, 0u, maxU, maxV, span))
+                    break;
+                addRead(span);
+            }
+        }
+        if (nFirst)
+        {
+            const uint32_t fbw = std::max<uint32_t>(nFirst->frame.fbw, 1u);
+            PageSpan frame, depth;
+            if (!pageSpan(nFirst->frame.psm, framePageBaseToBlock(nFirst->frame.fbp), fbw, nx0, ny0, nx1, ny1, frame))
+                break;
+            if (nDepth && (!pageSpan(nFirst->zbuf.psm, framePageBaseToBlock(nFirst->zbuf.zbp), fbw, nx0, ny0, nx1, ny1, depth) ||
+                           depth.overlaps(frame)))
+                break;
+            if (nReads.first <= nReads.last && (nReads.overlaps(frame) || (nDepth && nReads.overlaps(depth))))
+                break;
+        }
+        // Bands and the CLUT pre-pass read fresh VRAM; the serial raster would see a stale cached page.
+        const uint32_t cachedPage = m_texturePageCache.PageBase() / GSMem::TexturePageCache::kPageSize;
+        if (!cacheChecked && cachedPage >= nReads.first && cachedPage <= nReads.last)
+        {
+            if (!m_texturePageCache.MatchesVram(m_vram))
+                break;
+            cacheChecked = true;
+        }
+        first = nFirst;
+        x0 = nx0, y0 = ny0, x1 = nx1, y1 = ny1;
+        depthAccess = nDepth;
+        reads = nReads;
+    }
+    return i;
+}
