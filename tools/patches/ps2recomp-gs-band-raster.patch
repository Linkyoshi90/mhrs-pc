+void GSCpuBackend::DrawInBands(const GSDrawStep *steps, size_t count)
+{
+    // CLUT loads run here first, in order; each primitive gets the palette current at its step.
+    thread_local std::vector<std::array<uint16_t, 512>> clutsTl;
+    thread_local std::vector<std::pair<int, int>> rowsTl;
+    thread_local std::vector<uint32_t> clutOfTl;
+    std::vector<std::array<uint16_t, 512>> &cluts = clutsTl; // lambdas do not capture thread_locals
+    std::vector<std::pair<int, int>> &rows = rowsTl;
+    std::vector<uint32_t> &clutOf = clutOfTl;
+    cluts.assign(1, m_clut);
+    rows.resize(count);
+    clutOf.resize(count);
+    size_t lastClutRead = SIZE_MAX;
+    int top = INT32_MAX, bottom = INT32_MIN;
+    for (size_t i = 0; i < count; ++i)
+    {
+        rows[i] = {INT32_MAX, INT32_MIN}; // no rows: CLUT loads and empty batches
+        if (!steps[i].draw)
+        {
+            if (ApplyClutLoad(steps[i].tex0, steps[i].texclut))
+            {
+                lastClutRead = i;
+                cluts.push_back(m_clut);
+            }
+            continue;
+        }
+        clutOf[i] = static_cast<uint32_t>(cluts.size() - 1u);
+        if (steps[i].draw->vertexCount == 0u)
+            continue;
+        primitiveSpan(*steps[i].draw, false, rows[i].first, rows[i].second);
+        top = std::min(top, rows[i].first);
+        bottom = std::max(bottom, rows[i].second);
+    }
+    if (top > bottom)
+        return;
+
+    RowWorkerPool &pool = RowWorkerPool::instance();
+    const int bandCount = std::min(bottom - top + 1, static_cast<int>(2u * (pool.workers() + 1u)));
+    const int rowsPerBand = (bottom - top + bandCount) / bandCount;
+    struct BandEnd
+    {
+        size_t lastRead; // last step that read a texel in this band
+        uint32_t page;
+    };
+    thread_local std::vector<BandEnd> endsTl;
+    std::vector<BandEnd> &ends = endsTl;
+    ends.assign(static_cast<size_t>(bandCount), BandEnd{SIZE_MAX, UINT32_MAX});
+    pool.run(bandCount, [&](int b)
+    {
+        thread_local BandRows band;
+        band.y0 = top + b * rowsPerBand;
+        band.y1 = std::min(bottom, band.y0 + rowsPerBand - 1);
+        band.cache.Invalidate();
+        size_t lastRead = SIZE_MAX;
+        t_bandRows = &band;
+        for (size_t i = 0; i < count; ++i)
+        {
+            if (rows[i].second < band.y0 || rows[i].first > band.y1)
+                continue;
+            band.read = false;
+            band.clut = cluts[clutOf[i]].data();
+            DrawPrimitive(*steps[i].draw);
+            if (band.read)
+                lastRead = i;
+        }
+        t_bandRows = nullptr;
+        ends[static_cast<size_t>(b)] = BandEnd{lastRead, band.cache.PageBase()};
+    });
+
+    // The serial raster leaves the page of its last read cached. If a primitive read after the last CLUT load
+    // did, that is the last such primitive in its bottom band that read (rows run top to bottom); the pre-pass
+    // already left the CLUT's page. Nothing the run read was written, so VRAM still holds that page.
+    const BandEnd *last = nullptr;
+    for (const BandEnd &end : ends)
+        if (end.lastRead != SIZE_MAX && (!last || end.lastRead >= last->lastRead))
+            last = &end;
+    if (last && (lastClutRead == SIZE_MAX || last->lastRead > lastClutRead))
+    {
+        m_texturePageCache.Invalidate();
+        m_texturePageCache.Resolve(m_vram, last->page);
+    }
+}
