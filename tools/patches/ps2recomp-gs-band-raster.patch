+void GSCpuBackend::SubmitMany(const GSDrawStep *steps, size_t count)
+{
+    // Below this many pixels (by bounding box), waking the workers costs more than it saves.
+    constexpr int64_t kMinBandArea = 4096;
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_vram)
+        return;
+    size_t i = 0;
+    while (i < count)
+    {
+        const size_t end = BandRunEnd(steps, i, count);
+        int64_t area = 0;
+        for (size_t k = i; k < end && area < kMinBandArea; ++k)
+        {
+            if (!steps[k].draw || steps[k].draw->vertexCount == 0u)
+                continue;
+            int x0, x1, y0, y1;
+            primitiveSpan(*steps[k].draw, true, x0, x1);
+            primitiveSpan(*steps[k].draw, false, y0, y1);
+            area += static_cast<int64_t>(x1 - x0 + 1) * (y1 - y0 + 1);
+        }
+        if (area >= kMinBandArea)
+        {
+            DrawInBands(steps + i, end - i);
+            i = end;
+            continue;
+        }
+        for (const size_t stop = std::max(end, i + 1); i < stop; ++i)
+        {
+            if (!steps[i].draw)
+                ApplyClutLoad(steps[i].tex0, steps[i].texclut);
+            else if (steps[i].draw->vertexCount != 0u)
+                DrawPrimitive(*steps[i].draw);
+        }
+    }
+}
