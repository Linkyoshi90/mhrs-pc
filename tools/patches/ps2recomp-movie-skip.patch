+bool ps2PadSkipMoviePressed(int &held, uint32_t picturesShown)
+{
+    // PS2X_SKIP_MOVIES=<n>: skip every movie after n pictures (for unattended runs).
+    static const long autoSkip = std::getenv("PS2X_SKIP_MOVIES") ? std::atol(std::getenv("PS2X_SKIP_MOVIES")) : -1;
+    const bool always = autoSkip >= 0 && static_cast<long>(picturesShown) >= autoSkip;
+    const int down = IsWindowReady() && targetStrength(ps2PadControls(), PadSkipMovie, 1.0f) > 0.5f ? 1 : 0;
+    // ponytail: ending a movie before it has properly started hangs the game (seen at picture 0; 60 is the
+    // tested value), so a press in its first 2 s is ignored. Find what the game waits for if that matters.
+    const bool pressed = held == 0 && down == 1 && picturesShown >= 60u;
+    held = down;
+    return pressed || always;
+}
