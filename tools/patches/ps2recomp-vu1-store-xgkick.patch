+// A store lands at the cycle boundary that ends its pair (advanceOneCycle), before anything reads VU data
+// again (PATH1 reads after it), so writing it at issue is the same.
+VU1_ALWAYS_INLINE void VU1Interpreter::storeVuData(uint32_t address, const uint32_t words[4], uint8_t laneMask)
+{
+    if (!m_activeVuData || address + 16u > m_activeVuDataSize)
+        return;
+    for (uint32_t component = 0; component < 4u; ++component)
+        if ((laneMask & laneForComponent(component)) != 0u)
+            std::memcpy(m_activeVuData + address + component * 4u, &words[component], sizeof(uint32_t));
+}
