@@ -117,14 +122,24 @@ private:
     void loop()
     {
         std::vector<std::function<void()>> batch;
+        uint64_t taken = 0; // jobs taken off the queue so far
         for (;;)
         {
+            // Jobs often arrive microseconds apart (one per GIF packet), and a wake-up per job cost the
+            // poster a quarter of its time in futex syscalls: poll a short while before going to sleep.
+            const auto pollEnd = std::chrono::steady_clock::now() + kPollTime;
+            while (std::atomic_ref<uint64_t>(m_posted).load(std::memory_order_relaxed) == taken &&
+                   std::chrono::steady_clock::now() < pollEnd)
+                std::this_thread::yield();
             {
                 std::unique_lock<std::mutex> lock(m_mutex);
+                m_sleeping = true;
                 m_wake.wait(lock, [&] { return !m_jobs.empty() || m_stopping; });
+                m_sleeping = false;
                 if (m_jobs.empty())
                     return; // stopping, nothing left
                 batch.swap(m_jobs);
+                taken += batch.size();
             }
             for (auto &job : batch)
             {
@@ -160,6 +175,8 @@ private:
     uint64_t m_posted = 0;
     uint64_t m_done = 0;
     bool m_stopping = false;
+    bool m_sleeping = false; // the thread is (about to be) blocked on m_wake; guarded by m_mutex
+    static constexpr std::chrono::microseconds kPollTime{100};
 };
 
 #endif // PS2_ORDERED_WORKER_H
