+GraphicsSettings ps2ParseGraphics(std::string_view text)
+{
+    GraphicsSettings s;
+    std::istringstream in{std::string(text)};
+    for (std::string line; std::getline(in, line);)
+    {
+        line = line.substr(0, line.find('#'));
+        const size_t eq = line.find('=');
+        if (eq == std::string::npos)
+            continue;
+        std::string key = line.substr(0, eq);
+        key.erase(std::remove_if(key.begin(), key.end(), [](unsigned char c) { return std::isspace(c); }), key.end());
+        const char *value = line.c_str() + eq + 1;
+        int a = 0, b = 0;
+        char word[16] = {};
+        if (key == "window" && std::sscanf(value, " %dx%d", &a, &b) == 2 && a >= 320 && b >= 240)
+        {
+            s.windowW = a;
+            s.windowH = b;
+        }
+        else if (key == "fullscreen" && std::sscanf(value, " %d", &a) == 1)
+            s.fullscreen = a != 0;
+        else if (key == "scale" && std::sscanf(value, " %d", &a) == 1 && a >= 1 && a <= static_cast<int>(kGsHiresMaxScaleLimit))
+            s.scale = static_cast<uint32_t>(a); // above max_scale: gsHiresSetScale lowers it
+        else if (key == "max_scale" && std::sscanf(value, " %d", &a) == 1 && a >= 1 && a <= static_cast<int>(kGsHiresMaxScaleLimit))
+            s.maxScale = static_cast<uint32_t>(a);
+        else if (key == "fps" && std::sscanf(value, " %d", &a) == 1)
+            s.frameRate = a <= 30 ? 30 : 60;
+        else if (key == "antialias" && std::sscanf(value, " %15s", word) == 1)
+            for (int i = 0; i < 4; ++i)
+                if (std::strcmp(word, kAntialiasNames[i]) == 0)
+                    s.antialias = i;
+    }
+    return s;
+}
+
+std::string ps2FormatGraphics(const GraphicsSettings &s)
+{
+    std::ostringstream out;
+    out << "# Written by the graphics menu (F4).\n";
+    if (s.windowW > 0)
+        out << "window = " << s.windowW << "x" << s.windowH << "    # window size when not fullscreen\n";
+    out << "fullscreen = " << (s.fullscreen ? 1 : 0) << "    # borderless, at the monitor's resolution\n";
+    if (s.scale > 0)
+        out << "scale = " << s.scale << "    # internal resolution, 1 (native PS2) to max_scale\n";
+    if (s.maxScale > 0)
+        out << "max_scale = " << s.maxScale << "    # highest internal resolution, 1 to " << kGsHiresMaxScaleLimit
+            << "; read at start, GPU memory grows with its square\n";
+    out << "antialias = " << kAntialiasNames[s.antialias & 3] << "    # off, ssaa, fxaa or ssaa+fxaa\n";
+    out << "fps = " << s.frameRate << "    # game frame rate: 60 or 30 (menus always run at 30)\n";
+    return out.str();
+}
+
+GraphicsSettings ps2LoadGraphics()
+{
+    std::ifstream file(ps2GraphicsPath());
+    return ps2ParseGraphics(std::string(std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>()));
+}
