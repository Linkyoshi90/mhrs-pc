+// Anti-aliasing of the frame as the window draws it (graphics menu), after the GS: native VRAM never sees it, and
+// the overlays drawn after it (FPS monitor, menus, debug UI) stay sharp. GLSL 330: raylib's desktop OpenGL 3.3.
+namespace
+{
+    // SSAA: a frame larger than where it is drawn (internal resolution above the window size) is reduced with an
+    // area filter, each window pixel the coverage-weighted mean of every frame texel under it. Bilinear minification
+    // reads 2x2 texels and skips the rest beyond a 2x reduction. Not larger: the texture's own filter, as without it.
+    constexpr const char *kSsaaShader = R"(#version 330
+in vec2 fragTexCoord;
+in vec4 fragColor;
+uniform sampler2D texture0;
+uniform vec4 colDiffuse;
+out vec4 finalColor;
+void main()
+{
+    vec2 size = vec2(textureSize(texture0, 0));
+    vec2 ratio = vec2(abs(dFdx(fragTexCoord.x)), abs(dFdy(fragTexCoord.y))) * size; // texels per window pixel
+    if (ratio.x <= 1.0 && ratio.y <= 1.0)
+    {
+        finalColor = texture(texture0, fragTexCoord) * colDiffuse * fragColor;
+        return;
+    }
+    ratio = max(ratio, vec2(1.0));
+    vec2 lo = fragTexCoord * size - 0.5 * ratio;
+    vec2 hi = lo + ratio;
+    ivec2 first = ivec2(floor(lo));
+    ivec2 last = ivec2(ceil(hi)) - 1;
+    ivec2 edge = ivec2(size) - 1;
+    vec4 sum = vec4(0.0);
+    float total = 0.0;
+    // 17 texels: a 16x reduction (an 8x frame in a 320 pixel wide window) at any offset.
+    for (int y = first.y; y <= last.y && y < first.y + 17; ++y)
+    {
+        float wy = min(hi.y, float(y + 1)) - max(lo.y, float(y));
+        for (int x = first.x; x <= last.x && x < first.x + 17; ++x)
+        {
+            float w = wy * (min(hi.x, float(x + 1)) - max(lo.x, float(x)));
+            sum += texelFetch(texture0, clamp(ivec2(x, y), ivec2(0), edge), 0) * w;
+            total += w;
+        }
+    }
+    finalColor = sum / total * colDiffuse * fragColor;
+}
+)";
+
+    // FXAA (the compact variant of Lottes' FXAA): over the frame as drawn, 1:1 with window pixels.
+    constexpr const char *kFxaaShader = R"(#version 330
+in vec2 fragTexCoord;
+in vec4 fragColor;
+uniform sampler2D texture0;
+uniform vec4 colDiffuse;
+out vec4 finalColor;
+void main()
+{
+    vec2 px = 1.0 / vec2(textureSize(texture0, 0));
+    vec2 uv = fragTexCoord;
+    const vec3 toLuma = vec3(0.299, 0.587, 0.114);
+    float lumaNW = dot(texture(texture0, uv + vec2(-1.0, -1.0) * px).rgb, toLuma);
+    float lumaNE = dot(texture(texture0, uv + vec2(1.0, -1.0) * px).rgb, toLuma);
+    float lumaSW = dot(texture(texture0, uv + vec2(-1.0, 1.0) * px).rgb, toLuma);
+    float lumaSE = dot(texture(texture0, uv + vec2(1.0, 1.0) * px).rgb, toLuma);
+    vec4 centre = texture(texture0, uv);
+    float lumaM = dot(centre.rgb, toLuma);
+    float lumaMin = min(lumaM, min(min(lumaNW, lumaNE), min(lumaSW, lumaSE)));
+    float lumaMax = max(lumaM, max(max(lumaNW, lumaNE), max(lumaSW, lumaSE)));
+    vec2 dir = vec2(-((lumaNW + lumaNE) - (lumaSW + lumaSE)), (lumaNW + lumaSW) - (lumaNE + lumaSE));
+    float reduce = max((lumaNW + lumaNE + lumaSW + lumaSE) * (0.25 / 8.0), 1.0 / 128.0);
+    float scale = 1.0 / (min(abs(dir.x), abs(dir.y)) + reduce);
+    dir = clamp(dir * scale, vec2(-8.0), vec2(8.0)) * px;
+    vec3 a = 0.5 * (texture(texture0, uv + dir * (1.0 / 3.0 - 0.5)).rgb + texture(texture0, uv + dir * (2.0 / 3.0 - 0.5)).rgb);
+    vec3 b = a * 0.5 + 0.25 * (texture(texture0, uv - dir * 0.5).rgb + texture(texture0, uv + dir * 0.5).rgb);
+    float lumaB = dot(b, toLuma);
+    finalColor = vec4((lumaB < lumaMin || lumaB > lumaMax) ? a : b, centre.a) * colDiffuse * fragColor;
+}
+)";
+
+    // A shader of the window's, loaded at first use; null when it does not compile (logged once): drawn without it.
+    const Shader *windowShader(Shader &shader, int &state, const char *code, const char *name)
+    {
+        if (state == 0)
+        {
+            shader = LoadShaderFromMemory(nullptr, code);
+            state = shader.id != rlGetShaderIdDefault() ? 1 : -1;
+            if (state < 0)
+                std::cerr << "[window] " << name << " shader did not compile, anti-aliasing without it" << std::endl;
+        }
+        return state > 0 ? &shader : nullptr;
+    }
+
+    // Draws the frame texture (src of it) into dst with the graphics menu's anti-aliasing.
+    void drawFrame(const Texture2D &tex, Rectangle src, Rectangle dst)
+    {
+        static Shader ssaa{}, fxaa{};
+        static int ssaaState = 0, fxaaState = 0;
+        static RenderTexture2D target{};
+        const int antialias = ps2GraphicsAntialias();
+        const Shader *box = (antialias & kAntialiasSsaa) ? windowShader(ssaa, ssaaState, kSsaaShader, "SSAA") : nullptr;
+        const Shader *post = (antialias & kAntialiasFxaa) ? windowShader(fxaa, fxaaState, kFxaaShader, "FXAA") : nullptr;
+        // FXAA reads the frame as drawn: drawn into a texture of dst's size first (whole pixels, so it maps 1:1).
+        const int w = static_cast<int>(std::lround(dst.width)), h = static_cast<int>(std::lround(dst.height));
+        if (post && w > 0 && h > 0 && (target.texture.width != w || target.texture.height != h))
+        {
+            if (target.id != 0)
+                UnloadRenderTexture(target);
+            target = LoadRenderTexture(w, h);
+            SetTextureFilter(target.texture, TEXTURE_FILTER_BILINEAR); // FXAA samples between pixels
+        }
+        if (post && (w <= 0 || h <= 0 || !IsRenderTextureValid(target)))
+            post = nullptr;
+        if (post)
+        {
+            BeginTextureMode(target);
+            ClearBackground(BLACK);
+        }
+        if (box)
+            BeginShaderMode(*box);
+        DrawTexturePro(tex, src, post ? Rectangle{0.0f, 0.0f, static_cast<float>(w), static_cast<float>(h)} : dst, Vector2{0.0f, 0.0f}, 0.0f, WHITE);
+        if (box)
+            EndShaderMode();
+        if (!post)
+            return;
+        EndTextureMode();
+        BeginShaderMode(*post);
+        // Render textures are stored bottom-up: a negative source height flips them back.
+        DrawTexturePro(target.texture, Rectangle{0.0f, 0.0f, static_cast<float>(w), -static_cast<float>(h)},
+                       Rectangle{std::round(dst.x), std::round(dst.y), static_cast<float>(w), static_cast<float>(h)}, Vector2{0.0f, 0.0f}, 0.0f, WHITE);
+        EndShaderMode();
+    }
+}
