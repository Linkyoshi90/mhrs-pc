+    // The head node of the game's vertex transform/clip loop in its steady timing state, which the native kernel
+    // LeanAccess::transformClipLoop (ps2_vu1_lean.h) runs: node n has the loop's first 13 pairs at cycles 0..12
+    // (Q lands at 9) and on IBEQ taken goes to the node at +0xD8 (2 pairs at 0, 1), which loops back to n. The
+    // chain-start saves must be the ones the kernel rebuilds.
+    bool transformClipHead(const Program &program, size_t n)
+    {
+        static constexpr uint32_t kWords[15][2] = {
+            {0x81E71B7Cu, 0x01C05B9Cu}, {0x81EC2B7Cu, 0x0034AD56u}, {0x81E803BCu, 0x01C841FFu}, {0x8000033Cu, 0x01C5426Au},
+            {0x8000033Cu, 0x01E709BCu}, {0x8000033Cu, 0x0034AD84u}, {0x81EB237Cu, 0x01E710BDu}, {0x12021001u, 0x01E718BEu},
+            {0x2403FFFFu, 0x01E7220Bu}, {0x8000033Cu, 0x01ED517Du}, {0x81E6737Du, 0x002001FEu}, {0x5001000Fu, 0x0036A2ADu},
+            {0x81E6637Du, 0x00344550u}, {0x5A0017E4u, 0x01C032BCu}, {0x81E66B7Du, 0x01C04AA1u}};
+        const Node &x = program.nodes[n];
+        const auto pairsMatch = [](const Node &node, size_t first, size_t count, const std::vector<std::pair<uint8_t, size_t>> &saves)
+        {
+            if (node.pairs.size() != count || !node.exitCommits.empty())
+                return false;
+            for (size_t i = 0; i < count; ++i)
+            {
+                const PairCode &p = node.pairs[i];
+                uint8_t save = 0;
+                for (const auto &[lanes, at] : saves)
+                    if (at == i)
+                        save = lanes;
+                const std::vector<uint32_t> commits = (first == 0u && i == 9u) ? std::vector<uint32_t>{9u} : std::vector<uint32_t>{};
+                if (p.pc != node.pc + 8u * i || p.lower != kWords[first + i][0] || p.upper != kWords[first + i][1] ||
+                    p.issue != i || p.from != i || p.commits != commits || p.kick || p.saveUpper != save || p.saveLower != 0u ||
+                    p.viPending || p.saveVi)
+                    return false;
+            }
+            return true;
+        };
+        if (!pairsMatch(x, 0, 13, {{1u, 11u}, {1u, 12u}}) || x.exit.kind != Exit::Cond || x.exit.rel != 13u ||
+            x.exit.pc != x.pc + 0xD8u || x.exit.targets.empty() || x.exit.targets[0] < 0)
+            return false;
+        const Node &y = program.nodes[static_cast<size_t>(x.exit.targets[0])];
+        return y.pc == x.pc + 0xD8u && pairsMatch(y, 13, 2, {{14u, 1u}}) && y.exit.kind == Exit::Cond && y.exit.rel == 2u &&
+               y.exit.pc == x.pc && !y.exit.targets.empty() && y.exit.targets[0] == static_cast<int>(n);
+    }
+
