+std::string ps2PadInputName(const PadInput &input)
+{
+    const auto lower = [](const char *name)
+    {
+        std::string s(name);
+        std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+        return s;
+    };
+    switch (input.kind)
+    {
+    case PadInput::Key:
+        if ((input.code >= 'A' && input.code <= 'Z') || (input.code >= '0' && input.code <= '9'))
+            return std::string(1, static_cast<char>(input.code));
+        if (input.code >= KEY_F1 && input.code <= KEY_F12)
+            return "F" + std::to_string(input.code - KEY_F1 + 1);
+        if (input.code >= KEY_KP_0 && input.code <= KEY_KP_9)
+            return "KP_" + std::to_string(input.code - KEY_KP_0);
+        for (const Name &entry : kKeys)
+            if (entry.code == input.code)
+                return entry.name;
+        return {};
+    case PadInput::Mouse:
+        for (const Name &entry : kMouseButtons)
+            if (entry.code == input.code)
+                return "mouse:" + lower(entry.name);
+        return {};
+    case PadInput::PadButton:
+        for (const Name &entry : kPadButtons)
+            if (entry.code == input.code)
+                return "pad:" + lower(entry.name);
+        return {};
+    case PadInput::PadAxis:
+        for (const Name &entry : kPadAxes)
+            if (entry.code == input.code)
+                return "pad:" + lower(entry.name) + (input.sign > 0 ? "+" : "-");
+        return {};
+    }
+    return {};
+}
+
+std::string ps2PadFormatControls(const PadControls &controls)
+{
+    std::ostringstream os;
+    os << "# Written by the controls menu (F2). Format: see controls.example.ini.\n";
+    os << "mouse_look = " << controls.mouseLook << "\n";
+    os << "deadzone = " << controls.deadzone << "\n";
+    os << "sensitivity = " << controls.sensitivity << "\n";
+    os << "invert_y = " << (controls.invertY ? 1 : 0) << "\n";
+    os << "gamepad = " << controls.gamepad << "\n";
+    for (size_t target = 0; target < PadTargetCount; ++target)
+    {
+        os << kTargetNames[target] << " =";
+        bool first = true;
+        for (const PadInput &input : controls.bind[target])
+        {
+            const std::string name = ps2PadInputName(input);
+            if (name.empty())
+                continue;
+            os << (first ? " " : ", ") << name;
+            first = false;
+        }
+        os << "\n";
+    }
+    return os.str();
 }
 
