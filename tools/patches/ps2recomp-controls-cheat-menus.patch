+#ifndef PS2_MENUS_H
+#define PS2_MENUS_H
+
+#include <cstdint>
+
+// In-window menus, drawn over the game by the render loop: F2 rebinds the controls (saved to the controls file),
+// F5 toggles the game's own bonus cheats (MOH: Rising Sun only; saved to cheats.ini). While one is open the game
+// keeps running but sees an idle pad. rdram: guest memory, for the cheat flags.
+void ps2MenusUpdateAndDraw(uint8_t *rdram);
+
+#endif
diff --git a/ps2xRuntime/src/lib/ps2_menus.cpp b/ps2xRuntime/src/lib/ps2_menus.cpp
new file mode 100755
index 0000000..b9838db
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_menus.cpp
@@ -0,0 +1,415 @@
+#include "runtime/ps2_menus.h"
+#include "runtime/ps2_pad_keys.h"
+#include "ps2_host_backend.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+namespace
+{
+    enum class Menu
+    {
+        None,
+        Controls,
+        Cheats
+    };
+
+    // ---- drawing ----
+    constexpr int kRowHeight = 22;
+    constexpr int kFont = 18;
+
+    struct Panel
+    {
+        int x, y, w, h;
+    };
+
+    Panel drawPanel(const char *title, int rows, const char *help)
+    {
+        const int w = std::min(GetScreenWidth() - 40, 760);
+        const int h = std::min(GetScreenHeight() - 40, 90 + rows * kRowHeight);
+        const Panel p{(GetScreenWidth() - w) / 2, (GetScreenHeight() - h) / 2, w, h};
+        DrawRectangle(p.x, p.y, p.w, p.h, Color{0, 0, 0, 215});
+        DrawRectangleLines(p.x, p.y, p.w, p.h, Color{200, 170, 90, 255});
+        DrawText(title, p.x + 16, p.y + 12, 24, Color{230, 200, 110, 255});
+        DrawText(help, p.x + 16, p.y + p.h - 26, 16, LIGHTGRAY);
+        return p;
+    }
+
+    // Rows first..first+visible of a list with a selection, scrolled so the selection stays visible.
+    struct ListView
+    {
+        int first = 0, visible = 0;
+    };
+
+    ListView scrollTo(const Panel &p, int count, int selected)
+    {
+        ListView v;
+        v.visible = std::max(1, (p.h - 90) / kRowHeight);
+        v.first = std::clamp(selected - v.visible / 2, 0, std::max(0, count - v.visible));
+        return v;
+    }
+
+    bool pressed(int key) { return IsKeyPressed(key) || IsKeyPressedRepeat(key); }
+
+    // ---- controls menu ----
+    constexpr const char *kTargetLabels[PadTargetCount] = {
+        "D-pad up", "D-pad down", "D-pad left", "D-pad right", "Cross", "Circle", "Square", "Triangle",
+        "L1", "R1", "L2", "R2", "L3", "R3", "Start", "Select",
+        "Move forward", "Move back", "Move left", "Move right", "Look up", "Look down", "Look left", "Look right",
+        "Skip movie", "Fast forward (hold)"};
+    enum SettingRow
+    {
+        RowMouseLook = PadTargetCount,
+        RowSensitivity,
+        RowDeadzone,
+        RowInvertY,
+        RowDefaults,
+        RowCount
+    };
+
+    struct ControlsMenu
+    {
+        int selected = 0;
+        bool capturing = false;
+        float axisRest[4] = {}; // stick positions when the capture started: only a new deflection binds
+        std::string status;
+    };
+
+    bool isKeyboardOrMouse(const PadInput &input) { return input.kind == PadInput::Key || input.kind == PadInput::Mouse; }
+
+    void applyControls(PadControls controls, std::string &status)
+    {
+        const std::string text = ps2PadFormatControls(controls);
+        if (controls.mouseLook > 0.0f && !IsCursorHidden())
+            DisableCursor();
+        else if (controls.mouseLook <= 0.0f && IsCursorHidden())
+            EnableCursor();
+        ps2PadSetControls(std::move(controls));
+        std::ofstream file(ps2PadControlsPath(), std::ios::trunc);
+        file << text;
+        status = file ? std::string("Saved to ") + ps2PadControlsPath() : std::string("Could not write ") + ps2PadControlsPath();
+    }
+
+    // The input pressed this frame, if any (keys, mouse buttons, gamepad buttons, a stick pushed past 60%).
+    bool captureInput(const ControlsMenu &menu, int gamepad, PadInput &input)
+    {
+        for (int key = GetKeyPressed(); key != 0; key = GetKeyPressed())
+        {
+            if (key == KEY_F2 || key == KEY_F3 || key == KEY_F5)
+                continue; // the menu and HUD keys
+            input = {PadInput::Key, key, 0};
+            if (!ps2PadInputName(input).empty())
+                return true;
+        }
+        for (int button = MOUSE_BUTTON_LEFT; button <= MOUSE_BUTTON_EXTRA; ++button)
+            if (IsMouseButtonPressed(button))
+            {
+                input = {PadInput::Mouse, button, 0};
+                return true;
+            }
+        if (!IsGamepadAvailable(gamepad))
+            return false;
+        for (int button = GAMEPAD_BUTTON_LEFT_FACE_UP; button <= GAMEPAD_BUTTON_RIGHT_THUMB; ++button)
+            if (IsGamepadButtonPressed(gamepad, button))
+            {
+                input = {PadInput::PadButton, button, 0};
+                if (!ps2PadInputName(input).empty())
+                    return true;
+            }
+        for (int axis = GAMEPAD_AXIS_LEFT_X; axis <= GAMEPAD_AXIS_RIGHT_Y; ++axis)
+        {
+            const float v = GetGamepadAxisMovement(gamepad, axis);
+            if (std::fabs(v) > 0.6f && std::fabs(menu.axisRest[axis]) < 0.3f)
+            {
+                input = {PadInput::PadAxis, axis, v > 0.0f ? 1 : -1};
+                return true;
+            }
+        }
+        return false;
+    }
+
+    std::string bindingText(const std::vector<PadInput> &inputs)
+    {
+        std::string text;
+        for (const PadInput &input : inputs)
+        {
+            const std::string name = ps2PadInputName(input);
+            if (!name.empty())
+                text += (text.empty() ? "" : ", ") + name;
+        }
+        return text.empty() ? "-" : text;
+    }
+
+    // Returns false when the menu closes.
+    bool updateControls(ControlsMenu &menu)
+    {
+        PadControls controls = *ps2PadControls();
+        if (menu.capturing)
+        {
+            if (IsKeyPressed(KEY_ESCAPE))
+            {
+                menu.capturing = false;
+                menu.status = "Cancelled";
+            }
+            else if (PadInput input; captureInput(menu, controls.gamepad, input))
+            {
+                // The new input replaces the target's inputs of its kind (keyboard/mouse or gamepad), keeps the other.
+                std::vector<PadInput> &bind = controls.bind[menu.selected];
+                const bool keyboard = isKeyboardOrMouse(input);
+                std::erase_if(bind, [keyboard](const PadInput &old) { return isKeyboardOrMouse(old) == keyboard; });
+                bind.push_back(input);
+                menu.capturing = false;
+                applyControls(std::move(controls), menu.status);
+            }
+            return true;
+        }
+        if (IsKeyPressed(KEY_ESCAPE) || IsKeyPressed(KEY_F2))
+            return false;
+        if (pressed(KEY_DOWN))
+            menu.selected = (menu.selected + 1) % RowCount;
+        if (pressed(KEY_UP))
+            menu.selected = (menu.selected + RowCount - 1) % RowCount;
+        const int step = pressed(KEY_RIGHT) ? 1 : (pressed(KEY_LEFT) ? -1 : 0);
+        const bool enter = IsKeyPressed(KEY_ENTER) || IsKeyPressed(KEY_KP_ENTER);
+        if (menu.selected < PadTargetCount)
+        {
+            if (enter)
+            {
+                while (GetKeyPressed() != 0)
+                {
+                } // drop the queued Enter
+                for (int axis = 0; axis < 4; ++axis)
+                    menu.axisRest[axis] = IsGamepadAvailable(controls.gamepad) ? GetGamepadAxisMovement(controls.gamepad, axis) : 0.0f;
+                menu.capturing = true;
+                menu.status.clear();
+            }
+            else if (IsKeyPressed(KEY_DELETE) || IsKeyPressed(KEY_BACKSPACE))
+            {
+                controls.bind[menu.selected].clear();
+                applyControls(std::move(controls), menu.status);
+            }
+            return true;
+        }
+        bool changed = step != 0;
+        switch (menu.selected)
+        {
+        case RowMouseLook: controls.mouseLook = std::clamp(std::round(controls.mouseLook) + static_cast<float>(step), 0.0f, 40.0f); break;
+        case RowSensitivity: controls.sensitivity = std::clamp(std::round(controls.sensitivity * 10.0f + static_cast<float>(step)) / 10.0f, 0.1f, 3.0f); break;
+        case RowDeadzone: controls.deadzone = std::clamp(std::round(controls.deadzone * 20.0f + static_cast<float>(step)) / 20.0f, 0.0f, 0.9f); break;
+        case RowInvertY:
+            changed = step != 0 || enter;
+            if (changed)
+                controls.invertY = !controls.invertY;
+            break;
+        case RowDefaults:
+            changed = enter;
+            if (changed)
+                controls = ps2PadDefaultControls();
+            break;
+        }
+        if (changed)
+            applyControls(std::move(controls), menu.status);
+        return true;
+    }
+
+    void drawControls(const ControlsMenu &menu)
+    {
+        const std::shared_ptr<const PadControls> controls = ps2PadControls();
+        const Panel p = drawPanel("Controls", RowCount,
+                                  menu.capturing ? "Press a key, mouse button or gamepad button/stick   Esc: cancel"
+                                                 : "Up/Down: select   Enter: rebind   Del: clear   Left/Right: change   Esc/F2: close");
+        const ListView v = scrollTo(p, RowCount, menu.selected);
+        for (int i = 0; i < v.visible && v.first + i < RowCount; ++i)
+        {
+            const int row = v.first + i;
+            const int y = p.y + 48 + i * kRowHeight;
+            if (row == menu.selected)
+                DrawRectangle(p.x + 8, y - 2, p.w - 16, kRowHeight, Color{90, 70, 30, 200});
+            std::string label, value;
+            if (row < PadTargetCount)
+            {
+                label = kTargetLabels[row];
+                value = (menu.capturing && row == menu.selected) ? "< press an input >" : bindingText(controls->bind[row]);
+            }
+            else
+                switch (row)
+                {
+                case RowMouseLook: label = "Mouse look speed"; value = controls->mouseLook > 0.0f ? TextFormat("%.0f", controls->mouseLook) : "off"; break;
+                case RowSensitivity: label = "Stick look sensitivity"; value = TextFormat("%.1f", controls->sensitivity); break;
+                case RowDeadzone: label = "Gamepad dead zone"; value = TextFormat("%.2f", controls->deadzone); break;
+                case RowInvertY: label = "Invert look up/down"; value = controls->invertY ? "on" : "off"; break;
+                case RowDefaults: label = "Reset all to defaults (Enter)"; break;
+                }
+            DrawText(label.c_str(), p.x + 20, y, kFont, RAYWHITE);
+            DrawText(value.c_str(), p.x + 300, y, kFont, row == menu.selected ? YELLOW : Color{180, 220, 255, 255});
+        }
+        if (!menu.status.empty())
+            DrawText(menu.status.c_str(), p.x + p.w - 16 - MeasureText(menu.status.c_str(), 16), p.y + 16, 16, LIME);
+    }
+
+    // ---- cheat menu ----
+    // The game's bonus cheats (BONUS_CHEAT_01..12 in its text tables), in the order of its GetCheatByIndex
+    // (0x29FD88): one 32-bit flag each. The game reads them where they apply, so a flag set here works like the
+    // unlocked cheat switched on in the bonus menu.
+    struct Cheat
+    {
+        const char *name;
+        uint32_t address;
+    };
+    constexpr Cheat kCheats[] = {
+        {"All Replay Items", 0x3CBA24},
+        {"Unlimited Ammo", 0x3CB9F4},
+        {"Silver Bullet", 0x3CBA10},
+        {"Bullet Shield", 0x3CBA04},
+        {"Rubber Grenades", 0x3CBA0C},
+        {"Men With Hats", 0x3CBA08},
+        {"Always Sniper", 0x3CB9F8},
+        {"Achilles Head", 0x3CBA14},
+        {"Invisible Soldiers", 0x3CBA1C},
+        {"Perfectionist Mode", 0x3CBA18},
+        {"Immortality", 0x3CB9F0},
+        {"SlowMOH", 0x3CB9FC},
+    };
+    constexpr int kCheatCount = static_cast<int>(sizeof(kCheats) / sizeof(kCheats[0]));
+    constexpr const char *kCheatFile = "cheats.ini";
+
+    // Only for MOH: Rising Sun (SLUS-20753): its GetCheatByIndex error text sits at this address.
+    bool isRisingSun(const uint8_t *rdram)
+    {
+        static constexpr char kText[] = "Illegal index in GetCheatByIndex";
+        return rdram && std::memcmp(rdram + 0x3B5A58, kText, sizeof(kText) - 1) == 0;
+    }
+
+    struct CheatMenu
+    {
+        int selected = 0;
+        bool loaded = false;
+        bool on[kCheatCount] = {};
+        bool clear[kCheatCount] = {}; // switched off: write 0 once
+    };
+
+    void loadCheats(CheatMenu &menu)
+    {
+        menu.loaded = true;
+        std::ifstream file(kCheatFile);
+        for (std::string line; std::getline(file, line);)
+            for (int i = 0; i < kCheatCount; ++i)
+                if (line == std::string(kCheats[i].name) + " = 1")
+                    menu.on[i] = true;
+    }
+
+    void saveCheats(const CheatMenu &menu)
+    {
+        std::ofstream file(kCheatFile, std::ios::trunc);
+        file << "# Written by the cheat menu (F5)\n";
+        for (int i = 0; i < kCheatCount; ++i)
+            file << kCheats[i].name << " = " << (menu.on[i] ? 1 : 0) << "\n";
+    }
+
+    // Every frame: switched-on cheats are set again (the game resets the flags from its profile at level loads).
+    void applyCheats(CheatMenu &menu, uint8_t *rdram)
+    {
+        for (int i = 0; i < kCheatCount; ++i)
+            if (menu.on[i] || menu.clear[i])
+            {
+                const uint32_t value = menu.on[i] ? 1u : 0u;
+                std::memcpy(rdram + kCheats[i].address, &value, 4);
+                menu.clear[i] = false;
+            }
+    }
+
+    bool updateCheats(CheatMenu &menu, bool available)
+    {
+        if (IsKeyPressed(KEY_ESCAPE) || IsKeyPressed(KEY_F5))
+            return false;
+        if (!available)
+            return true;
+        if (pressed(KEY_DOWN))
+            menu.selected = (menu.selected + 1) % kCheatCount;
+        if (pressed(KEY_UP))
+            menu.selected = (menu.selected + kCheatCount - 1) % kCheatCount;
+        if (IsKeyPressed(KEY_ENTER) || IsKeyPressed(KEY_KP_ENTER) || IsKeyPressed(KEY_SPACE) || IsKeyPressed(KEY_LEFT) ||
+            IsKeyPressed(KEY_RIGHT))
+        {
+            menu.on[menu.selected] = !menu.on[menu.selected];
+            menu.clear[menu.selected] = !menu.on[menu.selected];
+            saveCheats(menu);
+        }
+        return true;
+    }
+
+    void drawCheats(const CheatMenu &menu, bool available)
+    {
+        const Panel p = drawPanel("Cheats", available ? kCheatCount + 1 : 2, "Up/Down: select   Enter/Space: on/off   Esc/F5: close");
+        if (!available)
+        {
+            DrawText("No cheats for this game (they are MOH: Rising Sun's).", p.x + 20, p.y + 48, kFont, RAYWHITE);
+            return;
+        }
+        const ListView v = scrollTo(p, kCheatCount, menu.selected);
+        for (int i = 0; i < v.visible && v.first + i < kCheatCount; ++i)
+        {
+            const int row = v.first + i;
+            const int y = p.y + 48 + i * kRowHeight;
+            if (row == menu.selected)
+                DrawRectangle(p.x + 8, y - 2, p.w - 16, kRowHeight, Color{90, 70, 30, 200});
+            DrawText(menu.on[row] ? "ON" : "off", p.x + 20, y, kFont, menu.on[row] ? LIME : GRAY);
+            DrawText(kCheats[row].name, p.x + 70, y, kFont, RAYWHITE);
+        }
+        DrawText("Some cheats only take effect when a level (re)loads.", p.x + 20, p.y + p.h - 50, 16, GRAY);
+    }
+
+    Menu g_menu = Menu::None;
+    bool g_waitRelease = false; // after closing: the game stays blocked until the closing key is let go
+    ControlsMenu g_controlsMenu;
+    CheatMenu g_cheatMenu;
+}
+
+void ps2MenusUpdateAndDraw(uint8_t *rdram)
+{
+    const bool risingSun = isRisingSun(rdram);
+    if (risingSun && !g_cheatMenu.loaded)
+        loadCheats(g_cheatMenu);
+    if (risingSun)
+        applyCheats(g_cheatMenu, rdram);
+
+    if (g_menu == Menu::None)
+    {
+        if (IsKeyPressed(KEY_F2))
+            g_menu = Menu::Controls;
+        else if (IsKeyPressed(KEY_F5))
+            g_menu = Menu::Cheats;
+        if (g_menu != Menu::None)
+        {
+            g_controlsMenu.capturing = false;
+            g_controlsMenu.status.clear();
+            ps2PadSetBlocked(true);
+            g_waitRelease = false;
+        }
+    }
+    else
+    {
+        const bool open = g_menu == Menu::Controls ? updateControls(g_controlsMenu) : updateCheats(g_cheatMenu, risingSun);
+        if (!open)
+        {
+            g_menu = Menu::None;
+            g_waitRelease = true;
+        }
+    }
+    if (g_waitRelease && !IsKeyDown(KEY_ESCAPE) && !IsKeyDown(KEY_ENTER) && !IsKeyDown(KEY_F2) && !IsKeyDown(KEY_F5))
+    {
+        g_waitRelease = false;
+        ps2PadSetBlocked(false);
+    }
+
+    if (g_menu == Menu::Controls)
+        drawControls(g_controlsMenu);
+    else if (g_menu == Menu::Cheats)
+        drawCheats(g_cheatMenu, risingSun);
+}
