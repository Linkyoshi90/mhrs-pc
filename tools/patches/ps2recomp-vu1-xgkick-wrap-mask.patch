+namespace
+{
+    // address % size without a divide for the power-of-two sizes VU data memory has (16 KB VU1, 4 KB VU0).
+    inline uint32_t wrapVuData(uint32_t address, uint32_t size)
+    {
+        return (size & (size - 1u)) == 0u ? address & (size - 1u) : address % size;
+    }
+}
