+GSCpuBackend::TexSampler GSCpuBackend::MakeTexSampler(const GSDrawState &state) const
+{
+    const auto &ctx = state.context;
+    TexSampler s;
+    s.state = &state;
+    s.texW = state.textureWidth;
+    s.texH = state.textureHeight;
+    s.wrapU = static_cast<uint8_t>(ctx.clamp & 0x3u);
+    s.wrapV = static_cast<uint8_t>((ctx.clamp >> 2) & 0x3u);
+    s.minU = static_cast<uint16_t>((ctx.clamp >> 4) & 0x3FFu);
+    s.maxU = static_cast<uint16_t>((ctx.clamp >> 14) & 0x3FFu);
+    s.minV = static_cast<uint16_t>((ctx.clamp >> 24) & 0x3FFu);
+    s.maxV = static_cast<uint16_t>((ctx.clamp >> 34) & 0x3FFu);
+    s.fst = state.prim.fst;
+    s.linear = state.linearFilter;
+    s.psm = ctx.tex0.psm;
+    s.tbp0 = ctx.tex0.tbp0;
+    s.tbw = ctx.tex0.tbw;
+    switch (s.psm)
+    {
+    case GS_PSM_CT32:
+    case GS_PSM_Z32:
+    case GS_PSM_CT24:
+    case GS_PSM_Z24:
+        s.kind = 1;
+        break;
+    case GS_PSM_CT16:
+    case GS_PSM_CT16S:
+    case GS_PSM_Z16:
+    case GS_PSM_Z16S:
+        s.kind = 2;
+        break;
+    case GS_PSM_T8:
+    case GS_PSM_T8H:
+    case GS_PSM_T4:
+    case GS_PSM_T4HL:
+    case GS_PSM_T4HH:
+        s.kind = 3;
+        break;
+    default:
+        s.kind = 0;
+        break;
+    }
+    s.clutId = t_bandRows ? t_bandRows->clutId : m_clutId;
+    return s;
+}
+
+GSCpuBackend::PaletteCache *GSCpuBackend::PaletteFor(const TexSampler &sampler) const
+{
+    if (sampler.kind != 3u)
+        return nullptr;
+    thread_local std::array<PaletteCache, 4> caches;
+    thread_local unsigned next = 0;
+    const auto &tex = sampler.state->context.tex0;
+    const GSTexaReg &texa = sampler.state->texa;
+    for (PaletteCache &c : caches)
+        if (c.clutId == sampler.clutId && c.cpsm == tex.cpsm && c.csm == tex.csm && c.csa == tex.csa && c.psm == tex.psm &&
+            c.texa.ta0 == texa.ta0 && c.texa.ta1 == texa.ta1 && c.texa.aem == texa.aem)
+            return &c;
+    PaletteCache &c = caches[next++ % caches.size()];
+    c.clutId = sampler.clutId;
+    c.cpsm = tex.cpsm;
+    c.csm = tex.csm;
+    c.csa = tex.csa;
+    c.psm = tex.psm;
+    c.texa = texa;
+    c.filled.fill(0u);
+    return &c;
+}
+
+// FetchTexel for a TexSampler: the same read through the cache, palette entries looked up once per thread.
+uint32_t GSCpuBackend::FetchTexelFast(GSMem::TexturePageCache &cache, const TexSampler &sampler, PaletteCache *palette, int u, int v)
+{
+    const uint32_t out = GSMem::ReadPixel(m_vram, sampler.psm, sampler.tbp0, sampler.tbw, static_cast<uint32_t>(u), static_cast<uint32_t>(v), &cache);
+    switch (sampler.kind)
+    {
+    case 1:
+        return applyTexa(sampler.state->texa, sampler.psm, out);
+    case 2:
+        return applyTexa(sampler.state->texa, sampler.psm, Rgba5551ToRgba8888(static_cast<u16>(out)));
+    case 3:
+    {
+        const uint8_t index = static_cast<uint8_t>(out);
+        uint64_t &word = palette->filled[index >> 6u];
+        const uint64_t bit = uint64_t{1} << (index & 63u);
+        if ((word & bit) == 0u)
+        {
+            const auto &tex = sampler.state->context.tex0;
+            palette->rgba[index] = LookupCLUT(*sampler.state, index, tex.cpsm, tex.csm, tex.csa, tex.psm);
+            word |= bit;
+        }
+        return palette->rgba[index];
+    }
+    default:
+        return 0xFFFF00FFu;
+    }
+}
+
+// SampleTexture with the primitive's constants from a TexSampler.
+uint32_t GSCpuBackend::SampleTextureFast(TexelSource &texels, const TexSampler &sampler, PaletteCache *palette, float s, float t, float q, uint16_t u, uint16_t v)
+{
+    const int texW = sampler.texW;
+    const int texH = sampler.texH;
+    float texUf, texVf;
+    if (sampler.fst)
+    {
+        texUf = static_cast<float>(u) / 16.0f;
+        texVf = static_cast<float>(v) / 16.0f;
+    }
+    else
+    {
+        const float invQ = 1.0f / fabsQ(q);
+        texUf = s * invQ * static_cast<float>(texW);
+        texVf = t * invQ * static_cast<float>(texH);
+    }
+
+    auto samplePoint = [&](int sampleU, int sampleV) -> uint32_t
+    {
+        sampleU = wrapTextureCoordinate(sampleU, texW, sampler.wrapU, sampler.minU, sampler.maxU);
+        sampleV = wrapTextureCoordinate(sampleV, texH, sampler.wrapV, sampler.minV, sampler.maxV);
+        if (texels.decoded)
+        {
+            texels.lastU = sampleU;
+            texels.lastV = sampleV;
+            return texels.decoded[static_cast<uint32_t>(sampleV) * texels.decodedWidth + static_cast<uint32_t>(sampleU)];
+        }
+        texels.read = true;
+        texels.pendingU = -1;
+        return FetchTexelFast(*texels.cache, sampler, palette, sampleU, sampleV);
+    };
+
+    if (!sampler.linear)
+        return samplePoint(static_cast<int>(texUf), static_cast<int>(texVf));
+
+    const float sampleU = texUf - 0.5f;
+    const float sampleV = texVf - 0.5f;
+    const int u0 = static_cast<int>(std::floor(sampleU));
+    const int v0 = static_cast<int>(std::floor(sampleV));
+    const float fx = sampleU - static_cast<float>(u0);
+    const float fy = sampleV - static_cast<float>(v0);
+
+    const uint32_t c00 = samplePoint(u0, v0);
+    const uint32_t c10 = samplePoint(u0 + 1, v0);
+    const uint32_t c01 = samplePoint(u0, v0 + 1);
+    const uint32_t c11 = samplePoint(u0 + 1, v0 + 1);
+    return lerpTexels(c00, c10, c01, c11, fx, fy);
+}
+
+// For a pixel that cannot write: note the last tap SampleTextureFast would take (with a fresh cache its taps
+// would only move the cache, and only its final page is observable).
+void GSCpuBackend::SkipTexels(TexelSource &texels, const TexSampler &sampler, float s, float t, float q, uint16_t u, uint16_t v)
+{
+    float texUf, texVf;
+    if (sampler.fst)
+    {
+        texUf = static_cast<float>(u) / 16.0f;
+        texVf = static_cast<float>(v) / 16.0f;
+    }
+    else
+    {
+        const float invQ = 1.0f / fabsQ(q);
+        texUf = s * invQ * static_cast<float>(sampler.texW);
+        texVf = t * invQ * static_cast<float>(sampler.texH);
+    }
+    int lastU, lastV;
+    if (!sampler.linear)
+    {
+        lastU = static_cast<int>(texUf);
+        lastV = static_cast<int>(texVf);
+    }
+    else
+    {
+        lastU = static_cast<int>(std::floor(texUf - 0.5f)) + 1;
+        lastV = static_cast<int>(std::floor(texVf - 0.5f)) + 1;
+    }
+    lastU = wrapTextureCoordinate(lastU, sampler.texW, sampler.wrapU, sampler.minU, sampler.maxU);
+    lastV = wrapTextureCoordinate(lastV, sampler.texH, sampler.wrapV, sampler.minV, sampler.maxV);
+    if (texels.decoded)
+    {
+        texels.lastU = lastU;
+        texels.lastV = lastV;
+        return;
+    }
+    texels.pendingU = lastU;
+    texels.pendingV = lastV;
+}
+
+// Takes a skipped last tap, so the cache ends on the page the skipped taps would have left it on.
+void GSCpuBackend::FinishTexels(TexelSource &texels, const GSDrawState &state)
+{
+    if (texels.pendingU < 0)
+        return;
+    const auto &tex = state.context.tex0;
+    ReadTextureVramUnlocked(*texels.cache, tex.psm, tex.tbp0, tex.tbw, texels.pendingU, texels.pendingV);
+    texels.read = true;
+    texels.pendingU = -1;
+}
