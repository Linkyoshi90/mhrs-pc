+GSCpuBackend::PixelPipe GSCpuBackend::MakePixelPipe(const GSDrawState &state) const
+{
+    const auto &ctx = state.context;
+    PixelPipe p;
+    p.sx0 = ctx.scissor.x0;
+    p.sx1 = ctx.scissor.x1;
+    p.sy0 = ctx.scissor.y0;
+    p.sy1 = ctx.scissor.y1;
+    p.fge = state.prim.fge;
+    p.fogR = state.fogR;
+    p.fogG = state.fogG;
+    p.fogB = state.fogB;
+    p.fbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+    p.fbw = std::max<u32>(ctx.frame.fbw, 1u);
+    p.fpsm = ctx.frame.psm;
+    p.zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+    p.zpsm = ctx.zbuf.psm;
+    p.test = ctx.test;
+    p.ztest = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+    p.abe = state.prim.abe;
+    p.pabe = state.pabe;
+    p.asel = ctx.alpha & 3;
+    p.bsel = (ctx.alpha >> 2) & 3;
+    p.csel = (ctx.alpha >> 4) & 3;
+    p.dsel = (ctx.alpha >> 6) & 3;
+    p.fix = static_cast<uint8_t>((ctx.alpha >> 32) & 0xFF);
+    p.fbaOn = (ctx.fba & 0x1ull) != 0ull && ctx.frame.psm != GS_PSM_CT24;
+    p.fbmsk = ctx.frame.fbmsk;
+    p.zmask = ctx.zbuf.zmask;
+    p.dateRead = ((ctx.test >> 14) & 0x1u) != 0u && (p.fpsm == GS_PSM_CT32 || p.fpsm == GS_PSM_CT16 || p.fpsm == GS_PSM_CT16S);
+    p.frame16 = bitsPerPixel(p.fpsm) == 16;
+    return p;
+}
+
+// WritePixel with the primitive's constants from a PixelPipe: the same tests, blend and stores.
+void GSCpuBackend::WritePixelFast(const PixelPipe &p, int x, int y, int z, uint8_t r, uint8_t g, uint8_t b, uint8_t a, uint8_t fog)
+{
+    if (x < p.sx0 || x > p.sx1 || y < p.sy0 || y > p.sy1)
+        return;
+
+    if (p.fge)
+    {
+        const uint32_t inverseFog = 255u - fog;
+        auto applyFog = [&](uint8_t input, uint8_t fogColor) -> uint8_t
+        {
+            return static_cast<uint8_t>(((static_cast<uint32_t>(fog) * input) >> 8) + ((inverseFog * fogColor) >> 8));
+        };
+        r = applyFog(r, p.fogR);
+        g = applyFog(g, p.fogG);
+        b = applyFog(b, p.fogB);
+    }
+
+    const PixelWriteMask writeMask = classifyAlphaTest(p.test, a, static_cast<uint8_t>(p.fpsm));
+    if (!writeMask.writesAnything())
+        return;
+
+    const bool preserveDestinationAlpha = writeMask.writeRgb && !writeMask.writeAlpha && p.fpsm == GS_PSM_CT32;
+    const bool frmw = p.dateRead || (writeMask.writesFramebuffer() && (p.fbmsk != 0 || p.abe || preserveDestinationAlpha));
+
+    u32 rawFramebufferPixel = 0;
+    u32 fbrgba = 0;
+    if (frmw)
+    {
+        rawFramebufferPixel = GSMem::ReadPixel(m_vram, p.fpsm, p.fbp, p.fbw, x, y);
+        fbrgba = rawFramebufferPixel;
+        if (p.frame16)
+            fbrgba = Rgba5551ToRgba8888(fbrgba);
+        else if (p.fpsm == GS_PSM_CT24)
+            fbrgba |= 0x80000000u; // the GS supplies 0x80 as destination alpha for RGB24 blending
+    }
+
+    if (!passesDestinationAlphaTest(p.test, static_cast<uint8_t>(p.fpsm), rawFramebufferPixel))
+        return;
+
+    bool zpass = false;
+    switch (p.ztest)
+    {
+    case 0:
+        zpass = false;
+        break;
+    case 1:
+        zpass = true;
+        break;
+    case 2:
+        zpass = static_cast<uint32_t>(z) >= GSMem::ReadPixel(m_vram, p.zpsm, p.zbp, p.fbw, x, y);
+        break;
+    case 3:
+        zpass = static_cast<uint32_t>(z) > GSMem::ReadPixel(m_vram, p.zpsm, p.zbp, p.fbw, x, y);
+        break;
+    }
+    if (!zpass)
+        return;
+
+    if (writeMask.writesFramebuffer())
+    {
+        if (p.abe)
+        {
+            const uint8_t dr = fbrgba & 0xFF;
+            const uint8_t dg = (fbrgba >> 8) & 0xFF;
+            const uint8_t db = (fbrgba >> 16) & 0xFF;
+            const uint8_t da = (fbrgba >> 24) & 0xFF;
+            // PABE disables alpha blending when the source alpha MSB is clear.
+            if (!(p.pabe && (a & 0x80u) == 0u))
+            {
+                auto pickRGB = [](uint8_t sel, int cs, int cd) -> int { return sel == 0 ? cs : sel == 1 ? cd : 0; };
+                const int cAlpha = (p.csel == 0) ? a : (p.csel == 1) ? da : p.fix;
+                r = clampU8(((pickRGB(p.asel, r, dr) - pickRGB(p.bsel, r, dr)) * cAlpha >> 7) + pickRGB(p.dsel, r, dr));
+                g = clampU8(((pickRGB(p.asel, g, dg) - pickRGB(p.bsel, g, dg)) * cAlpha >> 7) + pickRGB(p.dsel, g, dg));
+                b = clampU8(((pickRGB(p.asel, b, db) - pickRGB(p.bsel, b, db)) * cAlpha >> 7) + pickRGB(p.dsel, b, db));
+            }
+        }
+
+        if (writeMask.writeAlpha && p.fbaOn)
+            a = static_cast<uint8_t>(a | 0x80u);
+
+        u32 pixel = pack32(r, g, b, a);
+        if (p.fbmsk != 0)
+            pixel = (pixel & ~p.fbmsk) | (fbrgba & p.fbmsk);
+        if (preserveDestinationAlpha)
+            pixel = (pixel & 0x00FFFFFFu) | (fbrgba & 0xFF000000u);
+        if (p.frame16)
+            pixel = Rgba8888ToRgba5551(pixel);
+        GSMem::WritePixel(m_vram, p.fpsm, p.fbp, p.fbw, x, y, pixel);
+    }
+
+    if (writeMask.writeDepth && !p.zmask)
+        GSMem::WritePixel(m_vram, p.zpsm, p.zbp, p.fbw, x, y, z);
+}
