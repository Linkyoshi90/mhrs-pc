+                    continue;
+                }
+                t.Equals(causes.size(), static_cast<size_t>(1u), "I bit should raise one INTC cause");
+                if (!causes.empty())
+                    t.Equals(causes[0], 5u, "VIF1 interrupt is INTC cause 5");
+                t.IsTrue(mem.readIORegister(0x10003C30u) != 0x1234u, "VIF1 must stall before the next VIFcode");
+                t.Equals(mem.readIORegister(0x10003C80u), 0x80000000u, "VIF1_CODE should hold the I-bit VIFcode");
+
+                t.IsTrue(mem.writeIORegister(0x10003C10u, 0x8u), "FBRST.STC should succeed");
+                t.Equals(mem.readIORegister(0x10003C30u) & 0xFFFFu, 0x1234u, "STC should resume the stalled stream");
+                t.IsTrue((mem.readIORegister(0x10003C00u) & (1u << 11)) == 0u, "STC should clear STAT.INT");
+            }
+        });
