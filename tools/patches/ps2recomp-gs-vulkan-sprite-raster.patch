+uint readPixel(uint psm, uint base, uint bw, uint x, uint y)
+{
+    if (psm == PSM_CT32 || psm == PSM_CT24 || psm == PSM_Z32 || psm == PSM_Z24 ||
+        psm == PSM_T8H || psm == PSM_T4HL || psm == PSM_T4HH)
+    {
+        const uint page = (base >> 5u) + (y >> 5u) * bw + (x >> 6u);
+        const bool ztab = psm == PSM_Z32 || psm == PSM_Z24;
+        const uint block = (ztab ? BlockTableZ32 : BlockTableC32)[((y >> 3u) & 3u) * 8u + ((x >> 3u) & 7u)];
+        const uint column = ColumnTable32[(y & 7u) * 8u + (x & 7u)];
+        const uint pixel = page * 2048u + ((base & 31u) + block) * 64u + column;
+        const uint word = vram[pixel & WORD_MASK];
+        if (psm == PSM_CT24 || psm == PSM_Z24)
+            return word & 0x00FFFFFFu;
+        if (psm == PSM_T8H)
+            return (word >> 24u) & 0xFFu;
+        if (psm == PSM_T4HL)
+            return (word >> 24u) & 0x0Fu;
+        if (psm == PSM_T4HH)
+            return (word >> 28u) & 0x0Fu;
+        return word;
+    }
+    if (is16Family(psm))
+    {
+        const uint page = (base >> 5u) + (y >> 6u) * bw + (x >> 6u);
+        uint block;
+        if (psm == PSM_CT16)
+            block = BlockTableC16[((y >> 3u) & 7u) * 4u + ((x >> 4u) & 3u)];
+        else if (psm == PSM_CT16S)
+            block = BlockTableC16S[((y >> 3u) & 7u) * 4u + ((x >> 4u) & 3u)];
+        else if (psm == PSM_Z16)
+            block = BlockTableZ16[((y >> 3u) & 7u) * 4u + ((x >> 4u) & 3u)];
+        else
+            block = BlockTableZ16S[((y >> 3u) & 7u) * 4u + ((x >> 4u) & 3u)];
+        const uint column = ColumnTable16[(y & 7u) * 16u + (x & 15u)];
+        const uint pixel = page * 4096u + ((base & 31u) + block) * 128u + column;
+        return readVram16((pixel * 2u) & 0x3FFFFEu);
+    }
+    if (psm == PSM_T8)
+    {
+        // page 128x64, blocks 8x4 of 16x16, block table shared with C32
+        const uint page = (base >> 5u) + (y >> 6u) * ((bw * 64u) / 128u) + (x >> 7u);
+        const uint block = BlockTableC32[((y >> 4u) & 3u) * 8u + ((x >> 4u) & 7u)];
+        const uint column = ColumnTable8[(y & 15u) * 16u + (x & 15u)];
+        const uint pixel = page * 8192u + ((base & 31u) + block) * 256u + column;
+        return readVram8(pixel & 0x3FFFFFu);
+    }
+    if (psm == PSM_T4)
+    {
+        // page 128x128, blocks 4x8 of 32x16, block table shared with C16
+        const uint page = (base >> 5u) + (y >> 7u) * ((bw * 64u) / 128u) + (x >> 7u);
+        const uint block = BlockTableC16[((y >> 4u) & 7u) * 4u + ((x >> 5u) & 3u)];
+        const uint column = ColumnTable4[(y & 15u) * 32u + (x & 31u)];
+        const uint pixel = page * 16384u + ((base & 31u) + block) * 512u + column;
+        const uint bits = pixel * 4u;
+        return (readVram8((bits >> 3u) & 0x3FFFFFu) >> (bits & 7u)) & 0x0Fu;
+    }
+    return 0xFFFF00FFu;
+}
+
+// Swizzled write for frame/z formats (mirrors PixelStorageTraits<>::Write).
+void writePixel(uint psm, uint base, uint bw, uint x, uint y, uint value)
+{
+    if (psm == PSM_CT32 || psm == PSM_Z32)
+    {
+        const uint page = (base >> 5u) + (y >> 5u) * bw + (x >> 6u);
+        const uint block = (psm == PSM_Z32 ? BlockTableZ32 : BlockTableC32)[((y >> 3u) & 3u) * 8u + ((x >> 3u) & 7u)];
+        const uint column = ColumnTable32[(y & 7u) * 8u + (x & 7u)];
+        vram[(page * 2048u + ((base & 31u) + block) * 64u + column) & WORD_MASK] = value;
+        return;
+    }
+    if (psm == PSM_CT24 || psm == PSM_Z24)
+    {
+        const uint page = (base >> 5u) + (y >> 5u) * bw + (x >> 6u);
+        const uint block = (psm == PSM_Z24 ? BlockTableZ32 : BlockTableC32)[((y >> 3u) & 3u) * 8u + ((x >> 3u) & 7u)];
+        const uint column = ColumnTable32[(y & 7u) * 8u + (x & 7u)];
+        const uint addr = (page * 2048u + ((base & 31u) + block) * 64u + column) & WORD_MASK;
+        vram[addr] = (vram[addr] & 0xFF000000u) | (value & 0x00FFFFFFu);
+        return;
+    }
+    if (is16Family(psm))
+    {
+        const uint page = (base >> 5u) + (y >> 6u) * bw + (x >> 6u);
+        uint block;
+        if (psm == PSM_CT16)
+            block = BlockTableC16[((y >> 3u) & 7u) * 4u + ((x >> 4u) & 3u)];
+        else if (psm == PSM_CT16S)
+            block = BlockTableC16S[((y >> 3u) & 7u) * 4u + ((x >> 4u) & 3u)];
+        else if (psm == PSM_Z16)
+            block = BlockTableZ16[((y >> 3u) & 7u) * 4u + ((x >> 4u) & 3u)];
+        else
+            block = BlockTableZ16S[((y >> 3u) & 7u) * 4u + ((x >> 4u) & 3u)];
+        const uint column = ColumnTable16[(y & 7u) * 16u + (x & 15u)];
+        const uint pixel = page * 4096u + ((base & 31u) + block) * 128u + column;
+        writeVram16((pixel * 2u) & 0x3FFFFEu, value);
+        return;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Pixel pipeline helpers (ports of the gs_cpu_backend.cpp free functions)
+// ---------------------------------------------------------------------------
+
+int clampInt(int v, int lo, int hi)
+{
+    return v < lo ? lo : (v > hi ? hi : v);
+}
+
+uint clampU8(int v)
+{
+    return uint(clampInt(v, 0, 255));
+}
+
+uint rgba5551to8888(uint c)
+{
+    const uint r = (c & 0x1Fu) << 3u;
+    const uint g = ((c >> 5u) & 0x1Fu) << 3u;
+    const uint b = ((c >> 10u) & 0x1Fu) << 3u;
+    const uint a = ((c >> 15u) & 1u) << 7u;
+    return r | (g << 8u) | (b << 16u) | (a << 24u);
+}
+
+uint rgba8888to5551(uint c)
+{
+    const uint r = ((c >> 3u) & 0x1Fu);
+    const uint g = ((c >> 11u) & 0x1Fu);
+    const uint b = ((c >> 19u) & 0x1Fu);
+    const uint a = ((c >> 31u) & 1u);
+    return r | (g << 5u) | (b << 10u) | (a << 15u);
+}
+
+uint applyTexa(uint psm, uint texel)
+{
+    if (psm == PSM_CT32 || psm == PSM_Z32)
+        return texel;
+
+    const uint r = texel & 0xFFu;
+    const uint g = (texel >> 8u) & 0xFFu;
+    const uint b = (texel >> 16u) & 0xFFu;
+    const bool rgbZero = r == 0u && g == 0u && b == 0u;
+    uint a = (texel >> 24u) & 0xFFu;
+
+    if (psm == PSM_CT24 || psm == PSM_Z24)
+    {
+        a = (pr.aem != 0u && rgbZero) ? 0u : pr.ta0;
+    }
+    else // 16-bit formats
+    {
+        if ((a & 0x80u) != 0u)
+            a = pr.ta1;
+        else
+            a = (pr.aem != 0u && rgbZero) ? 0u : pr.ta0;
+    }
+    return (texel & 0x00FFFFFFu) | (a << 24u);
+}
+
+int wrapTextureCoordinate(int coordinate, int textureSize, uint mode, uint regionMin, uint regionMax)
+{
+    switch (mode & 3u)
+    {
+    case 0u: // REPEAT
+        return int(uint(coordinate) & uint(textureSize - 1));
+    case 1u: // CLAMP
+        return clampInt(coordinate, 0, textureSize - 1);
+    case 2u: // REGION_CLAMP
+        return min(max(coordinate, int(regionMin)), int(regionMax));
+    case 3u: // REGION_REPEAT
+        return int((uint(coordinate) & regionMin) | regionMax);
+    }
+    return coordinate;
+}
+
+uint lookupClut(uint index)
+{
+    const bool sixteenBit = pr.cpsm == PSM_CT16 || pr.cpsm == PSM_CT16S;
+    const uint csaMask = sixteenBit ? 0x1Fu : 0x0Fu;
+    const uint clutBase = (pr.csa & csaMask) << 4u;
+    const bool fourBit = pr.texPsm == PSM_T4 || pr.texPsm == PSM_T4HL || pr.texPsm == PSM_T4HH;
+    const uint sourceIndex = fourBit ? (index & 0x0Fu) : index;
+
+    uint clutIndex = (clutBase + sourceIndex) & (sixteenBit ? 0x1FFu : 0x0FFu);
+    if (!sixteenBit && pr.csm == 0u && (pr.texPsm == PSM_T8 || pr.texPsm == PSM_T8H))
+    {
+        const uint block = min((sourceIndex & 0xF0u) + clutBase, 240u);
+        clutIndex = block + (sourceIndex & 0x0Fu);
+    }
+
+    if (pr.cpsm == PSM_CT32)
+    {
+        const uint raw = clut[clutIndex] | (clut[clutIndex + 256u] << 16u);
+        return applyTexa(pr.cpsm, raw);
+    }
+    if (pr.cpsm == PSM_CT24)
+    {
+        const uint raw = clut[clutIndex] | (clut[clutIndex + 256u] << 16u);
+        return applyTexa(pr.cpsm, raw & 0x00FFFFFFu);
+    }
+    if (sixteenBit)
+        return applyTexa(pr.cpsm, rgba5551to8888(clut[clutIndex]));
+    return 0xFFFF00FFu;
+}
+
+uint fetchTexel(int u, int v)
+{
+    const uint raw = readPixel(pr.texPsm, pr.tbp0, pr.tbw, uint(u), uint(v));
+    if (pr.texPsm == PSM_CT32 || pr.texPsm == PSM_Z32 || pr.texPsm == PSM_CT24 || pr.texPsm == PSM_Z24)
+        return applyTexa(pr.texPsm, raw);
+    if (is16Family(pr.texPsm))
+        return applyTexa(pr.texPsm, rgba5551to8888(raw));
+    // indexed formats
+    return lookupClut(raw & 0xFFu);
+}
+
+uint lerpChannel(uint c00, uint c10, uint c01, uint c11, float fx, float fy)
+{
+    // Matches the CPU SSE path exactly: trunc toward zero, then round up when the
+    // fractional part reaches 0.5. `precise` blocks FMA contraction so the float
+    // ops round identically to _mm_mul_ps/_mm_add_ps.
+    precise const float top = float(c00) + (float(c10) - float(c00)) * fx;
+    precise const float bottom = float(c01) + (float(c11) - float(c01)) * fx;
+    precise const float v = top + (bottom - top) * fy;
+    float i = trunc(v);
+    const float frac = v - i;
+    if (frac >= 0.5)
+        i += 1.0;
+    if (frac <= -0.5)
+        i -= 1.0;
+    return clampU8(int(i));
+}
+
+uint lerpTexels(uint c00, uint c10, uint c01, uint c11, float fx, float fy)
+{
+    uint outv = 0u;
+    for (uint shift = 0u; shift < 32u; shift += 8u)
+    {
+        outv |= lerpChannel((c00 >> shift) & 0xFFu, (c10 >> shift) & 0xFFu,
+                            (c01 >> shift) & 0xFFu, (c11 >> shift) & 0xFFu, fx, fy) << shift;
+    }
+    return outv;
+}
+
+uint samplePoint(float texUf, float texVf, int su, int sv)
+{
+    const int sampleU = wrapTextureCoordinate(su, pr.texW, pr.wrapU, pr.minU, pr.maxU);
+    const int sampleV = wrapTextureCoordinate(sv, pr.texH, pr.wrapV, pr.minV, pr.maxV);
+    return fetchTexel(sampleU, sampleV);
+}
+
+uint sampleTexture(float s, float t, float q, uint u, uint v)
+{
+    precise float texUf, texVf;
+    if (pr.fst != 0u)
+    {
+        texUf = float(u) / 16.0;
+        texVf = float(v) / 16.0;
+    }
+    else
+    {
+        const float invQ = 1.0 / (abs(q) > 1.0e-8 ? q : 1.0);
+        texUf = s * invQ * float(pr.texW);
+        texVf = t * invQ * float(pr.texH);
+    }
+
+    if (pr.linear == 0u)
+        return samplePoint(texUf, texVf, int(texUf), int(texVf));
+
+    const float sampleU = texUf - 0.5;
+    const float sampleV = texVf - 0.5;
+    const int u0 = int(floor(sampleU));
+    const int v0 = int(floor(sampleV));
+    const float fx = sampleU - float(u0);
+    const float fy = sampleV - float(v0);
+    const uint c00 = samplePoint(texUf, texVf, u0, v0);
+    const uint c10 = samplePoint(texUf, texVf, u0 + 1, v0);
+    const uint c01 = samplePoint(texUf, texVf, u0, v0 + 1);
+    const uint c11 = samplePoint(texUf, texVf, u0 + 1, v0 + 1);
+    return lerpTexels(c00, c10, c01, c11, fx, fy);
+}
+
+// combineTexture from gs_cpu_backend.cpp
+void combineTexture(uint tr, uint tg, uint tb, uint ta,
+                    inout uint r, inout uint g, inout uint b, inout uint a)
+{
+    const bool textureHasAlpha = pr.tcc != 0u;
+    const uint vr = r, vg = g, vb = b, va = a;
+    r = tr; g = tg; b = tb; a = textureHasAlpha ? ta : va;
+    switch (pr.tfx)
+    {
+    case 0u: // MODULATE
+        r = clampU8(int(tr * vr) >> 7);
+        g = clampU8(int(tg * vg) >> 7);
+        b = clampU8(int(tb * vb) >> 7);
+        a = textureHasAlpha ? clampU8(int(ta * va) >> 7) : va;
+        break;
+    case 1u: // DECAL
+        break;
+    case 2u: // HIGHLIGHT
+        r = clampU8((int(tr * vr) >> 7) + int(va));
+        g = clampU8((int(tg * vg) >> 7) + int(va));
+        b = clampU8((int(tb * vb) >> 7) + int(va));
+        a = textureHasAlpha ? clampU8(int(ta + va)) : va;
+        break;
+    case 3u: // HIGHLIGHT2
+        r = clampU8((int(tr * vr) >> 7) + int(va));
+        g = clampU8((int(tg * vg) >> 7) + int(va));
+        b = clampU8((int(tb * vb) >> 7) + int(va));
+        a = textureHasAlpha ? ta : va;
+        break;
+    }
+}
+
+// passesAlphaTest
+bool passesAlphaTest(uint alpha)
+{
+    if ((pr.testLo & 1u) == 0u)
+        return true;
+    const uint atst = (pr.testLo >> 1u) & 7u;
+    const uint aref = (pr.testLo >> 4u) & 0xFFu;
+    switch (atst)
+    {
+    case 0u: return false;
+    case 1u: return true;
+    case 2u: return alpha < aref;
+    case 3u: return alpha <= aref;
+    case 4u: return alpha == aref;
+    case 5u: return alpha >= aref;
+    case 6u: return alpha > aref;
+    default: return alpha != aref;
+    }
+}
+
+bool passesDestinationAlphaTest(uint rawFramebufferPixel)
+{
+    const bool date = ((pr.testLo >> 14u) & 1u) != 0u;
+    if (!date)
+        return true;
+    const bool datm = ((pr.testLo >> 15u) & 1u) != 0u;
+    if (pr.fpsm == PSM_CT32)
+        return (((rawFramebufferPixel >> 31u) & 1u) != 0u) == datm;
+    if (pr.fpsm == PSM_CT16 || pr.fpsm == PSM_CT16S)
+        return (((rawFramebufferPixel >> 15u) & 1u) != 0u) == datm;
+    return true; // RGB24: no destination alpha, DATE always passes
+}
+
+// WritePixelFast from gs_cpu_backend.cpp
+void writePixelPipe(int x, int y, uint z, uint r, uint g, uint b, uint a, uint fog)
+{
+    if (x < pr.sx0 || x > pr.sx1 || y < pr.sy0 || y > pr.sy1)
+        return;
+
+    if (pr.fge != 0u)
+    {
+        const uint inverseFog = 255u - fog;
+        r = ((fog * r) >> 8u) + ((inverseFog * pr.fogR) >> 8u);
+        g = ((fog * g) >> 8u) + ((inverseFog * pr.fogG) >> 8u);
+        b = ((fog * b) >> 8u) + ((inverseFog * pr.fogB) >> 8u);
+    }
+
+    // classifyAlphaTest
+    bool writeRgb = true, writeAlpha = true, writeDepth = true;
+    if (!passesAlphaTest(a))
+    {
+        const uint afail = (pr.testLo >> 12u) & 3u;
+        if (afail == 1u) { writeDepth = false; }                     // FB_ONLY
+        else if (afail == 2u) { writeRgb = false; writeAlpha = false; } // ZB_ONLY
+        else if (afail == 3u)
+        {
+            // RGB_ONLY: only distinct for RGBA32; FB_ONLY otherwise
+            writeDepth = false;
+            if (pr.fpsm == PSM_CT32)
+                writeAlpha = false;
+        }
+        else { writeRgb = false; writeAlpha = false; writeDepth = false; } // KEEP
+    }
+    if (!((writeRgb || writeAlpha) || writeDepth))
+        return;
+
+    const bool preserveDestinationAlpha = writeRgb && !writeAlpha && pr.fpsm == PSM_CT32;
+    const bool dateRead = ((pr.testLo >> 14u) & 1u) != 0u &&
+                          (pr.fpsm == PSM_CT32 || pr.fpsm == PSM_CT16 || pr.fpsm == PSM_CT16S);
+    const bool frmw = dateRead || ((writeRgb || writeAlpha) && (pr.fbmsk != 0u || pr.abe != 0u || preserveDestinationAlpha));
+
+    uint rawFramebufferPixel = 0u;
+    uint fbrgba = 0u;
+    if (frmw)
+    {
+        rawFramebufferPixel = readPixel(pr.fpsm, pr.fbp, pr.fbw, uint(x), uint(y));
+        fbrgba = rawFramebufferPixel;
+        if (pr.frame16 != 0u)
+            fbrgba = rgba5551to8888(fbrgba);
+        else if (pr.fpsm == PSM_CT24)
+            fbrgba |= 0x80000000u; // the GS supplies 0x80 as destination alpha for RGB24 blending
+    }
+
+    if (!passesDestinationAlphaTest(rawFramebufferPixel))
+        return;
+
+    bool zpass = false;
+    const uint ztest = (pr.testLo >> 17u) & 3u;
+    if (ztest == 1u)
+        zpass = true;
+    else if (ztest == 2u)
+        zpass = z >= readPixel(pr.zpsm, pr.zbp, pr.fbw, uint(x), uint(y));
+    else if (ztest == 3u)
+        zpass = z > readPixel(pr.zpsm, pr.zbp, pr.fbw, uint(x), uint(y));
+    if (!zpass)
+        return;
+
+    if (writeRgb || writeAlpha)
+    {
+        if (pr.abe != 0u)
+        {
+            const uint dr = fbrgba & 0xFFu;
+            const uint dg = (fbrgba >> 8u) & 0xFFu;
+            const uint db = (fbrgba >> 16u) & 0xFFu;
+            const uint da = (fbrgba >> 24u) & 0xFFu;
+            // PABE disables alpha blending when the source alpha MSB is clear.
+            if (!(pr.pabe != 0u && (a & 0x80u) == 0u))
+            {
+                const int cAlpha = pr.csel == 0u ? int(a) : (pr.csel == 1u ? int(da) : int(pr.fixv));
+                const int sr = int(r), sg = int(g), sb = int(b);
+                const int idr = int(dr), idg = int(dg), idb = int(db);
+                const int ar = pr.asel == 0u ? sr : (pr.asel == 1u ? idr : 0);
+                const int br_ = pr.bsel == 0u ? sr : (pr.bsel == 1u ? idr : 0);
+                const int drr = pr.dsel == 0u ? sr : (pr.dsel == 1u ? idr : 0);
+                const int ag = pr.asel == 0u ? sg : (pr.asel == 1u ? idg : 0);
+                const int bg = pr.bsel == 0u ? sg : (pr.bsel == 1u ? idg : 0);
+                const int dg2 = pr.dsel == 0u ? sg : (pr.dsel == 1u ? idg : 0);
+                const int ab = pr.asel == 0u ? sb : (pr.asel == 1u ? idb : 0);
+                const int bb = pr.bsel == 0u ? sb : (pr.bsel == 1u ? idb : 0);
+                const int db2 = pr.dsel == 0u ? sb : (pr.dsel == 1u ? idb : 0);
+                r = clampU8(((ar - br_) * cAlpha >> 7) + drr);
+                g = clampU8(((ag - bg) * cAlpha >> 7) + dg2);
+                b = clampU8(((ab - bb) * cAlpha >> 7) + db2);
+            }
+        }
+
+        if (writeAlpha && pr.fbaOn != 0u)
+            a |= 0x80u;
+
+        uint pixel = r | (g << 8u) | (b << 16u) | (a << 24u);
+        if (pr.fbmsk != 0u)
+            pixel = (pixel & ~pr.fbmsk) | (fbrgba & pr.fbmsk);
+        if (preserveDestinationAlpha)
+            pixel = (pixel & 0x00FFFFFFu) | (fbrgba & 0xFF000000u);
+        if (pr.frame16 != 0u)
+            pixel = rgba8888to5551(pixel);
+        writePixel(pr.fpsm, pr.fbp, pr.fbw, uint(x), uint(y), pixel);
+    }
+
+    if (writeDepth && pr.zmask == 0u)
+        writePixel(pr.zpsm, pr.zbp, pr.fbw, uint(x), uint(y), z);
+}
+
+void main()
+{
+    const int x = pr.drawX0 + int(gl_GlobalInvocationID.x);
+    const int y = pr.drawY0 + int(gl_GlobalInvocationID.y);
+    if (x > pr.drawX1 || y > pr.drawY1)
+        return;
+
+    uint r = pr.vertR, g = pr.vertG, b = pr.vertB, a = pr.vertA;
+
+    if (pr.tme != 0u)
+    {
+        // precise: no FMA contraction — must round like the CPU's scalar float ops
+        precise const float ty = (float(y - pr.unclippedY0) + 0.5) / pr.spriteH;
+        precise const float tx = (float(x - pr.unclippedX0) + 0.5) / pr.spriteW;
+        precise const float texVf = pr.v0f + (pr.v1f - pr.v0f) * ty;
+        precise const float texUf = pr.u0f + (pr.u1f - pr.u0f) * tx;
+
+        uint texel;
+        if (pr.fst != 0u)
+        {
+            // precise: texUf * 16 + 0.5 must not fuse into an FMA (CPU rounds as two ops)
+            precise const float fixedUf = texUf * 16.0 + 0.5;
+            precise const float fixedVf = texVf * 16.0 + 0.5;
+            const int fixedU = int(fixedUf);
+            const int fixedV = int(fixedVf);
+            const uint sampleU = uint(clampInt(fixedU, 0, 65535));
+            const uint sampleV = uint(clampInt(fixedV, 0, 65535));
+            texel = sampleTexture(0.0, 0.0, 1.0, sampleU, sampleV);
+        }
+        else
+        {
+            texel = sampleTexture(texUf / float(pr.texW), texVf / float(pr.texH), 1.0, 0u, 0u);
+        }
+
+        const uint tr = texel & 0xFFu;
+        const uint tg = (texel >> 8u) & 0xFFu;
