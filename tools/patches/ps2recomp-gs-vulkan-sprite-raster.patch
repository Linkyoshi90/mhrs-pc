+namespace
+{
+    // Matches the std430 Params block in raster_sprite.comp exactly (all 4-byte fields).
+    struct SpriteParams
+    {
+        int32_t drawX0, drawY0, drawX1, drawY1;
+        int32_t unclippedX0, unclippedY0;
+        float spriteW, spriteH;
+        float u0f, v0f, u1f, v1f;
+        uint32_t vertR, vertG, vertB, vertA;
+        uint32_t vertFog, z1;
+        int32_t sx0, sx1, sy0, sy1;
+        uint32_t fge, fogR, fogG, fogB;
+        uint32_t fbp, fbw, fpsm, zbp, zpsm;
+        uint32_t testLo, testHi;
+        uint32_t abe, pabe;
+        uint32_t asel, bsel, csel, dsel, fixv;
+        uint32_t fbaOn, fbmsk, zmask, frame16;
+        uint32_t tme, fst, linear;
+        int32_t texW, texH;
+        uint32_t wrapU, wrapV, minU, maxU, minV, maxV;
+        uint32_t texPsm, tbp0, tbw;
+        uint32_t tcc, tfx;
+        uint32_t ta0, ta1, aem;
+        uint32_t cpsm, csm, csa;
+    };
+    static_assert(sizeof(SpriteParams) <= 1024u);
+
+    float spriteFabsQ(float q)
+    {
+        return (std::fabs(q) > 1.0e-8f) ? q : 1.0f;
+    }
+}
+
+void GSVulkanBackend::submitSpriteGpu(const GSPrimitiveBatch &batch)
+{
+    std::lock_guard<std::mutex> gpuLock(m_gpuMutex);
+    VkState &vk = *m_vk;
+    const GSDrawState &state = batch.state;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const GSContext &ctx = state.context;
+
+    // DrawSprite's rectangle setup with identical rounding.
+    const int ofx = ctx.xyoffset.ofx >> 4;
+    const int ofy = ctx.xyoffset.ofy >> 4;
+    int x0 = static_cast<int>(v0.x) - ofx;
+    int y0 = static_cast<int>(v0.y) - ofy;
+    int x1 = static_cast<int>(v1.x) - ofx;
+    int y1 = static_cast<int>(v1.y) - ofy;
+    if (x0 > x1)
+        std::swap(x0, x1);
+    if (y0 > y1)
+        std::swap(y0, y1);
+    const int unclippedX0 = x0;
+    const int unclippedY0 = y0;
+    const int spanX = std::max(1, x1 - x0);
+    const int spanY = std::max(1, y1 - y0);
+    const int unclippedX1 = unclippedX0 + spanX - 1;
+    const int unclippedY1 = unclippedY0 + spanY - 1;
+    if (unclippedX1 < ctx.scissor.x0 || unclippedX0 > ctx.scissor.x1 ||
+        unclippedY1 < ctx.scissor.y0 || unclippedY0 > ctx.scissor.y1)
+        return; // fully clipped: draws nothing, same as DrawSprite
+
+    SpriteParams p{};
+    p.drawX0 = GSInternal::clampInt(unclippedX0, ctx.scissor.x0, ctx.scissor.x1);
+    p.drawY0 = GSInternal::clampInt(unclippedY0, ctx.scissor.y0, ctx.scissor.y1);
+    p.drawX1 = GSInternal::clampInt(unclippedX1, ctx.scissor.x0, ctx.scissor.x1);
+    p.drawY1 = GSInternal::clampInt(unclippedY1, ctx.scissor.y0, ctx.scissor.y1);
+    p.unclippedX0 = unclippedX0;
+    p.unclippedY0 = unclippedY0;
+    p.spriteW = std::max(1.0f, static_cast<float>(spanX));
+    p.spriteH = std::max(1.0f, static_cast<float>(spanY));
+
+    const int texW = state.textureWidth;
+    const int texH = state.textureHeight;
+    if (state.prim.fst)
+    {
+        p.u0f = static_cast<float>(v0.u >> 4);
+        p.v0f = static_cast<float>(v0.v >> 4);
+        p.u1f = static_cast<float>(v1.u >> 4);
+        p.v1f = static_cast<float>(v1.v >> 4);
+    }
+    else
+    {
+        const float q0 = spriteFabsQ(v0.q);
+        const float q1 = spriteFabsQ(v1.q);
+        p.u0f = (v0.s / q0) * static_cast<float>(texW);
+        p.v0f = (v0.t / q0) * static_cast<float>(texH);
+        p.u1f = (v1.s / q1) * static_cast<float>(texW);
+        p.v1f = (v1.t / q1) * static_cast<float>(texH);
+    }
+
+    p.vertR = v1.r;
+    p.vertG = v1.g;
+    p.vertB = v1.b;
+    p.vertA = v1.a;
+    p.vertFog = v1.fog;
+    p.z1 = static_cast<uint32_t>(v1.z);
+
+    // MakePixelPipe equivalents.
+    p.sx0 = ctx.scissor.x0;
+    p.sx1 = ctx.scissor.x1;
+    p.sy0 = ctx.scissor.y0;
+    p.sy1 = ctx.scissor.y1;
+    p.fge = state.prim.fge ? 1u : 0u;
+    p.fogR = state.fogR;
+    p.fogG = state.fogG;
+    p.fogB = state.fogB;
+    p.fbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+    p.fbw = std::max(ctx.frame.fbw, 1u);
+    p.fpsm = ctx.frame.psm;
+    p.zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+    p.zpsm = ctx.zbuf.psm;
+    p.testLo = static_cast<uint32_t>(ctx.test);
+    p.testHi = static_cast<uint32_t>(ctx.test >> 32);
+    p.abe = state.prim.abe ? 1u : 0u;
+    p.pabe = state.pabe ? 1u : 0u;
+    p.asel = ctx.alpha & 3u;
+    p.bsel = (ctx.alpha >> 2u) & 3u;
+    p.csel = (ctx.alpha >> 4u) & 3u;
+    p.dsel = (ctx.alpha >> 6u) & 3u;
+    p.fixv = static_cast<uint32_t>((ctx.alpha >> 32u) & 0xFFu);
+    p.fbaOn = ((ctx.fba & 0x1ull) != 0ull && ctx.frame.psm != GS_PSM_CT24) ? 1u : 0u;
+    p.fbmsk = ctx.frame.fbmsk;
+    p.zmask = ctx.zbuf.zmask ? 1u : 0u;
+    p.frame16 = GSInternal::bitsPerPixel(ctx.frame.psm) == 16u ? 1u : 0u;
+
+    // MakeTexSampler + combine state.
+    p.tme = state.prim.tme ? 1u : 0u;
+    p.fst = state.prim.fst ? 1u : 0u;
+    p.linear = state.linearFilter ? 1u : 0u;
+    p.texW = texW;
+    p.texH = texH;
+    p.wrapU = static_cast<uint32_t>(ctx.clamp & 0x3u);
+    p.wrapV = static_cast<uint32_t>((ctx.clamp >> 2u) & 0x3u);
+    p.minU = static_cast<uint32_t>((ctx.clamp >> 4u) & 0x3FFu);
+    p.maxU = static_cast<uint32_t>((ctx.clamp >> 14u) & 0x3FFu);
+    p.minV = static_cast<uint32_t>((ctx.clamp >> 24u) & 0x3FFu);
+    p.maxV = static_cast<uint32_t>((ctx.clamp >> 34u) & 0x3FFu);
+    p.texPsm = ctx.tex0.psm;
+    p.tbp0 = ctx.tex0.tbp0;
+    p.tbw = ctx.tex0.tbw;
+    p.tcc = ctx.tex0.tcc;
+    p.tfx = ctx.tex0.tfx;
+    p.ta0 = state.texa.ta0;
+    p.ta1 = state.texa.ta1;
+    p.aem = state.texa.aem ? 1u : 0u;
+    p.cpsm = ctx.tex0.cpsm;
+    p.csm = ctx.tex0.csm;
+    p.csa = ctx.tex0.csa;
+
+    // Mirror the current CLUT (widened u16 -> u32) for the indexed fetch path.
+    uint32_t *clutDst = static_cast<uint32_t *>(vk.clutMapped);
+    const auto &clut = m_cpu.clutEntries();
+    for (size_t i = 0; i < clut.size(); ++i)
+        clutDst[i] = clut[i];
+
+    std::vector<uint8_t> before;
+    if (m_rasterVerify)
+    {
+        before.resize(static_cast<size_t>(vk.vramBufferSize));
+        std::memcpy(before.data(), vk.vramMapped, before.size());
+    }
+
+    std::memcpy(vk.paramsMapped, &p, sizeof(p));
+
+    vkResetFences(vk.device, 1, &vk.fence);
+    vkResetCommandBuffer(vk.commandBuffer, 0);
+    VkCommandBufferBeginInfo beginInfo{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    beginInfo.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    if (vkBeginCommandBuffer(vk.commandBuffer, &beginInfo) != VK_SUCCESS)
+    {
+        m_cpu.Submit(batch);
+        return;
+    }
+    vkCmdBindPipeline(vk.commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, vk.rasterPipeline);
+    vkCmdBindDescriptorSets(vk.commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, vk.pipelineLayout, 0, 1, &vk.descriptorSet, 0, nullptr);
+    vkCmdDispatch(vk.commandBuffer,
+                  static_cast<uint32_t>((p.drawX1 - p.drawX0) / 8 + 1),
+                  static_cast<uint32_t>((p.drawY1 - p.drawY0) / 8 + 1),
+                  1);
+    vkEndCommandBuffer(vk.commandBuffer);
+
+    VkSubmitInfo submitInfo{VK_STRUCTURE_TYPE_SUBMIT_INFO};
