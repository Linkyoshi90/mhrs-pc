+    // A block (generated: block<words, pc>) runs a run of plain pairs (no branch or delay slot, no E/D/T bit,
+    // no FDIV/EFU/XGKICK whose stalls depend on those units) on timing worked out here, at compile time: each
+    // pair's stall and which lanes it writes still have a write in flight. That holds when, as the run starts,
+    // no register it touches has a write landing after the run first touches it, nothing is pending from a
+    // branch or E bit, no stopped run left deferred writes, and the run ends before the budget does: the entry
+    // check. Otherwise the run's pairs step as usual. Either way every pair leaves the interpreter's state.
+    struct RegisterCheck
+    {
+        uint8_t slot;    // VF: reg * 4 (all four lanes), VI: kViSlot + reg
+        bool vf;
+        uint16_t offset; // cycles after the run starts when it first reads or writes the register
+    };
+
+    template <size_t N>
+    struct BlockPlan
+    {
+        std::array<StaticPairTiming, N> timing{};
+        std::array<uint16_t, N> runEnd{};    // at a run's first pair: the index after its last one (else 0)
+        std::array<uint16_t, N> lastIssue{}; // at a run's first pair: when its last pair issues
+        std::array<uint16_t, N> checkBegin{};
+        std::array<uint16_t, N> checkCount{};
+        std::array<RegisterCheck, N * 8u + 48u> checks{};
+    };
+
+    static constexpr bool isPlain(const DecodedInstructionPair &pair)
+    {
+        const InstructionUsage &lower = pair.lowerUsage;
+        return !pair.upperUsage.reserved && !lower.reserved && !pair.eBit && !pair.dBit && !pair.tBit &&
+               lower.pipeline != PipelineBranch && lower.pipeline != PipelineFdiv && lower.pipeline != PipelineEfu &&
+               lower.pipeline != PipelineXgkick && !lower.waitQ && !lower.waitP;
+    }
+
+    template <size_t N>
+    static constexpr BlockPlan<N> planBlock(const uint32_t (&words)[N * 2u], uint32_t pc)
+    {
+        BlockPlan<N> plan{};
+        std::array<DecodedInstructionPair, N> pairs{};
+        for (size_t i = 0; i < N; ++i)
+            pairs[i] = decodePair(words[2u * i], words[2u * i + 1u], Unit::VU1);
+        size_t checkTotal = 0;
+        for (size_t start = 0; start < N;)
+        {
+            const auto plainAt = [&](size_t i)
+            {
+                return isPlain(pairs[i]) && !(i > 0 && (pairs[i - 1].lowerUsage.pipeline == PipelineBranch || pairs[i - 1].eBit));
+            };
+            if (!plainAt(start))
+            {
+                ++start;
+                continue;
+            }
+            // The interpreter's schedule from the run's start: ready[slot] = when a write in the run lands (m_ready
+            // relative to the start), -1 for registers no pair of the run wrote yet (the entry check covers them).
+            std::array<int32_t, kViSlot + 16u> ready{};
+            ready.fill(-1);
+            std::array<int32_t, 48> firstTouch{}; // VF 0..31, VI 32..47
+            firstTouch.fill(-1);
+            int32_t t = 0, issue = 0;
+            size_t end = start;
+            for (; end < N && plainAt(end); ++end)
+            {
+                const DecodedInstructionPair &pair = pairs[end];
+                int32_t at = t;
+                for (uint32_t r = 0; r < pair.readSlotCount; ++r)
+                    at = std::max(at, ready[pair.readSlots[r]]);
+                if (at - t > 255)
+                    break;
+                issue = at;
+                const auto touch = [&](uint32_t slot)
+                {
+                    const uint32_t reg = slot < kViSlot ? slot / 4u : 32u + (slot - kViSlot);
+                    if (firstTouch[reg] < 0)
+                        firstTouch[reg] = issue;
+                };
+                for (uint32_t r = 0; r < pair.readSlotCount; ++r)
+                    touch(pair.readSlots[r]);
+                for (uint32_t w = 0; w < pair.writeSlotCount; ++w)
+                    touch(pair.writeSlots[w]);
+
+                const auto pendingLanes = [&](uint8_t reg)
+                {
+                    uint8_t lanes = 0u;
+                    for (uint32_t component = 0; component < 4u; ++component)
+                        if (ready[reg * 4u + component] > issue)
+                            lanes |= laneForComponent(component);
+                    return lanes;
+                };
+                StaticPairTiming &timing = plan.timing[end];
+                timing.known = true;
+                timing.stall = static_cast<uint8_t>(issue - t);
+                timing.upperPending = pendingLanes(pair.upperUsage.vfWrite.reg);
+                timing.lowerPending = pendingLanes(pair.lowerUsage.vfWrite.reg);
+                if (const uint32_t viWrites = pair.lowerUsage.viWrite & 0xFFFEu; viWrites != 0u)
+                    timing.viPending = ready[kViSlot + std::countr_zero(viWrites)] > issue;
+
+                for (uint32_t w = 0; w < pair.writeSlotCount; ++w)
+                    ready[pair.writeSlots[w]] = issue + pair.writeLatency[w];
+                t = issue + 1;
+            }
+            if (end == start)
+            {
+                ++start;
+                continue;
+            }
+            plan.runEnd[start] = static_cast<uint16_t>(end);
+            plan.lastIssue[start] = static_cast<uint16_t>(issue);
+            plan.checkBegin[start] = static_cast<uint16_t>(checkTotal);
+            for (uint32_t reg = 1; reg < 48u; ++reg) // VF0/VI0 are never written
+            {
+                if (reg == 32u || firstTouch[reg] < 0)
+                    continue;
+                plan.checks[checkTotal++] = reg < 32u ? RegisterCheck{static_cast<uint8_t>(reg * 4u), true, static_cast<uint16_t>(firstTouch[reg])}
+                                                      : RegisterCheck{static_cast<uint8_t>(kViSlot + reg - 32u), false, static_cast<uint16_t>(firstTouch[reg])};
+            }
+            plan.checkCount[start] = static_cast<uint16_t>(checkTotal - plan.checkBegin[start]);
+            start = end;
+        }
+        return plan;
+    }
+
+    template <const auto &Words, uint32_t Pc>
+    struct BlockInfo
+    {
+        static constexpr size_t N = std::size(Words) / 2u;
+        static constexpr BlockPlan<N> plan = planBlock<N>(Words, Pc);
+    };
+
+    template <uint32_t Lower, uint32_t Upper, StaticPairTiming kTiming>
+    static VU1_NOINLINE VU1_NO_STACK_PROTECTOR void plainPair(VU1Interpreter &vu)
+    {
+        static constexpr DecodedInstructionPair kPair = decodePair(Lower, Upper, Unit::VU1);
+        vu.stepPair<true, kTiming>(kPair, kCompiledCodeSize, 0u);
+    }
+
+    template <const auto &Words, uint32_t Pc, size_t I, size_t... C>
+    static VU1_ALWAYS_INLINE bool runReady(VU1Interpreter &vu, uint64_t budgetEnd, std::index_sequence<C...>)
+    {
+        constexpr const BlockPlan<BlockInfo<Words, Pc>::N> &plan = BlockInfo<Words, Pc>::plan;
+        const uint64_t start = vu.m_cycle;
+        if (start + plan.lastIssue[I] >= budgetEnd || vu.m_stopRequested || vu.m_state.branchPending ||
+            vu.m_state.haltAfterDelaySlot || vu.m_state.ebit || (vu.m_vfWriteMask | vu.m_viWriteMask) != 0u)
+            return false;
+        const auto settled = [&](const RegisterCheck &check) VU1_LAMBDA_ALWAYS_INLINE
+        {
+            const uint64_t bound = start + check.offset;
+            if (!check.vf)
+                return vu.m_ready[check.slot] <= bound;
+            return std::max(std::max(vu.m_ready[check.slot], vu.m_ready[check.slot + 1u]),
+                            std::max(vu.m_ready[check.slot + 2u], vu.m_ready[check.slot + 3u])) <= bound;
+        };
+        return (settled(plan.checks[plan.checkBegin[I] + C]) && ...);
+    }
+
+    // A plain pair of a run that passed its entry check; false if the run must stop after it.
+    template <const auto &Words, uint32_t Pc, size_t I>
+    static VU1_ALWAYS_INLINE bool plainStep(VU1Interpreter &vu)
+    {
+        plainPair<Words[2u * I], Words[2u * I + 1u], BlockInfo<Words, Pc>::plan.timing[I]>(vu);
+        vu.m_state.pc = (Pc + 8u * static_cast<uint32_t>(I + 1u)) % kCompiledCodeSize;
+        return !vu.m_stopRequested; // the next pair would not start
+    }
+
+    template <const auto &Words, uint32_t Pc, size_t I, size_t... K>
+    static VU1_ALWAYS_INLINE bool runPlain(VU1Interpreter &vu, std::index_sequence<K...>)
+    {
+        return (plainStep<Words, Pc, I + K>(vu) && ...);
+    }
+
+    // Pair I of a block; pairs before fastUntil already ran in a plain run.
+    template <const auto &Words, uint32_t Pc, size_t I>
+    static VU1_ALWAYS_INLINE int blockPair(VU1Interpreter &vu, uint64_t budgetEnd, size_t &fastUntil)
+    {
+        using Info = BlockInfo<Words, Pc>;
+        if (I < fastUntil)
+            return kNext;
+        if constexpr (Info::plan.runEnd[I] != 0u)
+        {
+            constexpr size_t End = Info::plan.runEnd[I];
+            if (runReady<Words, Pc, I>(vu, budgetEnd, std::make_index_sequence<Info::plan.checkCount[I]>{}))
+            {
+                fastUntil = End;
+                return runPlain<Words, Pc, I>(vu, std::make_index_sequence<End - I>{}) ? kNext : kLeave;
+            }
+        }
+        return step<Words[2u * I], Words[2u * I + 1u]>(vu, budgetEnd, (Pc + 8u * static_cast<uint32_t>(I + 1u)) % kCompiledCodeSize);
+    }
+
+    template <const auto &Words, uint32_t Pc, size_t... I>
+    static VU1_ALWAYS_INLINE int runBlock(VU1Interpreter &vu, uint64_t budgetEnd, std::index_sequence<I...>)
+    {
+        size_t fastUntil = 0;
+        int exit = kNext;
+        (((exit = blockPair<Words, Pc, I>(vu, budgetEnd, fastUntil)) == kNext) && ...);
+        return exit == kNext ? kLeave : exit;
+    }
+
+    // A whole block: Words are its pairs' lower/upper words (a constexpr array), Pc where it starts.
+    template <const auto &Words, uint32_t Pc>
+    static int block(VU1Interpreter &vu, uint64_t budgetEnd)
+    {
+        return runBlock<Words, Pc>(vu, budgetEnd, std::make_index_sequence<BlockInfo<Words, Pc>::N>{});
+    }
 };
 
