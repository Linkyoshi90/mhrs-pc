+    // Like MOH: Rising Sun when its movie queue is empty: feed a sequence end code from the callback.
+    void testMpegNodataCallback(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        gMpegNodataCalls.fetch_add(1u, std::memory_order_acq_rel);
+        const uint8_t endCode[] = {0x00u, 0x00u, 0x01u, 0xB7u};
+        std::memcpy(rdram + kMpegNodataEndCode, endCode, sizeof(endCode));
