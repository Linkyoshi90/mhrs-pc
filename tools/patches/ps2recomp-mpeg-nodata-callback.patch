+        // libmpeg calls the sceMpegCbNodata callback from inside sceMpegGetPicture, on the calling thread,
+        // whenever the decoder runs dry; games that feed sceMpegAddBs only from it would otherwise wait forever.
+        // Runs it as a nested call on the current thread (GetThreadId-based locks in it must see the caller),
+        // then re-enters GetPicture. Returns only when no such callback is registered.
+        void invokeNodataCallback(uint8_t *rdram, R5900Context *callerCtx, PS2Runtime *runtime, uint32_t mpegAddr)
+        {
+            constexpr uint32_t kMpegCbNodata = 1u;
+            MpegRegisteredCallback nodata{};
+            {
+                std::lock_guard<std::mutex> lock(g_mpeg_stub_mutex);
+                const auto it = g_mpeg_stub_state.callbacksByMpeg.find(mpegAddr);
+                if (it == g_mpeg_stub_state.callbacksByMpeg.end())
+                    return;
+                for (const MpegRegisteredCallback &callback : it->second)
+                    if (!callback.stream && callback.type == kMpegCbNodata)
+                        nodata = callback;
+            }
+            if (!rdram || !callerCtx || !runtime || nodata.func == 0u || !runtime->hasFunction(nodata.func))
+                return;
+
+            const uint32_t cbDataAddr = runtime->guestMalloc(kMpegCallbackDataSize, 16u);
+            MpegStreamCallbackEvent event{};
+            event.streamType = kMpegCbNodata; // sceMpegCbData.type
+            if (cbDataAddr == 0u || !writeMpegCallbackData(rdram, cbDataAddr, event))
+            {
+                if (cbDataAddr != 0u)
+                    runtime->guestFree(cbDataAddr);
+                return;
+            }
+
+            R5900Context callbackCtx = *callerCtx;
+            SET_GPR_U32(&callbackCtx, 4, mpegAddr);
+            SET_GPR_U32(&callbackCtx, 5, cbDataAddr);
+            SET_GPR_U32(&callbackCtx, 6, nodata.data);
+            SET_GPR_U32(&callbackCtx, 7, 0u);
+            SET_GPR_U32(&callbackCtx, 29, 0u);
+            SET_GPR_U32(&callbackCtx, 31, 0u);
+            callbackCtx.pc = nodata.func;
+
+            GuestInvocation invocation{};
+            invocation.kind = GuestInvocationKind::HleCall;
+            invocation.context = callbackCtx;
+            invocation.onComplete = [rdram, runtime, cbDataAddr](const R5900Context &, R5900Context &parent)
+            {
+                runtime->guestFree(cbDataAddr);
+                sceMpegGetPicture(rdram, &parent, runtime);
+            };
+            runtime->eeScheduler().invokeCurrent(std::move(invocation));
+        }
