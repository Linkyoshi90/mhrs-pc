diff --git a/ps2xRuntime/include/runtime/ps2_ordered_worker.h b/ps2xRuntime/include/runtime/ps2_ordered_worker.h
new file mode 100644
index 0000000..f830474
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_ordered_worker.h
@@ -0,0 +1,155 @@
+#ifndef PS2_ORDERED_WORKER_H
+#define PS2_ORDERED_WORKER_H
+
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <exception>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+// Runs posted jobs one after another, in posting order. Inline (the default) runs a job inside post(), like a
+// direct call. Async runs jobs on a thread of its own, and drain() waits for all of them. Lockstep uses the
+// thread but waits for each job in post(), so behaviour is that of Inline while the jobs still run elsewhere.
+class OrderedWorker
+{
+public:
+    enum class Mode
+    {
+        Inline,
+        Lockstep,
+        Async
+    };
+
+    OrderedWorker() = default;
+    OrderedWorker(const OrderedWorker &) = delete;
+    OrderedWorker &operator=(const OrderedWorker &) = delete;
+    ~OrderedWorker() { stop(); }
+
+    void start(Mode mode)
+    {
+        stop();
+        if (mode == Mode::Inline)
+            return;
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_stopping = false;
+        m_mode = mode;
+        m_thread = std::thread([this] { loop(); });
+        m_threadId = m_thread.get_id();
+    }
+
+    // Runs what is still queued, then ends the thread; later jobs run inline.
+    void stop()
+    {
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            if (!m_thread.joinable())
+                return;
+            m_stopping = true;
+        }
+        m_wake.notify_one();
+        m_thread.join();
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_mode = Mode::Inline;
+        m_threadId = {};
+    }
+
+    // "inline", "lockstep" or "async"; anything else (or null) gives fallback.
+    static Mode modeFromName(const char *name, Mode fallback)
+    {
+        if (!name)
+            return fallback;
+        const std::string value(name);
+        if (value == "inline" || value == "0")
+            return Mode::Inline;
+        if (value == "lockstep")
+            return Mode::Lockstep;
+        if (value == "async" || value == "1")
+            return Mode::Async;
+        return fallback;
+    }
+
+    Mode mode() const { return m_mode; }
+    bool onWorkerThread() const { return m_mode != Mode::Inline && std::this_thread::get_id() == m_threadId; }
+
+    void post(std::function<void()> job)
+    {
+        if (m_mode == Mode::Inline || onWorkerThread())
+        {
+            job();
+            return;
+        }
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_jobs.push_back(std::move(job));
+            ++m_posted;
+        }
+        m_wake.notify_one();
+        if (m_mode == Mode::Lockstep)
+            drain();
+    }
+
+    // Returns once every job posted so far has run. A no-op on the worker thread and in Inline mode.
+    void drain()
+    {
+        if (m_mode == Mode::Inline || onWorkerThread())
+            return;
+        std::unique_lock<std::mutex> lock(m_mutex);
+        const uint64_t target = m_posted;
+        m_idle.wait(lock, [&] { return m_done >= target; });
+    }
+
+private:
+    void loop()
+    {
+        std::vector<std::function<void()>> batch;
+        for (;;)
+        {
+            {
+                std::unique_lock<std::mutex> lock(m_mutex);
+                m_wake.wait(lock, [&] { return !m_jobs.empty() || m_stopping; });
+                if (m_jobs.empty())
+                    return; // stopping, nothing left
+                batch.swap(m_jobs);
+            }
+            for (auto &job : batch)
+            {
+                try
+                {
+                    job();
+                }
+                catch (const std::exception &e)
+                {
+                    std::fprintf(stderr, "[OrderedWorker] job failed: %s\n", e.what());
+                }
+                catch (...)
+                {
+                    std::fprintf(stderr, "[OrderedWorker] job failed\n");
+                }
+            }
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_done += batch.size();
+            }
+            batch.clear();
+            m_idle.notify_all();
+        }
+    }
+
+    Mode m_mode = Mode::Inline;
+    std::thread m_thread;
+    std::thread::id m_threadId{};
+    std::mutex m_mutex;
+    std::condition_variable m_wake;
+    std::condition_variable m_idle;
+    std::vector<std::function<void()>> m_jobs;
+    uint64_t m_posted = 0;
+    uint64_t m_done = 0;
+    bool m_stopping = false;
+};
+
+#endif // PS2_ORDERED_WORKER_H
