+                    drainGifVu();
+                    unpack(data + pos, true, mode, vif1_regs.mask, vif1_regs.row, vif1_regs.col, nullptr);
+                }
+                else if (readsMemory)
+                {
+                    // ROW stays as it is here (offset mode adds it, unknown formats never take it from the source).
+                    struct Rows
+                    {
+                        uint32_t row[4];
+                        uint32_t col[4];
+                    } rows;
+                    std::memcpy(rows.row, vif1_regs.row, sizeof(rows.row));
+                    std::memcpy(rows.col, vif1_regs.col, sizeof(rows.col));
+                    postGifVu([unpack, mode, mask = vif1_regs.mask, rows, src = std::vector<uint8_t>(data + pos, data + pos + totalBytes)]() mutable
+                              { unpack(src.data(), true, mode, mask, rows.row, rows.col, nullptr); });
+                }
+                else
+                {
+                    std::vector<LaneWrite> writes;
+                    writes.reserve(writeVectorCount);
+                    unpack(data + pos, false, mode, vif1_regs.mask, vif1_regs.row, vif1_regs.col, &writes);
+                    if (!writes.empty())
+                        postGifVu([this, writes = std::move(writes)]
+                                  {
+                                      for (const LaneWrite &w : writes)
+                                          for (uint32_t field = 0u; field < 4u; ++field)
+                                              if ((w.mask >> field) & 1u)
+                                                  std::memcpy(m_vu1Data + w.offset + field * 4u, &w.lanes[field], sizeof(uint32_t)); });
                 }
             }
             pos += totalBytes;
