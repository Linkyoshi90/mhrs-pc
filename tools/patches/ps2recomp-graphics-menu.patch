+    // ---- graphics menu ----
+    std::atomic<int> g_frameRate{60};
+
+    struct WindowSize
+    {
+        int w, h;
+    };
+    constexpr WindowSize kWindowSizes[] = {{640, 480},   {960, 720},   {1280, 720},  {1280, 960},
+                                           {1600, 900},  {1600, 1200}, {1920, 1080}, {2560, 1440}, {3840, 2160}};
+    constexpr int kWindowSizeCount = static_cast<int>(std::size(kWindowSizes));
+
+    // What the graphics file holds. windowW 0: the start size (MHRS_WINDOW or the built-in one); scale 0: the
+    // start value (PS2X_VK_SCALE).
+    struct GraphicsSettings
+    {
+        int windowW = 0, windowH = 0;
+        bool fullscreen = false;
+        uint32_t scale = 0;
+        int frameRate = 60;
+    };
+
+    enum GraphicsRow
+    {
+        GfxWindow,
+        GfxFullscreen,
+        GfxScale,
+        GfxFrameRate,
+        GfxDefaults,
+        GfxCount
+    };
+
+    struct GraphicsMenu
+    {
+        int selected = 0;
+        std::string status;
+        GraphicsSettings settings;
+    };
+
+    // Unknown keys and bad values are skipped: a hand-edited file never stops the game.
+    GraphicsSettings loadGraphics()
+    {
+        GraphicsSettings s;
+        std::ifstream file(ps2GraphicsPath());
+        for (std::string line; std::getline(file, line);)
+        {
+            line = line.substr(0, line.find('#'));
+            const size_t eq = line.find('=');
+            if (eq == std::string::npos)
+                continue;
+            std::string key = line.substr(0, eq);
+            key.erase(std::remove_if(key.begin(), key.end(), [](unsigned char c) { return std::isspace(c); }), key.end());
+            const char *value = line.c_str() + eq + 1;
+            int a = 0, b = 0;
+            if (key == "window" && std::sscanf(value, " %dx%d", &a, &b) == 2 && a >= 320 && b >= 240)
+            {
+                s.windowW = a;
+                s.windowH = b;
+            }
+            else if (key == "fullscreen" && std::sscanf(value, " %d", &a) == 1)
+                s.fullscreen = a != 0;
+            else if (key == "scale" && std::sscanf(value, " %d", &a) == 1 && a >= 1 && a <= 4)
+                s.scale = static_cast<uint32_t>(a);
+            else if (key == "fps" && std::sscanf(value, " %d", &a) == 1)
+                s.frameRate = a <= 30 ? 30 : 60;
+        }
+        return s;
+    }
+
+    void saveGraphics(const GraphicsSettings &s, std::string &status)
+    {
+        std::ofstream file(ps2GraphicsPath(), std::ios::trunc);
+        file << "# Written by the graphics menu (F4).\n";
+        if (s.windowW > 0)
+            file << "window = " << s.windowW << "x" << s.windowH << "    # window size when not fullscreen\n";
+        file << "fullscreen = " << (s.fullscreen ? 1 : 0) << "    # borderless, at the monitor's resolution\n";
+        if (s.scale > 0)
+            file << "scale = " << s.scale << "    # internal resolution, 1 (native PS2) to 4\n";
+        file << "fps = " << s.frameRate << "    # game frame rate: 60 or 30 (menus always run at 30)\n";
+        status = file ? std::string("Saved to ") + ps2GraphicsPath() : std::string("Could not write ") + ps2GraphicsPath();
+    }
+
+    void applyGraphics(const GraphicsSettings &s)
+    {
+        if (s.fullscreen != IsWindowState(FLAG_BORDERLESS_WINDOWED_MODE))
+            ToggleBorderlessWindowed();
+        if (!s.fullscreen && s.windowW > 0 && (GetScreenWidth() != s.windowW || GetScreenHeight() != s.windowH))
+            SetWindowSize(s.windowW, s.windowH);
+        if (s.scale > 0)
+            gsHiresSetScale(s.scale);
+        g_frameRate.store(s.frameRate, std::memory_order_relaxed);
+    }
+
+    // The preset at or just above the current window size.
+    int windowPreset(int w, int h)
+    {
+        for (int i = 0; i < kWindowSizeCount; ++i)
+            if (kWindowSizes[i].w * kWindowSizes[i].h >= w * h)
+                return i;
+        return kWindowSizeCount - 1;
+    }
+
+    bool updateGraphics(GraphicsMenu &menu)
+    {
+        if (IsKeyPressed(KEY_ESCAPE) || IsKeyPressed(KEY_F4))
+            return false;
+        if (pressed(KEY_DOWN))
+            menu.selected = (menu.selected + 1) % GfxCount;
+        if (pressed(KEY_UP))
+            menu.selected = (menu.selected + GfxCount - 1) % GfxCount;
+        const int step = pressed(KEY_RIGHT) ? 1 : (pressed(KEY_LEFT) ? -1 : 0);
+        const bool enter = IsKeyPressed(KEY_ENTER) || IsKeyPressed(KEY_KP_ENTER);
+        GraphicsSettings &s = menu.settings;
+        bool changed = false;
+        switch (menu.selected)
+        {
+        case GfxWindow:
+            if (step != 0 && !s.fullscreen)
+            {
+                const int current = windowPreset(GetScreenWidth(), GetScreenHeight());
+                const bool exact = kWindowSizes[current].w == GetScreenWidth() && kWindowSizes[current].h == GetScreenHeight();
+                // From a size between presets, Left goes to the one below, Right to the one above.
+                const int next = std::clamp(step < 0 || exact ? current + step : current, 0, kWindowSizeCount - 1);
+                s.windowW = kWindowSizes[next].w;
+                s.windowH = kWindowSizes[next].h;
+                changed = true;
+            }
+            break;
+        case GfxFullscreen:
+            if (step != 0 || enter)
+            {
+                s.fullscreen = !s.fullscreen;
+                changed = true;
+            }
+            break;
+        case GfxScale:
+            if (step != 0)
+            {
+                s.scale = static_cast<uint32_t>(std::clamp(static_cast<int>(gsHiresScale()) + step, 1, 4));
+                changed = true;
+            }
+            break;
+        case GfxFrameRate:
+            if (step != 0 || enter)
+            {
+                s.frameRate = s.frameRate == 60 ? 30 : 60;
+                changed = true;
+            }
+            break;
+        case GfxDefaults:
+            if (enter)
+            {
+                s = GraphicsSettings{};
+                s.windowW = 1280;
+                s.windowH = 960;
+                s.scale = 2;
+                changed = true;
+            }
+            break;
+        }
+        if (changed)
+        {
+            applyGraphics(s);
+            saveGraphics(s, menu.status);
+        }
+        return true;
+    }
+
+    void drawGraphics(const GraphicsMenu &menu)
+    {
+        const GraphicsSettings &s = menu.settings;
+        const Panel p = drawPanel("Graphics", GfxCount, "Up/Down: select   Left/Right: change   Esc/F4: close");
+        for (int row = 0; row < GfxCount; ++row)
+        {
+            const int y = p.y + 48 + row * kRowHeight;
+            if (row == menu.selected)
+                DrawRectangle(p.x + 8, y - 2, p.w - 16, kRowHeight, Color{90, 70, 30, 200});
+            std::string label, value;
+            switch (row)
+            {
+            case GfxWindow:
+                label = "Window size";
+                value = s.fullscreen ? TextFormat("%dx%d (fullscreen)", GetScreenWidth(), GetScreenHeight())
+                                     : TextFormat("%dx%d", GetScreenWidth(), GetScreenHeight());
+                break;
+            case GfxFullscreen: label = "Fullscreen"; value = s.fullscreen ? "on" : "off"; break;
+            case GfxScale:
+                label = "Internal resolution";
+                value = TextFormat("%ux (%ux%u)%s", gsHiresScale(), 640u * gsHiresScale(), 448u * gsHiresScale(),
+                                   gsHiresScale() > 1u ? "" : "  native PS2");
+                break;
+            case GfxFrameRate:
+                label = "Frame rate";
+                value = TextFormat("%d fps%s", s.frameRate, s.frameRate == 60 ? "" : "  (as on the PS2)");
+                break;
+            case GfxDefaults: label = "Reset to defaults (Enter)"; break;
+            }
+            DrawText(label.c_str(), p.x + 20, y, kFont, RAYWHITE);
+            DrawText(value.c_str(), p.x + 300, y, kFont, row == menu.selected ? YELLOW : Color{180, 220, 255, 255});
+        }
+        if (!menu.status.empty())
+            DrawText(menu.status.c_str(), p.x + p.w - 16 - MeasureText(menu.status.c_str(), 16), p.y + 16, 16, LIME);
+    }
