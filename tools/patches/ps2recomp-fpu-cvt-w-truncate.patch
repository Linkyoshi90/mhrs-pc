@@ -305,6 +305,17 @@ inline float ps2_fsqrt(float a)
     return ps2_fall_normal(a, a, r) ? r : ps2_fsqrt_slow(a);
 }
 
+// The R5900 CVT.W.S ignores the rounding mode and always truncates toward zero (ee-gcc emits it for every
+// (int) cast); |x| >= 2^31 saturates to INT32_MAX / INT32_MIN by sign.
+inline int32_t ps2_cvt_w_s(float a)
+{
+    uint32_t bits;
+    std::memcpy(&bits, &a, sizeof(bits));
+    if ((bits & 0x7F800000u) <= 0x4E800000u)
+        return static_cast<int32_t>(a);
+    return (bits & 0x80000000u) ? INT32_MIN : INT32_MAX;
+}
+
 inline float ps2_frsqrt(float a, float b)
 {
     const float r = a / std::sqrt(b);
