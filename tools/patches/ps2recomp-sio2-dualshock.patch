-                const auto flags = VU1Interpreter::CompiledAccess::fmacForTest(vu, upper, false);
-                const uint32_t mac = zero | (sign << 4) | (under << 8) | (over << 12);
-                const uint32_t status = (zero ? 1u : 0u) | (sign ? 2u : 0u) | (under ? 4u : 0u) | (over ? 8u : 0u);
