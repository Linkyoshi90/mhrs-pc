+    std::string mhrsDebugIopIntrDump() { return IopIntrman::s_debug ? IopIntrman::s_debug->debugDump() : std::string("<none>"); }
+}
diff --git a/ps2xIOP/src/emulator/imports/iop_intrman.h b/ps2xIOP/src/emulator/imports/iop_intrman.h
