-                        over |= bit, ++overflows, value = std::signbit(exact) ? -std::numeric_limits<float>::max() : std::numeric_limits<float>::max();
-                    else if (magnitude < std::numeric_limits<float>::min())
-                        under |= bit, zero |= bit, value = std::signbit(exact) ? -0.0f : 0.0f;
-                    expect[lane] = value;
