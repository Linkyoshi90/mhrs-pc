+        constexpr uint16_t kBtnL1 = 1u << 10;
+        constexpr uint16_t kBtnR1 = 1u << 11;
+        constexpr uint16_t kBtnTriangle = 1u << 12;
+        constexpr uint16_t kBtnCircle = 1u << 13;
+        constexpr uint16_t kBtnCross = 1u << 14;
+        constexpr uint16_t kBtnSquare = 1u << 15;
+
+        bool traceEnabled()
+        {
+            static const bool enabled = std::getenv("MHRS_SIO2_LOG") != nullptr;
+            return enabled;
+        }
+
+        void trace(const char *what, uint32_t a, uint32_t b)
+        {
+            if (traceEnabled())
+                std::cerr << "[sio2] " << what << " " << std::hex << a << " " << b << std::dec << "\n";
+        }
+    }
+
+    // ------------------------------------------------------------------ DualShock2
+
+    void IopSio2::DualShock2::powerOn()
+    {
+        commandBytesReceived = 0;
+        currentCommand = 0;
+        isInConfig = false;
+        currentMode = 0x41u; // digital
+        analogLight = false;
+        analogLocked = false;
+        commandStage = false;
+        responseBytes = 0;
+        smallMotorLastConfig = 0xFF;
+        largeMotorLastConfig = 0xFF;
+        vibrationMotors[0] = vibrationMotors[1] = 0;
+    }
+
+    uint8_t IopSio2::DualShock2::poll(uint8_t byte, const IopPadState &input) const
+    {
+        // Wire order: buttons select..left, buttons l2..square, rx, ry, lx, ly, then pressure.
+        switch (commandBytesReceived)
+        {
+        case 3:
+            return static_cast<uint8_t>(input.buttons & 0xFFu);
+        case 4:
+            return static_cast<uint8_t>(input.buttons >> 8u);
+        case 5:
+            return input.rx;
+        case 6:
+            return input.ry;
+        case 7:
+            return input.lx;
+        case 8:
+            return input.ly;
+        default:
+            break;
+        }
+        // Pressure bytes 9..20: Right, Left, Up, Down, Triangle, Circle, Cross, Square, L1, R1, L2, R2.
+        static constexpr uint16_t kPressureBits[12] = {
+            kBtnRight, kBtnLeft, kBtnUp, kBtnDown, kBtnTriangle, kBtnCircle,
+            kBtnCross, kBtnSquare, kBtnL1, kBtnR1, kBtnL2, kBtnR2};
+        if (commandBytesReceived >= 9 && commandBytesReceived <= 20)
+        {
+            const uint16_t bit = kPressureBits[commandBytesReceived - 9];
+            return (input.buttons & bit) == 0u ? 0xFFu : 0x00u;
+        }
+        (void)byte;
+        return 0x00;
+    }
+
+    uint8_t IopSio2::DualShock2::config(uint8_t byte)
+    {
+        if (commandBytesReceived == 3)
+            isInConfig = byte != 0;
+        return 0x00;
+    }
+
+    uint8_t IopSio2::DualShock2::modeSwitch(uint8_t byte)
+    {
+        switch (commandBytesReceived)
+        {
+        case 3:
+            analogLight = byte != 0;
+            currentMode = analogLight ? kPadModeAnalog : 0x41u;
+            break;
+        case 4:
+            analogLocked = byte == 0x03;
+            break;
+        default:
+            break;
+        }
+        return 0x00;
+    }
+
+    uint8_t IopSio2::DualShock2::statusInfo() const
+    {
+        switch (commandBytesReceived)
+        {
+        case 3:
+            return 0x03; // physical type: standard DS2
+        case 4:
+            return 0x02;
+        case 5:
+            return analogLight ? 0x01 : 0x00;
+        case 6:
+            return 0x02;
+        case 7:
+            return 0x01;
+        default:
+            return 0x00;
+        }
+    }
+
+    uint8_t IopSio2::DualShock2::constant1(uint8_t byte)
+    {
+        switch (commandBytesReceived)
+        {
+        case 3:
+            commandStage = byte != 0;
+            return 0x00;
+        case 5:
+            return 0x01;
+        case 6:
+            return commandStage ? 0x01 : 0x02;
+        case 7:
+            return commandStage ? 0x01 : 0x00;
+        case 8:
+            return commandStage ? 0x14 : 0x0A;
+        default:
+            return 0x00;
+        }
+    }
+
+    uint8_t IopSio2::DualShock2::constant2() const
+    {
+        switch (commandBytesReceived)
+        {
+        case 5:
+            return 0x02;
+        case 7:
+            return 0x01;
+        default:
+            return 0x00;
+        }
+    }
+
+    uint8_t IopSio2::DualShock2::constant3(uint8_t byte)
+    {
+        switch (commandBytesReceived)
+        {
+        case 3:
+            commandStage = byte != 0;
+            return 0x00;
+        case 6:
+            return commandStage ? 0x07 : 0x04;
+        default:
+            return 0x00;
+        }
+    }
+
+    uint8_t IopSio2::DualShock2::vibrationMap(uint8_t byte)
+    {
+        switch (commandBytesReceived)
+        {
+        case 3:
+        {
+            const uint8_t previous = smallMotorLastConfig;
+            smallMotorLastConfig = byte;
+            return previous;
+        }
+        case 4:
+        {
+            const uint8_t previous = largeMotorLastConfig;
+            largeMotorLastConfig = byte;
+            return previous;
+        }
+        default:
+            return 0xFF;
+        }
+    }
+
+    uint8_t IopSio2::DualShock2::responseBytesCmd(uint8_t byte)
+    {
+        switch (commandBytesReceived)
+        {
+        case 3:
+            responseBytes = byte;
+            return 0x00;
+        case 4:
+            responseBytes |= static_cast<uint32_t>(byte) << 8u;
+            return 0x00;
+        case 5:
+            responseBytes |= static_cast<uint32_t>(byte) << 16u;
+            if (responseBytes == kResponseBytesAnalog || responseBytes == kResponseBytesDualShock2)
+            {
+                analogLight = true;
+                currentMode = responseBytes == kResponseBytesDualShock2 ? kPadModeDualShock2 : kPadModeAnalog;
+            }
+            else
+            {
+                analogLight = false;
+                currentMode = 0x41u; // digital
+            }
+            return 0x00;
+        case 8:
+            return 0x5A;
+        default:
+            return 0x00;
+        }
+    }
+
+    uint8_t IopSio2::DualShock2::buttonQuery() const
+    {
+        if (currentMode == kPadModeDualShock2 || currentMode == kPadModeAnalog)
+        {
+            switch (commandBytesReceived)
+            {
+            case 3:
+            case 4:
+                return 0xFF;
+            case 5:
+                return 0x03;
+            case 8:
+                return 0x5A;
+            default:
+                return 0x00;
+            }
+        }
+        return 0x00;
+    }
+
+    uint8_t IopSio2::DualShock2::mystery() const
+    {
+        switch (commandBytesReceived)
+        {
+        case 5:
+            return 0x02;
+        case 8:
+            return 0x5A;
+        default:
+            return 0x00;
+        }
+    }
+
+    uint8_t IopSio2::DualShock2::sendCommandByte(uint8_t byte, const IopPadState &input)
+    {
+        uint8_t ret = 0;
+        switch (commandBytesReceived)
+        {
+        case 0:
+            ret = 0x00; // response to the 0x01 command-start byte
+            break;
+        case 1:
+            currentCommand = byte;
+            ret = isInConfig ? kPadModeConfig : currentMode;
+            break;
+        case 2:
+            ret = 0x5A;
+            break;
+        default:
+            switch (currentCommand)
+            {
+            case kCmdMystery:
+                ret = mystery();
+                break;
+            case kCmdButtonQuery:
+                ret = buttonQuery();
+                break;
+            case kCmdPoll:
+                ret = poll(byte, input);
+                break;
+            case kCmdConfig:
+                ret = config(byte);
+                break;
+            case kCmdModeSwitch:
+                ret = modeSwitch(byte);
+                break;
+            case kCmdStatusInfo:
+                ret = statusInfo();
+                break;
+            case kCmdConstant1:
+                ret = constant1(byte);
+                break;
+            case kCmdConstant2:
+                ret = constant2();
+                break;
+            case kCmdConstant3:
+                ret = constant3(byte);
+                break;
+            case kCmdVibrationMap:
+                ret = vibrationMap(byte);
+                break;
+            case kCmdResponseBytes:
+                ret = responseBytesCmd(byte);
+                break;
+            default:
+                ret = 0x00;
+                break;
+            }
+        }
+        ++commandBytesReceived;
+        return ret;
+    }
+
+    // ------------------------------------------------------------------ IopSio2
+
+    void IopSio2::reset()
+    {
+        for (auto &word : m_cmdQueue)
+            word = 0;
+        for (int i = 0; i < 4; ++i)
+        {
+            m_portCtrl0[i] = 0;
+            m_portCtrl1[i] = 0;
+        }
+        m_dataIn = 0;
+        m_ctrl = kCtrlResetValue;
+        m_cmdStat = kStatDisconnected;
+        m_portStat = 0xFu;
+        m_fifoStat = 0;
+        m_fifoTxPos = 0;
+        m_fifoRxPos = 0;
+        m_iStat = 0;
+        for (auto &pad : m_pads)
+            pad.powerOn();
+        softReset();
+    }
+
+    void IopSio2::softReset()
+    {
+        m_queueRead = false;
+        m_queuePosition = 0;
+        m_commandLength = 0;
+        m_queueComplete = false;
+        m_fifoIn.clear();
+        // Responses for a packet still being read out are discarded, matching
+        // PCSX2: cmdStat is rebuilt by the next packet.
+        m_fifoOut.clear();
+        m_cmdStat = 0;
+    }
+
+    bool IopSio2::takeInterruptRequest() noexcept
+    {
+        const bool requested = m_interruptRequested;
+        m_interruptRequested = false;
+        return requested;
+    }
+
+    void IopSio2::setPadInputProvider(IopPadInputProvider provider)
+    {
+        m_padInputProvider = std::move(provider);
+    }
+
+    void IopSio2::writeFifoByte(uint8_t value)
+    {
+        if (!m_queueRead)
+        {
+            if (m_queuePosition >= 16u)
+                return; // all command words consumed, ignore stragglers
+            const uint32_t currentCmd = m_cmdQueue[m_queuePosition];
+            m_port = currentCmd & kCmdPortMask;
+            m_commandLength = (currentCmd >> 8u) & kCmdLengthMask;
+            m_queueRead = true;
+            if (m_commandLength == 0)
+                m_queueComplete = true;
+            // Drop any unread command bytes from the previous command.
+            m_fifoIn.clear();
+        }
+
+        if (m_queueComplete)
+            return;
+
+        m_fifoIn.push_back(value);
+
+        if (m_fifoIn.size() == m_commandLength)
+        {
+            m_queueRead = false;
+            ++m_queuePosition;
+            dispatchCommand();
+        }
+    }
+
+    uint8_t IopSio2::readFifoByte() const
+    {
+        if (m_fifoOut.empty())
+            return 0xFFu; // open bus
+        const uint8_t value = m_fifoOut.front();
+        m_fifoOut.pop_front();
+        return value;
+    }
+
+    void IopSio2::dispatchCommand()
+    {
+        const uint8_t sioMode = m_fifoIn.front();
+        m_fifoIn.pop_front();
+        switch (sioMode)
+        {
+        case kSioModePad:
+            doPad();
+            break;
+        case kSioModeMultitap:
+            doMultitap();
+            break;
+        case kSioModeInfrared:
+            doInfrared();
+            break;
+        case kSioModeMemcard:
+            doMemcard();
+            break;
+        default:
+            m_fifoOut.push_back(0xFFu);
+            m_cmdStat = kStatDisconnected;
+            break;
+        }
+        trace("cmd", sioMode, m_cmdStat);
+    }
+
+    void IopSio2::notePortAccess(bool connected)
+    {
+        // Third nibble tracks how many distinct ports this packet touched.
+        if (m_cmdStat & kStatOnePortOpen)
+        {
+            m_cmdStat &= ~kStatOnePortOpen;
+            m_cmdStat |= kStatTwoPortsOpen;
+        }
+        else
+        {
+            m_cmdStat |= kStatOnePortOpen;
+        }
+        m_cmdStat |= kStatNoDevicesMissing;
+        if (!connected)
+            m_cmdStat |= (m_port == 0) ? kStatPort1Missing : kStatPort2Missing;
+    }
+
+    void IopSio2::doPad()
+    {
+        IopPadState input;
+        const bool connected = m_padInputProvider && m_padInputProvider(static_cast<int>(m_port), input);
+        notePortAccess(connected);
+
+        m_fifoOut.push_back(0xFFu); // response to the SIO mode byte
+        DualShock2 &pad = m_pads[std::min<uint32_t>(m_port, 1u)];
+        pad.softReset();
+        while (!m_fifoIn.empty())
+        {
+            const uint8_t commandByte = m_fifoIn.front();
+            m_fifoIn.pop_front();
+            m_fifoOut.push_back(connected ? pad.sendCommandByte(commandByte, input) : 0xFFu);
+        }
+    }
+
+    void IopSio2::doMultitap()
+    {
+        // No multitap: MTAPMAN only checks the PORT_1_MISSING bit regardless of port.
+        notePortAccess(false);
+        m_cmdStat |= kStatPort1Missing;
+        while (!m_fifoIn.empty())
+        {
+            m_fifoIn.pop_front();
+            m_fifoOut.push_back(0xFFu);
+        }
+    }
+
+    void IopSio2::doInfrared()
+    {
+        m_cmdStat = kStatDisconnected;
+        while (!m_fifoIn.empty())
+        {
+            m_fifoIn.pop_front();
+            m_fifoOut.push_back(0xFFu);
+        }
+    }
+
+    void IopSio2::doMemcard()
+    {
+        // Saves are HLEd on the EE side (sceMc* stubs); report empty slots so the
+        // emulated MCMAN stays out of the way.
+        m_cmdStat = kStatDisconnected;
+        while (!m_fifoIn.empty())
+        {
+            m_fifoIn.pop_front();
+            m_fifoOut.push_back(0xFFu);
+        }
+    }
+
+    uint32_t IopSio2::readRegister(uint32_t offset) const
+    {
+        offset &= 0xFFFFu;
+        if (offset >= kCmdQueueBase && offset < kPortCtrlBase)
+            return m_cmdQueue[(offset - kCmdQueueBase) / 4u];
+        if (offset >= kPortCtrlBase && offset < kFifoIn)
+        {
+            const uint32_t index = (offset - kPortCtrlBase) / 8u;
+            return (offset & 4u) ? m_portCtrl1[index] : m_portCtrl0[index];
+        }
+        switch (offset)
+        {
+        case kFifoIn:
+            return m_dataIn;
+        case kFifoOut:
+            return readFifoByte();
+        case kCtrl:
+            return m_ctrl;
+        case kCmdStat:
+            return m_cmdStat;
+        case kPortStat:
+            return m_portStat;
+        case kFifoStat:
+            return m_fifoStat;
+        case kFifoTxPos:
+            return m_fifoTxPos;
+        case kFifoRxPos:
+            return m_fifoRxPos;
+        case kIStat:
+            return m_iStat;
+        default:
+            return 0;
+        }
+    }
+
+    void IopSio2::writeRegister(uint32_t offset, uint32_t value)
+    {
+        offset &= 0xFFFFu;
+        if (offset >= kCmdQueueBase && offset < kPortCtrlBase)
+        {
+            const uint32_t index = (offset - kCmdQueueBase) / 4u;
+            m_cmdQueue[index] = value;
+            if (index == 0)
+                softReset();
+            return;
+        }
+        if (offset >= kPortCtrlBase && offset < kFifoIn)
+        {
+            const uint32_t index = (offset - kPortCtrlBase) / 8u;
+            if (offset & 4u)
+                m_portCtrl1[index] = value;
+            else
+                m_portCtrl0[index] = value;
+            return;
+        }
+        switch (offset)
+        {
+        case kFifoIn:
+            m_dataIn = value;
+            writeFifoByte(static_cast<uint8_t>(value & 0xFFu));
+            trace("tx", value, static_cast<uint32_t>(m_fifoOut.size()));
+            return;
+        case kCtrl:
+            m_ctrl = value;
+            if (value & kCtrlStartTransfer)
+            {
+                // All responses are already in the output FIFO (they were produced as the
+                // command bytes were written), so the transfer completes (almost) instantly.
+                m_iStat |= 1u;
+                m_interruptRequested = true;
+                trace("ctrl", value, static_cast<uint32_t>(m_fifoOut.size()));
+            }
+            return;
+        case kCmdStat:
+            m_cmdStat = value;
+            return;
+        case kPortStat:
+            m_portStat = value;
+            return;
+        case kFifoStat:
+            m_fifoStat = value;
+            return;
+        case kFifoTxPos:
+            m_fifoTxPos = value;
+            return;
+        case kFifoRxPos:
+            m_fifoRxPos = value;
+            return;
+        case kIStat:
+            m_iStat &= ~value;
+            return;
+        default:
+            return;
+        }
+    }
+}
diff --git a/ps2xIOP/src/emulator/core/iop_sio2.h b/ps2xIOP/src/emulator/core/iop_sio2.h
new file mode 100644
index 0000000..6a43678
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_sio2.h
@@ -0,0 +1,99 @@
+#pragma once
+
+// SIO2 serial bus emulation: register window at 0x1F808200-0x1F808280 (plus the
+// 0x1F81xxxx mirror EA's SIO2MAN.IRX uses), the command-queue transfer engine, and a
+// DualShock 2 pad device so stock SIO2MAN/PADMAN IRX modules see a real controller.
+// Register semantics and the DS2 command tables follow PCSX2's SIO/Sio2 + SIO/Pad.
+
+#include "ps2x/iop/iop_types.h"
+
+#include <cstdint>
+#include <deque>
+
+namespace ps2x::iop::detail
+{
+    class IopSio2
+    {
+    public:
+        void reset();
+
+        // offset = physical address & 0xFFFF (accepts the 0x1F80/0x1F81 mirrors).
+        // Const like IopMemory's other reads; only the output FIFO pops (mutable).
+        [[nodiscard]] uint32_t readRegister(uint32_t offset) const;
+        void writeRegister(uint32_t offset, uint32_t value);
+
+        // Set by a CTRL write with START_TRANSFER; IopMemory turns it into a scheduled IRQ 17.
+        [[nodiscard]] bool takeInterruptRequest() noexcept;
+
+        void setPadInputProvider(IopPadInputProvider provider);
+
+    private:
+        struct DualShock2
+        {
+            // Persistent pad state (survives transfers, like real hardware).
+            uint32_t commandBytesReceived = 0;
+            uint8_t currentCommand = 0x00;
+            bool isInConfig = false;
+            uint8_t currentMode = 0x41; // digital on power-up
+            bool analogLight = false;
+            bool analogLocked = false;
+            bool commandStage = false;
+            uint32_t responseBytes = 0;
+            uint8_t smallMotorLastConfig = 0xFF;
+            uint8_t largeMotorLastConfig = 0xFF;
+            uint8_t vibrationMotors[2] = {0, 0};
+
+            void powerOn();
+            void softReset() noexcept { commandBytesReceived = 0; }
+            [[nodiscard]] uint8_t sendCommandByte(uint8_t byte, const IopPadState &input);
+
+        private:
+            [[nodiscard]] uint8_t poll(uint8_t byte, const IopPadState &input) const;
+            [[nodiscard]] uint8_t config(uint8_t byte);
+            [[nodiscard]] uint8_t modeSwitch(uint8_t byte);
+            [[nodiscard]] uint8_t statusInfo() const;
+            [[nodiscard]] uint8_t constant1(uint8_t byte);
+            [[nodiscard]] uint8_t constant2() const;
+            [[nodiscard]] uint8_t constant3(uint8_t byte);
+            [[nodiscard]] uint8_t vibrationMap(uint8_t byte);
+            [[nodiscard]] uint8_t responseBytesCmd(uint8_t byte);
+            [[nodiscard]] uint8_t buttonQuery() const;
+            [[nodiscard]] uint8_t mystery() const;
+        };
+
+        void softReset();
+        void writeFifoByte(uint8_t value);
+        [[nodiscard]] uint8_t readFifoByte() const;
+        void dispatchCommand();
+        void doPad();
+        void doMultitap();
+        void doInfrared();
+        void doMemcard();
+        void notePortAccess(bool connected);
+
+        uint32_t m_cmdQueue[16]{};
+        uint32_t m_portCtrl0[4]{};
+        uint32_t m_portCtrl1[4]{};
+        uint32_t m_dataIn = 0;
+        uint32_t m_ctrl = 0;
+        uint32_t m_cmdStat = 0;
+        uint32_t m_portStat = 0;
+        uint32_t m_fifoStat = 0;
+        uint32_t m_fifoTxPos = 0;
+        uint32_t m_fifoRxPos = 0;
+        uint32_t m_iStat = 0;
+
+        bool m_queueRead = false;
+        uint32_t m_queuePosition = 0;
+        uint32_t m_commandLength = 0;
+        bool m_queueComplete = false;
+        uint32_t m_port = 0;
+
+        std::deque<uint8_t> m_fifoIn;
+        mutable std::deque<uint8_t> m_fifoOut; // pops on reads, hence mutable
+
+        DualShock2 m_pads[2];
+        IopPadInputProvider m_padInputProvider;
+        bool m_interruptRequested = false;
+    };
+}
