-                    const float fa = vuOperand(a), fb = vuOperand(b), facc = vuOperand(acc);
-                    const long double la = fa, lb = fb, lacc = facc;
-                    long double exact;
-                    float value;
-                    switch (opIndex)
-                    {
-                    case 0: exact = la + lb, value = fa + fb; break;
-                    case 1: exact = la - lb, value = fa - fb; break;
-                    case 2: exact = la * lb, value = fa * fb; break;
-                    case 3: exact = lacc + la * lb, value = facc + product(fa, fb); break;
-                    default: exact = lacc - la * lb, value = facc - product(fa, fb); break;
