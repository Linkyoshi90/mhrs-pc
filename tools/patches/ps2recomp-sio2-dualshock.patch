-            {
-                const uint32_t dest = 1u + rng() % 15u;
-                const uint32_t opIndex = rng() % 5u;
-                const uint32_t upper = (dest << 21) | (2u << 16) | (1u << 11) | (3u << 6) | ops[opIndex];
-                VU1Interpreter vu;
-                vu.reset();
-                float expect[4];
-                uint32_t zero = 0u, sign = 0u, under = 0u, over = 0u;
-                for (uint32_t lane = 0; lane < 4u; ++lane)
-                {
-                    const float a = randomFloat(), b = randomFloat();
-                    float acc = randomFloat();
-                    if (rng() % 3u == 0u) // acc + a*b around +-FLT_MAX
-                    {
-                        const long double target = ((rng() & 1u) ? -1.0L : 1.0L) * std::numeric_limits<float>::max() *
-                                                   (1.0L + static_cast<int>(rng() % 9u - 4) * 0x1p-24L);
-                        acc = static_cast<float>(target - static_cast<long double>(vuOperand(a)) * vuOperand(b));
-                    }
-                    vu.state().vf[1][lane] = a;
-                    vu.state().vf[2][lane] = b;
-                    vu.state().acc[lane] = acc;
-                    vu.state().vf[3][lane] = 12345.0f;
-                    expect[lane] = 12345.0f;
-                    if ((dest & (8u >> lane)) == 0u)
