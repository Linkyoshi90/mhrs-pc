+        tc.Run("FMAC flags from the float result match the exact path", [](TestCase &t)
+        {
+            std::mt19937 rng(2024u);
+            // Exponents on and around the shortcut's thresholds, plus ordinary ones.
+            const auto randomFloat = [&]() -> float
+            {
+                static const uint32_t edges[] = {0u, 1u, 2u, 3u, 4u, 5u, 6u, 0xF8u, 0xF9u, 0xFAu, 0xFBu, 0xFCu, 0xFDu, 0xFEu, 0xFFu};
+                uint32_t exponent;
+                switch (rng() % 4u)
+                {
+                case 0: exponent = edges[rng() % (sizeof(edges) / sizeof(edges[0]))]; break;
+                case 1: exponent = 0x40u + rng() % 0x80u; break;           // products that land near the edges
+                case 2: exponent = 0x7Fu - 70u + rng() % 140u; break;
+                default: exponent = rng() % 256u; break;
+                }
+                const uint32_t bits = ((rng() & 1u) << 31) | (exponent << 23) | (rng() & 0x7FFFFFu);
+                return std::bit_cast<float>(bits);
+            };
+            static const uint32_t ops[] = {0x28u /*ADD*/, 0x2Cu /*SUB*/, 0x2Au /*MUL*/, 0x29u /*MADD*/, 0x2Du /*MSUB*/};
+            const int previous = std::fegetround();
+            std::fesetround(FE_TOWARDZERO);
+            int mismatches = 0, fastTaken = 0;
+            for (int round = 0; round < 200000; ++round)
+            {
+                const uint32_t dest = 1u + rng() % 15u;
+                const uint32_t upper = (dest << 21) | (2u << 16) | (1u << 11) | (3u << 6) | ops[rng() % 5u];
+                VU1Interpreter fast, exact;
+                for (VU1Interpreter *vu : {&fast, &exact})
+                    vu->reset();
+                for (int lane = 0; lane < 4; ++lane)
