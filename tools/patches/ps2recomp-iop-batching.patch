 void PS2Runtime::advanceIopEeCycles(uint64_t eeCycles) noexcept
 {
-    m_iopSubsystem->runEeCycles(eeCycles);
+    // The EE accounts a few cycles per guest dispatch. Running the IOP scheduler for ~8 IOP cycles at a
+    // time spends far more host time on scheduling than on execution, so batch the debt
+    // (16384 EE cycles = 2048 IOP cycles, ~55 us of guest time).
+    constexpr uint64_t kIopBatchEeCycles = 16384u;
+    m_iopEeCycleDebt += eeCycles;
+    if (m_iopEeCycleDebt < kIopBatchEeCycles)
+    {
+        return;
+    }
+    m_iopSubsystem->runEeCycles(m_iopEeCycleDebt);
+    m_iopEeCycleDebt = 0u;
 }
 
 void PS2Runtime::resetIop()
