+    // The queue lock is only ever held for a push, a swap or a counter update, so the poster and the thread spin for
+    // it. Sleeping on it (a contended std::mutex is a kernel wait and wake-up on Windows) cost the GIF/VU worker a
+    // tenth of its time: it posts a job per GIF packet while the GS stage takes them off as fast.
+    struct QueueLock
+    {
+        explicit QueueLock(std::mutex &mutex) : m_mutex(mutex)
+        {
+            while (!m_mutex.try_lock())
+                std::this_thread::yield();
+        }
+        ~QueueLock() { m_mutex.unlock(); }
+        QueueLock(const QueueLock &) = delete;
+        std::mutex &m_mutex;
+    };
