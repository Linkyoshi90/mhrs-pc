+bool GSCpuBackend::CanRasterRowsInParallel(const GSDrawState &state, int minX, int minY, int maxX, int maxY) const
+{
+    // Below this many pixels, waking the workers costs more than it saves.
+    constexpr int64_t kMinParallelPixels = 16384;
+    if (RowWorkerPool::instance().workers() == 0 ||
+        static_cast<int64_t>(maxX - minX + 1) * (maxY - minY + 1) < kMinParallelPixels)
+        return false;
+
+    // Rows may run in any order only if every pixel owns its framebuffer and
+    // depth words and nothing the primitive writes is read as a texel.
+    const auto &ctx = state.context;
+    const uint32_t fbw = std::max<uint32_t>(ctx.frame.fbw, 1u);
+    if (static_cast<uint32_t>(maxX) >= fbw * 64u)
+        return false; // wider rows alias other rows of the buffer
+
+    PageSpan frame, depth;
+    if (!pageSpan(ctx.frame.psm, framePageBaseToBlock(ctx.frame.fbp), fbw, minX, minY, maxX, maxY, frame))
+        return false;
+    const uint32_t ztest = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+    const bool depthAccess = ztest >= 2u || !ctx.zbuf.zmask;
+    if (depthAccess && (!pageSpan(ctx.zbuf.psm, framePageBaseToBlock(ctx.zbuf.zbp), fbw, minX, minY, maxX, maxY, depth) ||
+                        depth.overlaps(frame)))
+        return false;
+
+    if (!state.prim.tme)
+        return true;
+    const auto &tex = ctx.tex0;
+    const bool regionU = (ctx.clamp & 0x2u) != 0u;
+    const bool regionV = ((ctx.clamp >> 2) & 0x2u) != 0u;
+    const uint32_t maxU = regionU ? 1023u : std::max<uint32_t>(state.textureWidth, 1u) - 1u;
+    const uint32_t maxV = regionV ? 1023u : std::max<uint32_t>(state.textureHeight, 1u) - 1u;
+    PageSpan texture;
+    if (!pageSpan(tex.psm, tex.tbp0, tex.tbw, 0u, 0u, maxU, maxV, texture) ||
+        texture.overlaps(frame) || (depthAccess && texture.overlaps(depth)))
+        return false;
+
+    // Rows use their own caches, which see current VRAM; a stale cached copy
+    // of a texture page would make the serial result order dependent.
+    const uint32_t cachedPage = m_texturePageCache.PageBase() / GSMem::TexturePageCache::kPageSize;
+    return cachedPage < texture.first || cachedPage > texture.last || m_texturePageCache.MatchesVram(m_vram);
+}
+
+void GSCpuBackend::RasterRows(const GSDrawState &state, int minX, int minY, int maxX, int maxY, const RowRasterFn &rows)
+{
+    if (!CanRasterRowsInParallel(state, minX, minY, maxX, maxY))
+    {
+        TexelSource texels;
+        texels.cache = &m_texturePageCache;
+        rows(minY, maxY, texels);
+        return;
+    }
+
+    // The rows cannot see stale texels, so a small texture is decoded once
+    // instead of being swizzled and looked up again for every tap.
+    const auto &tex = state.context.tex0;
+    const uint32_t texW = (state.context.clamp & 0x2u) != 0u ? 1024u : std::max<uint32_t>(state.textureWidth, 1u);
+    const uint32_t texH = ((state.context.clamp >> 2) & 0x2u) != 0u ? 1024u : std::max<uint32_t>(state.textureHeight, 1u);
+    const int64_t pixels = static_cast<int64_t>(maxX - minX + 1) * (maxY - minY + 1);
+    thread_local std::vector<uint32_t> decoded;
+    const bool decode = state.prim.tme && static_cast<int64_t>(texW) * texH * 4 <= pixels;
+    if (decode)
+    {
+        GSMem::TexturePageCache cache;
+        decoded.resize(static_cast<size_t>(texW) * texH);
+        for (uint32_t v = 0; v < texH; ++v)
+            for (uint32_t u = 0; u < texW; ++u)
+                decoded[v * texW + u] = FetchTexel(cache, state, static_cast<int>(u), static_cast<int>(v));
+    }
+
+    RowWorkerPool &pool = RowWorkerPool::instance();
+    const int rowCount = maxY - minY + 1;
+    const int rowsPerChunk = std::max(1, rowCount / static_cast<int>(4u * (pool.workers() + 1u)));
+    const int chunks = (rowCount + rowsPerChunk - 1) / rowsPerChunk;
+    // What each chunk read last: the serial raster leaves the page of the
+    // last texel it read in the shared cache.
+    struct ChunkEnd
+    {
+        uint32_t page;
+        int u;
+        int v;
+    };
+    thread_local std::vector<ChunkEnd> ends;
+    std::vector<ChunkEnd> &chunkEnds = ends;
+    chunkEnds.assign(static_cast<size_t>(chunks), ChunkEnd{UINT32_MAX, -1, -1});
+    // Lambdas do not capture thread_locals: hand the workers the caller's buffer.
+    const uint32_t *decodedTexels = decode ? decoded.data() : nullptr;
+    pool.run(chunks, [&](int chunk)
+    {
+        thread_local GSMem::TexturePageCache cache;
+        cache.Invalidate();
+        TexelSource texels;
+        texels.cache = &cache;
+        texels.decoded = decodedTexels;
+        texels.decodedWidth = texW;
+        const int y0 = minY + chunk * rowsPerChunk;
+        rows(y0, std::min(maxY, y0 + rowsPerChunk - 1), texels);
+        chunkEnds[static_cast<size_t>(chunk)] = ChunkEnd{cache.PageBase(), texels.lastU, texels.lastV};
+    });
+    for (int chunk = chunks - 1; chunk >= 0; --chunk)
+    {
+        const ChunkEnd &end = chunkEnds[static_cast<size_t>(chunk)];
+        if (end.page != UINT32_MAX)
+        {
+            m_texturePageCache.Invalidate();
+            m_texturePageCache.Resolve(m_vram, end.page);
+            break;
+        }
+        if (end.u >= 0)
+        {
+            m_texturePageCache.Invalidate();
+            ReadTextureVramUnlocked(m_texturePageCache, tex.psm, tex.tbp0, tex.tbw, end.u, end.v);
+            break;
+        }
+    }
 }
 
