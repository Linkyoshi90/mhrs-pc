+    // Runs on a worker thread after each batch of jobs, before drain() counts them done, and before a job posts to
+    // the next stage in order: a stage that holds back what it posts onward (the GIF/VU worker batches GIF packets
+    // for the GS stage) hands it on here. Static, so the class layout stays as it is.
+    static inline std::atomic<void (*)()> s_flushHeld{nullptr};
+    static void flushHeld()
+    {
+        if (void (*const flush)() = s_flushHeld.load(std::memory_order_relaxed))
+            flush();
+    }
