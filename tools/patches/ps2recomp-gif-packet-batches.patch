+namespace
+{
+    // GIF packets the GIF/VU worker hands to the GS stage, several per GS-stage job: a job per packet (queue lock,
+    // std::function, pooled buffer) cost the worker ~6% in gameplay.
+    struct GifBatch
+    {
+        std::vector<uint8_t> bytes;
+        std::vector<uint32_t> sizes;
+    };
+    // A spin lock: the worker and the GS stage take it per batch, for a few instructions.
+    struct GifBatchPool
+    {
+        std::atomic_flag busy = ATOMIC_FLAG_INIT;
+        std::vector<GifBatch *> free;
+        void lock()
+        {
+            while (busy.test_and_set(std::memory_order_acquire))
+                _mm_pause();
+        }
+        void unlock() { busy.clear(std::memory_order_release); }
+    };
+    GifBatchPool g_gifBatchPool;
+    thread_local GifBatch *t_gifBatch = nullptr; // the batch this thread is filling
+    PS2Runtime *g_gifBatchRuntime = nullptr;
+}
