+void PS2Memory::flushUnpackBlocks() const
+{
+    if (std::this_thread::get_id() != m_unpackOwner.load(std::memory_order_relaxed) || m_unpackBlocks.empty())
+        return;
+    std::vector<UnpackBlock> blocks;
+    std::vector<uint32_t> words;
+    std::vector<uint8_t> masks;
+    blocks.swap(m_unpackBlocks);
+    words.swap(m_unpackData);
+    masks.swap(m_unpackMasks);
+    m_unpackBlocks.reserve(blocks.size());
+    m_unpackData.reserve(words.size());
+    m_unpackMasks.reserve(masks.size());
+    m_gifVuWorker.post([this, blocks = std::move(blocks), words = std::move(words), masks = std::move(masks)]
+                       {
+                           uint8_t *const vu1 = m_vu1Data;
+                           for (const UnpackBlock &b : blocks)
+                           {
+                               const uint32_t *src = words.data() + b.data;
+                               for (uint32_t i = 0; i < b.count;)
+                               {
+                                   const uint32_t dest = (b.start + i) & 0x3FFu;
+                                   const uint32_t run = std::min<uint32_t>(b.count - i, 1024u - dest);
+                                   if (b.masks == SIZE_MAX)
+                                       std::memcpy(vu1 + dest * 16u, src + static_cast<size_t>(i) * 4u, run * 16u);
+                                   else
+                                       for (uint32_t j = 0; j < run; ++j)
+                                       {
+                                           const uint8_t lanes = masks[b.masks + i + j];
+                                           for (uint32_t f = 0; f < 4u; ++f)
+                                               if ((lanes >> f) & 1u)
+                                                   std::memcpy(vu1 + (dest + j) * 16u + f * 4u, src + static_cast<size_t>(i + j) * 4u + f, 4u);
+                                       }
+                                   i += run;
+                               }
+                           } });
+}
