+    // Host vblank rate, 60 Hz by default, for a game that steps its logic by the vblanks that passed: it must scale
+    // its step per vblank by vblankPeriodUs(rate) / vblankPeriodUs(60). Applies from the next vblank, and never while
+    // a movie plays (its pictures count vblanks). Returns the rate the next vblank will use.
+    int setVBlankHz(int hz) noexcept;
+    // The vblank period for a rate, clamped to 30..240 Hz: 16667 us at 60, as before rates could change.
+    static constexpr uint32_t vblankPeriodUs(int hz) noexcept
+    {
+        hz = hz < 30 ? 30 : (hz > 240 ? 240 : hz);
+        return (1000000u + static_cast<uint32_t>(hz) / 2u) / static_cast<uint32_t>(hz);
+    }
