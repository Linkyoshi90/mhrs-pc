-// Stick byte for one frame of mouse motion, clamped to the stick range.
+// Stick byte for mouse motion (pixels per 1/60 s), clamped to the stick range.
 inline uint8_t ps2PadMouseAxis(float delta, float scale)
 {
     const float v = 128.0f + delta * scale;
     return v <= 0.0f ? 0x00 : (v >= 255.0f ? 0xFF : static_cast<uint8_t>(v + 0.5f));
 }
 
+// ---- Configurable controls ----
+// A controls file (PS2X_CONTROLS=<path>, default "controls.ini" in the working directory) rebinds the pad.
+// One line per target, replacing the default bindings of that target ("#" starts a comment):
+//   <target> = <input>[, <input>...]
+// targets:  up down left right cross circle square triangle l1 r1 l2 r2 l3 r3 start select (buttons),
+//           move_up move_down move_left move_right (left stick), look_up look_down look_left look_right (right stick)
+// inputs:   a key name (W, SPACE, LEFT_SHIFT, F1, KP_0, UP ...), mouse:left|right|middle|side|extra,
+//           pad:<button> (a b x y lb rb lt rt back start ls rs dpad_up dpad_down dpad_left dpad_right),
+//           pad:<axis><+|-> (lx ly rx ry; + is right/down)
+// settings: mouse_look = <stick units per pixel per 1/60 s, 0 = off>, deadzone = <0..0.9>,
+//           sensitivity = <look stick scale>, invert_y = 0|1, gamepad = <index>
+struct PadInput
+{
+    enum Kind : uint8_t
+    {
+        Key,
+        Mouse,
+        PadButton,
+        PadAxis
+    } kind;
+    int code; // raylib key / mouse button / gamepad button / gamepad axis
+    int sign; // PadAxis: +1 or -1
+    bool operator==(const PadInput &) const = default;
+};
+
+enum PadTarget : uint8_t
+{
+    PadUp,
+    PadDown,
+    PadLeft,
+    PadRight,
+    PadCross,
+    PadCircle,
+    PadSquare,
+    PadTriangle,
+    PadL1,
+    PadR1,
+    PadL2,
+    PadR2,
+    PadL3,
+    PadR3,
+    PadStart,
+    PadSelect,
+    PadMoveUp,
+    PadMoveDown,
+    PadMoveLeft,
+    PadMoveRight,
+    PadLookUp,
+    PadLookDown,
+    PadLookLeft,
+    PadLookRight,
+    PadTargetCount
+};
+
+struct PadControls
+{
+    std::array<std::vector<PadInput>, PadTargetCount> bind;
+    float mouseLook = 0.0f;
+    float deadzone = 0.0f;
+    float sensitivity = 1.0f;
+    bool invertY = false;
+    int gamepad = 0;
+};
+
+// The built-in bindings: keyboard, mouse buttons and the first gamepad together; PS2X_MOUSE_LOOK for mouseLook.
+PadControls ps2PadDefaultControls();
+// Applies a controls file's text; returns one message per line it could not use.
+std::vector<std::string> ps2PadParseControls(std::string_view text, PadControls &controls);
+// The defaults with the controls file applied, loaded on first use.
+const PadControls &ps2PadControls();
+
+// Stick byte for a deflection in [-1, 1].
+inline uint8_t ps2PadStickByte(float v)
+{
+    return v <= -1.0f ? 0x00 : (v >= 1.0f ? 0xFF : static_cast<uint8_t>(128.0f + v * 127.0f));
+}
+
+// One analog input: nothing inside the dead zone, the rest rescaled to (0, 1] and scaled by sensitivity.
+inline float ps2PadAxisStrength(float v, float deadzone, float sensitivity)
+{
+    if (v <= deadzone || deadzone >= 1.0f)
+        return 0.0f;
+    const float s = (v - deadzone) / (1.0f - deadzone) * sensitivity;
+    return s > 1.0f ? 1.0f : s;
+}
+
+// Mouse speed in pixels per 1/60 s, averaged over the last kWindow seconds of pad polls: the game may poll
+// far less often than the mouse moves (once per game frame), and motion between polls must not be lost.
+class PadMouseSpeed
+{
+public:
+    static constexpr double kWindow = 0.1;
+
+    // t: seconds (monotonic), x/y: unbounded mouse position at this poll.
+    void poll(double t, float x, float y, float &dx, float &dy)
+    {
+        dx = dy = 0.0f;
+        int from = -1; // the oldest sample inside the window, else the newest one before it
+        for (int i = 0; i < m_count; ++i)
+        {
+            const Sample &s = m_samples[(m_head + i) % kSamples];
+            from = i;
+            if (t - s.t <= kWindow)
+                break;
+        }
+        if (from >= 0)
+        {
+            const Sample &s = m_samples[(m_head + from) % kSamples];
+            const double frames = (t - s.t) * 60.0;
+            if (frames > 0.0)
+            {
+                const double scale = 1.0 / (frames < 1.0 ? 1.0 : frames);
+                dx = static_cast<float>((x - s.x) * scale);
+                dy = static_cast<float>((y - s.y) * scale);
+            }
+        }
+        if (m_count == kSamples)
+        {
+            m_head = (m_head + 1) % kSamples;
+            --m_count;
+        }
+        m_samples[(m_head + m_count++) % kSamples] = {t, x, y};
+    }
+
+private:
+    static constexpr int kSamples = 16;
+    struct Sample
+    {
+        double t;
+        float x, y;
+    };
+    std::array<Sample, kSamples> m_samples{};
+    int m_head = 0, m_count = 0;
+};
+
 #endif
