+    std::string trimUpper(std::string_view text)
+    {
+        while (!text.empty() && std::isspace(static_cast<unsigned char>(text.front())))
+            text.remove_prefix(1);
+        while (!text.empty() && std::isspace(static_cast<unsigned char>(text.back())))
+            text.remove_suffix(1);
+        std::string out(text);
+        std::transform(out.begin(), out.end(), out.begin(), [](unsigned char c) { return static_cast<char>(std::toupper(c)); });
+        return out;
+    }
+
+    template <size_t N>
+    bool lookup(const Name (&table)[N], const std::string &name, int &code)
+    {
+        for (const Name &entry : table)
+            if (name == entry.name)
+            {
+                code = entry.code;
+                return true;
+            }
+        return false;
+    }
+
+    // One input token, already trimmed and upper-cased.
+    bool parseInput(const std::string &token, PadInput &input)
+    {
+        input = {PadInput::Key, 0, 0};
+        if (token.rfind("MOUSE:", 0) == 0)
+        {
+            input.kind = PadInput::Mouse;
+            return lookup(kMouseButtons, token.substr(6), input.code);
+        }
+        if (token.rfind("PAD:", 0) == 0)
+        {
+            const std::string name = token.substr(4);
+            if (!name.empty() && (name.back() == '+' || name.back() == '-'))
+            {
+                input.kind = PadInput::PadAxis;
+                input.sign = name.back() == '+' ? 1 : -1;
+                return lookup(kPadAxes, name.substr(0, name.size() - 1), input.code);
+            }
+            input.kind = PadInput::PadButton;
+            return lookup(kPadButtons, name, input.code);
+        }
+        if (token.size() == 1 && std::isalnum(static_cast<unsigned char>(token[0])))
+        {
+            input.code = token[0]; // KEY_A..KEY_Z and KEY_ZERO..KEY_NINE are the ASCII codes
+            return true;
+        }
+        if (token.size() >= 2 && token[0] == 'F' && std::all_of(token.begin() + 1, token.end(), [](unsigned char c) { return std::isdigit(c); }))
+        {
+            const int n = std::atoi(token.c_str() + 1);
+            input.code = KEY_F1 + n - 1;
+            return n >= 1 && n <= 12;
+        }
+        if (token.size() == 4 && token.rfind("KP_", 0) == 0 && std::isdigit(static_cast<unsigned char>(token[3])))
+        {
+            input.code = KEY_KP_0 + (token[3] - '0');
+            return true;
+        }
+        return lookup(kKeys, token, input.code);
+    }
