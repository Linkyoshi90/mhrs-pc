+std::vector<std::string> ps2PadParseControls(std::string_view text, PadControls &controls)
+{
+    std::vector<std::string> errors;
+    int lineNumber = 0;
+    while (!text.empty())
+    {
+        const size_t eol = text.find('\n');
+        std::string_view line = text.substr(0, eol);
+        text.remove_prefix(eol == std::string_view::npos ? text.size() : eol + 1);
+        ++lineNumber;
+        line = line.substr(0, line.find('#'));
+        const size_t eq = line.find('=');
+        const std::string key = trimUpper(line.substr(0, eq));
+        if (key.empty() && eq == std::string_view::npos)
+            continue;
+        const auto fail = [&](const std::string &what) { errors.push_back("line " + std::to_string(lineNumber) + ": " + what); };
+        if (eq == std::string_view::npos)
+        {
+            fail("expected <name> = <value>");
+            continue;
+        }
+        const std::string_view value = line.substr(eq + 1);
+        const std::string number = trimUpper(value);
+        if (key == "MOUSE_LOOK")
+            controls.mouseLook = std::strtof(number.c_str(), nullptr);
+        else if (key == "DEADZONE")
+            controls.deadzone = std::clamp(std::strtof(number.c_str(), nullptr), 0.0f, 0.9f);
+        else if (key == "SENSITIVITY")
+            controls.sensitivity = std::strtof(number.c_str(), nullptr);
+        else if (key == "INVERT_Y")
+            controls.invertY = std::atoi(number.c_str()) != 0;
+        else if (key == "GAMEPAD")
+            controls.gamepad = std::atoi(number.c_str());
+        else
+        {
+            size_t target = 0;
+            while (target < PadTargetCount && key != trimUpper(kTargetNames[target]))
+                ++target;
+            if (target == PadTargetCount)
+            {
+                fail("unknown name " + key);
+                continue;
+            }
+            std::vector<PadInput> inputs;
+            bool ok = true;
+            for (std::string_view rest = value; ok;)
+            {
+                const size_t comma = rest.find(',');
+                const std::string token = trimUpper(rest.substr(0, comma));
+                PadInput input;
+                if (!token.empty())
+                {
+                    if (parseInput(token, input))
+                        inputs.push_back(input);
+                    else
+                    {
+                        fail("unknown input " + token);
+                        ok = false;
+                    }
+                }
+                if (comma == std::string_view::npos)
+                    break;
+                rest.remove_prefix(comma + 1);
+            }
+            if (ok)
+                controls.bind[target] = std::move(inputs);
+        }
+    }
+    return errors;
+}
+
+const PadControls &ps2PadControls()
+{
+    static const PadControls controls = []
+    {
+        PadControls c = ps2PadDefaultControls();
+        const char *env = std::getenv("PS2X_CONTROLS");
+        const char *path = env ? env : "controls.ini";
+        std::ifstream file(path);
+        if (file)
+        {
+            const std::string text((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+            for (const std::string &error : ps2PadParseControls(text, c))
+                std::fprintf(stderr, "[controls] %s: %s\n", path, error.c_str());
+            std::fprintf(stderr, "[controls] loaded %s\n", path);
+        }
+        else if (env)
+            std::fprintf(stderr, "[controls] cannot open %s\n", path);
+        return c;
+    }();
+    return controls;
 }
 
