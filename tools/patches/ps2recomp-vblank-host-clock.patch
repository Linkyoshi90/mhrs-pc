+bool EeScheduler::hostVBlankDue() const noexcept
+{
+    return m_hostPacedVBlank && m_nextVBlankCycle > m_eeCycle &&
+           std::chrono::steady_clock::now() >= m_nextVBlankHost;
+}
+
+void EeScheduler::catchUpToHostVBlank() noexcept
+{
+    // The guest clock counts executed EE code and idle waits only. Host time the EE spends blocked on the
+    // GIF/VU1 worker, or running slower than a real EE, did not count, so vblank came late and the game
+    // (which steps by elapsed vblanks) ran in slow motion. A vblank whose host time has come fires now.
+    if (hostVBlankDue())
+    {
+        accountCycles(static_cast<uint32_t>(m_nextVBlankCycle - m_eeCycle)); // at most one vblank period
+    }
+}
