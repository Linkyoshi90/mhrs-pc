+        tc.Run("VU0 macro VI memory ops address VU0 data memory, not EE RAM", [](TestCase &t) {
+            auto translate = [](uint32_t op, uint8_t field) {
+                Instruction inst{};
+                inst.opcode = OPCODE_COP2;
+                inst.rs = COP2_CO | 0x4;
+                inst.rt = 6;
+                inst.rd = 14;
+                inst.function = 0x3C;
+                inst.vectorInfo.vectorField = field;
+                inst.raw = (((op >> 2) & 0x1F) << 6) | (op & 0x3);
+                CodeGenerator gen({}, {});
+                return gen.translateInstruction(inst);
+            };
+            for (uint32_t op : {static_cast<uint32_t>(VU0_S2_VLQI), static_cast<uint32_t>(VU0_S2_VLQD)})
+            {
+                const std::string out = translate(op, 0xF);
+                t.IsTrue(out.find("0x11004000u + (((uint32_t)ctx->vi[14] & 0xFFu) << 4)") != std::string::npos,
+                         "LQI/LQD ft, (is): address from is (rd) in VU0 data memory");
+                t.IsTrue(out.find("ctx->vu0_vf[6] = ") != std::string::npos, "LQI/LQD load into ft (rt)");
+            }
+            for (uint32_t op : {static_cast<uint32_t>(VU0_S2_VSQI), static_cast<uint32_t>(VU0_S2_VSQD)})
+            {
+                const std::string out = translate(op, 0xF);
+                t.IsTrue(out.find("0x11004000u + (((uint32_t)ctx->vi[6] & 0xFFu) << 4)") != std::string::npos,
+                         "SQI/SQD fs, (it): address from it (rt) in VU0 data memory");
+                t.IsTrue(out.find("ctx->vu0_vf[14]") != std::string::npos, "SQI/SQD store fs (rd)");
+                t.IsTrue(out.find("ctx->vi[6] = (ctx->vi[6]") != std::string::npos, "SQI/SQD step it");
+            }
+            t.IsTrue(translate(VU0_S2_VILWR, 0x4).find("0x11004000u + (((uint32_t)ctx->vi[14] & 0xFFu) << 4) + 4u") != std::string::npos,
+                     "VILWR.y reads the y word of the VU0 quadword");
+            t.IsTrue(translate(VU0_S2_VISWR, 0x1).find("0x11004000u + (((uint32_t)ctx->vi[14] & 0xFFu) << 4) + 12u") != std::string::npos,
+                     "VISWR.w writes the w word of the VU0 quadword");
