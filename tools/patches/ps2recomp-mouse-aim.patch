+namespace
+{
+    std::atomic<double> g_mouseAimTaken{-1.0}; // GetTime() of the last ps2PadTakeMouseAim call
+}
+
+bool ps2PadTakeMouseAim(float &dx, float &dy)
+{
+    dx = dy = 0.0f;
+    static float lastX = 0.0f, lastY = 0.0f;
+    const std::shared_ptr<const PadControls> controls = ps2PadControls();
+    if (!IsWindowReady() || ps2PadBlocked() || controls->mouseLook <= 0.0f)
+    {
+        g_mouseAimTaken.store(-1.0, std::memory_order_relaxed);
+        return false;
+    }
+    const double now = GetTime();
+    const Vector2 position = GetMousePosition(); // unbounded: the cursor is captured (DisableCursor)
+    const double previous = g_mouseAimTaken.exchange(now, std::memory_order_relaxed);
+    if (previous >= 0.0 && now - previous <= kMouseAimHold) // else start from here: no jump after a pause
+    {
+        dx = (position.x - lastX) * controls->mouseLook;
+        dy = (position.y - lastY) * controls->mouseLook * (controls->invertY ? -1.0f : 1.0f);
+    }
+    lastX = position.x;
+    lastY = position.y;
+    return true;
+}
