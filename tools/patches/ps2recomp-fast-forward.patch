+namespace
+{
+    std::atomic<bool> g_fastForward{false};
+}
+
+bool ps2PadPollFastForward()
+{
+    static const bool always = std::getenv("PS2X_FAST_FORWARD") != nullptr;
+    const bool held = always || (IsWindowReady() && targetStrength(ps2PadControls(), PadFastForward, 1.0f) > 0.5f);
+    g_fastForward.store(held, std::memory_order_relaxed);
+    return held;
+}
+
+bool ps2PadFastForward() { return g_fastForward.load(std::memory_order_relaxed); }
