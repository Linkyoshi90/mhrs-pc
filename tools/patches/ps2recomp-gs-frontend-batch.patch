index 0a342a8..ff593af 100644
--- a/ps2xRuntime/src/lib/gs/gs_async_backend.cpp
+++ b/ps2xRuntime/src/lib/gs/gs_async_backend.cpp
@@ -139,6 +139,26 @@ void GSAsyncBackend::Submit(const GSPrimitiveBatch &batch)
     Enqueue(batch, false);
 }
 
+void GSAsyncBackend::SubmitBatch(const GSPrimitiveBatch *batches, size_t count)
+{
+    std::unique_lock<std::mutex> lock(m_mutex);
+    for (size_t i = 0; i < count; ++i)
+    {
+        if (m_pending.size() >= kMaxPendingCommands)
+        {
+            m_wakeNow = true;
+            m_cv.notify_all();
+            m_cv.wait(lock, [this]() { return m_pending.size() < kMaxPendingCommands; });
+        }
+        m_pending.emplace_back(std::in_place_type<GSPrimitiveBatch>, batches[i]);
+        ++m_submitted;
+    }
+    const bool wake = m_pending.size() >= kWakeDraws;
+    lock.unlock();
+    if (wake)
+        m_cv.notify_all();
+}
