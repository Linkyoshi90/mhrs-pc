+// The EE FPU has no NaN: compares, MAX.S and MIN.S order exponent-255 patterns as numbers above 2^128 and
+// exponent 0 as zero, like the arithmetic above. A host compare is false both ways for a NaN pattern
+// (e.g. a 0xFFFFFFFF sort key), which breaks the game's sorts.
+inline bool ps2_fcmp_lt(float a, float b) { return ps2_to_double(a) < ps2_to_double(b); }
+inline bool ps2_fcmp_le(float a, float b) { return ps2_to_double(a) <= ps2_to_double(b); }
+inline bool ps2_fcmp_eq(float a, float b) { return ps2_to_double(a) == ps2_to_double(b); }
+inline float ps2_fmax(float a, float b) { return ps2_fcmp_lt(a, b) ? b : a; }
+inline float ps2_fmin(float a, float b) { return ps2_fcmp_lt(b, a) ? b : a; }
+
+// VU MAX/MINI lane by lane like the hardware: an integer compare of the sign-magnitude patterns, so an
+// exponent-255 pattern is just a big number. _mm_max_ps/_mm_min_ps return the second operand for a host NaN.
+inline __m128i ps2_vorder_key(__m128i v)
+{
+    return _mm_xor_si128(v, _mm_and_si128(_mm_srai_epi32(v, 31), _mm_set1_epi32(0x7FFFFFFF)));
+}
+inline __m128 ps2_vmax_ps(__m128 a, __m128 b)
+{
+    const __m128i ia = _mm_castps_si128(a), ib = _mm_castps_si128(b);
+    const __m128i aWins = _mm_cmpgt_epi32(ps2_vorder_key(ia), ps2_vorder_key(ib));
+    return _mm_castsi128_ps(_mm_or_si128(_mm_and_si128(aWins, ia), _mm_andnot_si128(aWins, ib)));
+}
+inline __m128 ps2_vmin_ps(__m128 a, __m128 b)
+{
+    const __m128i ia = _mm_castps_si128(a), ib = _mm_castps_si128(b);
+    const __m128i aWins = _mm_cmplt_epi32(ps2_vorder_key(ia), ps2_vorder_key(ib));
+    return _mm_castsi128_ps(_mm_or_si128(_mm_and_si128(aWins, ia), _mm_andnot_si128(aWins, ib)));
+}
