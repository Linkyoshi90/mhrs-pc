+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+// WSOLA time stretch for the SNDDRV PCM stream. Below real time the game mixes audio slower than
+// the device plays it; instead of playing what arrived and then silence (choppy), the stream is
+// stretched to the arrival rate at unchanged pitch. At real time it is a near-transparent copy.
+// Reads a stereo int16 ring (frames head/tail counters, mask = ring frames - 1); advances tail.
+// Frames up to kSearch behind tail are read too, so the ring must keep them: the producer stays
+// within kMaxQueue of tail (dropping blocks beyond it) and the ring is far larger than that.
+class SpuTimeStretch
+{
+public:
+    static constexpr uint32_t kGrain = 1024u;                // frames per grain (~21 ms at 48 kHz)
+    static constexpr uint32_t kHop = kGrain / 2u;            // output hop: periodic Hann at 50% overlap sums to 1
+    static constexpr uint32_t kOverlap = kGrain - kHop;
+    static constexpr uint32_t kSearch = 192u;                // +- frames searched for the best splice
+    // The game mixes in bursts (FMV: swings of ~65 ms): the queue needs room above the target
+    // or blocks get dropped, which skips audio and runs it ahead of the video.
+    static constexpr uint32_t kTargetQueue = 4096u;          // input frames kept ahead of the read point (~85 ms)
+    static constexpr uint32_t kMaxQueue = 8192u;             // producer drops blocks beyond this (~170 ms)
+    static constexpr uint32_t kMinQueue = kSearch + kGrain;  // below this the input is starved
+
+    SpuTimeStretch()
+    {
+        for (uint32_t i = 0; i < kGrain; ++i)
+            m_window[i] = 0.5f - 0.5f * std::cos(6.283185307f * static_cast<float>(i) / kGrain);
+    }
+
+    // produced: frames the game has mixed so far, dropped blocks included (head counts only kept ones;
+    // measuring from head would let drops slow playback, which keeps the queue full and drops more).
+    void render(const int16_t *ring, uint32_t mask, uint32_t head, uint32_t produced, uint32_t &tail,
+                int16_t *out, uint32_t frames)
+    {
+        if (frames == 0u)
+            return;
+        // Arrival rate (input frames per output frame), averaged over ~0.5 s of bursty 512-frame blocks.
+        const float alpha = std::min(1.0f, static_cast<float>(frames) / 24000.0f);
+        m_rate += alpha * (static_cast<float>(produced - m_lastProduced) / static_cast<float>(frames) - m_rate);
+        m_lastProduced = produced;
+        for (uint32_t i = 0; i < frames; ++i)
+        {
+            if (m_hopPos == kHop)
+            {
+                makeHop(ring, mask, head, tail);
+                m_hopPos = 0u;
+            }
+            out[i * 2u] = m_hopOut[m_hopPos * 2u];
+            out[i * 2u + 1u] = m_hopOut[m_hopPos * 2u + 1u];
+            ++m_hopPos;
+        }
+    }
+
+private:
+    static float mono(const int16_t *ring, uint32_t mask, uint32_t frame)
+    {
+        const uint32_t slot = frame & mask;
+        return static_cast<float>(ring[slot * 2u]) + static_cast<float>(ring[slot * 2u + 1u]);
+    }
+
+    void makeHop(const int16_t *ring, uint32_t mask, uint32_t head, uint32_t &tail)
+    {
+        const int32_t queued = static_cast<int32_t>(head - tail);
+        const bool starved = queued < static_cast<int32_t>(kMinQueue);
+        // Starved: splice from the newest input (repeats it) while fading out.
+        const uint32_t nominal = starved ? head - kMinQueue : tail;
+
+        uint32_t best = nominal;
+        if (m_havePrev)
+        {
+            // Pick the start whose first kOverlap frames best continue the previous grain
+            // (normalized cross-correlation against the previous grain's natural continuation).
+            std::array<float, kOverlap> ref;
+            std::array<float, kOverlap + 2u * kSearch> cand;
+            const uint32_t refStart = m_prevStart + kHop;
+            for (uint32_t i = 0; i < kOverlap; ++i)
+                ref[i] = mono(ring, mask, refStart + i);
+            const uint32_t candStart = nominal - kSearch;
+            for (uint32_t i = 0; i < cand.size(); ++i)
+                cand[i] = mono(ring, mask, candStart + i);
+            float energy = 0.0f;
+            for (uint32_t i = 0; i < kOverlap; ++i)
+                energy += cand[i] * cand[i];
+            float bestScore = -1e30f;
+            for (uint32_t k = 0; k <= 2u * kSearch; ++k)
+            {
+                float dot = 0.0f;
+                for (uint32_t i = 0; i < kOverlap; ++i)
+                    dot += ref[i] * cand[k + i];
+                const float score = dot / std::sqrt(std::max(energy, 0.0f) + 1.0f);
+                if (score > bestScore)
+                {
+                    bestScore = score;
+                    best = candStart + k;
+                }
+                if (k < 2u * kSearch)
+                    energy += cand[k + kOverlap] * cand[k + kOverlap] - cand[k] * cand[k];
+            }
+        }
+
+        m_gain += std::clamp((starved ? 0.0f : 1.0f) - m_gain, -0.25f, 0.25f);
+        for (uint32_t i = 0; i < kGrain; ++i)
+        {
+            const float w = m_window[i] * m_gain;
+            const uint32_t slot = (best + i) & mask;
+            m_acc[i * 2u] += w * static_cast<float>(ring[slot * 2u]);
+            m_acc[i * 2u + 1u] += w * static_cast<float>(ring[slot * 2u + 1u]);
+        }
+        for (uint32_t i = 0; i < kHop * 2u; ++i)
+            m_hopOut[i] = static_cast<int16_t>(std::clamp(std::lround(m_acc[i]), -32768l, 32767l));
+        std::memmove(m_acc.data(), m_acc.data() + kHop * 2u, kOverlap * 2u * sizeof(float));
+        std::fill(m_acc.begin() + kOverlap * 2u, m_acc.end(), 0.0f);
+        m_prevStart = best;
+        m_havePrev = true;
+
+        if (!starved)
+        {
+            // Consume at the arrival rate, steered toward kTargetQueue frames queued.
+            const float ratio = std::clamp(m_rate * (0.5f + 0.5f * static_cast<float>(queued) / kTargetQueue), 0.25f, 1.5f);
+            m_frac += static_cast<float>(kHop) * ratio;
+            const uint32_t advance = static_cast<uint32_t>(m_frac);
+            m_frac -= static_cast<float>(advance);
+            tail += advance;
+        }
+    }
+
+    std::array<float, kGrain> m_window{};
+    std::array<float, kGrain * 2u> m_acc{};
+    std::array<int16_t, kHop * 2u> m_hopOut{};
+    uint32_t m_hopPos = kHop;
+    uint32_t m_prevStart = 0u;
+    bool m_havePrev = false;
+    uint32_t m_lastProduced = 0u;
+    float m_rate = 1.0f;
+    float m_gain = 0.0f;
+    float m_frac = 0.0f;
+};
