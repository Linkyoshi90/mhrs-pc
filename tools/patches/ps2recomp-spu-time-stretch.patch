+    MiniTest::Case("SpuTimeStretch", [](TestCase &tc)
+    {
+        struct Played
+        {
+            std::vector<int16_t> left; // left channel played after the first second
+            uint32_t dropped = 0u;     // blocks dropped by onSpuStreamBlock's queue cap
+        };
+        // Feeds a 440 Hz tone at `arrival` x real time in bursts of `burst` 512-frame blocks (with
+        // onSpuStreamBlock's drop rule), stops feeding after `feedSeconds`, and plays 480-frame
+        // device callbacks for `seconds`.
+        auto play = [](float arrival, float seconds, float feedSeconds, uint32_t burst = 1u)
+        {
+            constexpr uint32_t kRing = 1u << 15u;
+            std::vector<int16_t> ring(kRing * 2u), buf(480u * 2u);
+            Played played;
+            SpuTimeStretch stretch;
+            uint32_t head = 0u, tail = 0u, produced = 0u;
+            uint64_t toneFrame = 0u;
+            float credit = 0.0f;
+            const uint32_t callbacks = static_cast<uint32_t>(seconds * 100.0f);
+            for (uint32_t c = 0; c < callbacks; ++c)
+            {
+                if (c < feedSeconds * 100.0f)
+                    credit += 480.0f * arrival;
+                for (; credit >= 512.0f * burst; credit -= 512.0f * burst)
+                {
+                    for (uint32_t b = 0; b < burst; ++b)
+                    {
+                        produced += 512u;
+                        if (head - tail + 512u > SpuTimeStretch::kMaxQueue)
+                        {
+                            toneFrame += 512u;
+                            played.dropped += c >= 100u ? 1u : 0u;
+                            continue;
+                        }
+                        for (uint32_t i = 0; i < 512u; ++i, ++head, ++toneFrame)
+                        {
+                            const auto v = static_cast<int16_t>(8000.0 * std::sin(6.283185307179586 * 440.0 * toneFrame / 48000.0));
+                            ring[(head & (kRing - 1u)) * 2u] = ring[(head & (kRing - 1u)) * 2u + 1u] = v;
+                        }
+                    }
+                }
+                stretch.render(ring.data(), kRing - 1u, head, produced, tail, buf.data(), 480u);
+                for (uint32_t i = 0; c >= 100u && i < 480u; ++i)
+                    played.left.push_back(buf[i * 2u]);
+            }
+            return played;
+        };
+        auto expectTone = [](TestCase &t, const Played &played)
+        {
+            const std::vector<int16_t> &left = played.left;
+            uint32_t quietWindows = 0u, crossings = 0u;
+            for (size_t w = 0; w + 480u <= left.size(); w += 480u)
+            {
+                double sum = 0.0;
+                for (size_t i = w; i < w + 480u; ++i)
+                    sum += static_cast<double>(left[i]) * left[i];
+                quietWindows += std::sqrt(sum / 480.0) < 0.5 * 8000.0 / std::sqrt(2.0) ? 1u : 0u;
+            }
+            for (size_t i = 1; i < left.size(); ++i)
+                crossings += (left[i - 1] < 0) != (left[i] < 0) ? 1u : 0u;
+            const double hz = crossings / 2.0 / (left.size() / 48000.0);
+            t.Equals(quietWindows, 0u, "no 10 ms window should drop out");
+            t.IsTrue(std::abs(hz - 440.0) < 440.0 * 0.02, "pitch should stay 440 Hz, got " + std::to_string(hz));
+            t.Equals(played.dropped, 0u, "no block should be dropped");
+        };
+
+        tc.Run("stretches a stream arriving at 0.45x real time without gaps at the original pitch", [&](TestCase &t)
+        {
+            expectTone(t, play(0.45f, 6.0f, 6.0f));
+        });
+        tc.Run("plays a real-time stream continuously", [&](TestCase &t)
+        {
+            expectTone(t, play(1.0f, 4.0f, 4.0f));
+        });
+        tc.Run("plays a real-time stream arriving in 60 ms bursts without dropping blocks", [&](TestCase &t)
+        {
+            expectTone(t, play(1.0f, 6.0f, 6.0f, 6u));
+        });
+        tc.Run("fades to silence once the stream stops", [&](TestCase &t)
+        {
+            const std::vector<int16_t> left = play(1.0f, 3.0f, 2.0f).left;
+            t.IsTrue(std::all_of(left.end() - 4800, left.end(), [](int16_t s) { return s == 0; }),
+                     "the last 100 ms should be silent");
+        });
+    });
