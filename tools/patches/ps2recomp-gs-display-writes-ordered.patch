+// A display register write as a GS-stage job, ordered after the GIF/VU work issued before it: the window's present
+// reads these registers, and the draws before a DISPFB flip must reach the backend first. This replaced a full drain
+// per write (the game's vblank handler writes five per frame), which kept the EE from overlapping the GIF/VU worker
+// and GS stage finishing the last frame (~20% of the EE waited there).
+// ponytail: the throttle counters are process-wide (one PS2Memory runs the game); per instance if that changes.
+static std::atomic<uint64_t> g_displayWritesPosted{0}, g_displayWritesDone{0};
+static void writeDisplayReg(PS2Memory &memory, uint64_t *reg, uint64_t mask, uint64_t bits)
+{
+    const uint64_t n = g_displayWritesPosted.fetch_add(1u, std::memory_order_relaxed) + 1u;
+    memory.postGsAfterGifVu([reg, mask, bits]()
+                            {
+                                *reg = (*reg & ~mask) | (bits & mask);
+                                g_displayWritesDone.fetch_add(1u, std::memory_order_release); });
+    // At most one frame ahead (five writes per frame here): the queues stay short and input latency stays a frame.
+    constexpr uint64_t kWritesAhead = 5u;
+    while (g_displayWritesDone.load(std::memory_order_acquire) + kWritesAhead < n)
+        std::this_thread::yield();
+}
