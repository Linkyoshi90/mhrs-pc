+        tc.Run("GS display register writes wait for the GS stage in order, CSR reads and VSINT acks do not drain", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            mem.startGifVuWorker(OrderedWorker::Mode::Async);
+            std::atomic<bool> release{false};
+            mem.postGsAfterGifVu([&release]()
+                                 {
+                                     while (!release.load())
+                                         std::this_thread::yield();
+                                 });
+            // Releases the stage after 2 s, so a drain that should not happen fails the test instead of hanging it.
+            std::atomic<bool> timedOut{false};
+            std::thread watchdog([&]()
+                                 {
+                                     const auto end = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+                                     while (!release.load() && std::chrono::steady_clock::now() < end)
+                                         std::this_thread::sleep_for(std::chrono::milliseconds(1));
+                                     timedOut = !release.exchange(true);
+                                 });
+            const uint64_t before = mem.gs().dispfb1;
+            const uint64_t flipped = before ^ 0x1234ull;
+            mem.write64(PS2_GS_PRIV_REG_BASE + 0x70u, flipped);
+            mem.write32(PS2_GS_PRIV_REG_BASE + 0x1000u, 0x8u); // VSINT ack
+            (void)mem.read64(PS2_GS_PRIV_REG_BASE + 0x1000u);
+            const uint64_t whileBlocked = mem.gs().dispfb1;
+            const bool drained = timedOut.load();
+            release = true;
+            watchdog.join();
+            t.IsTrue(!drained, "DISPFB write, VSINT ack and CSR read return while the GS stage is busy");
+            t.Equals(whileBlocked, before, "DISPFB keeps its value until the GS stage reaches the write");
+            t.Equals(mem.read64(PS2_GS_PRIV_REG_BASE + 0x70u), flipped, "reading DISPFB back sees the write");
