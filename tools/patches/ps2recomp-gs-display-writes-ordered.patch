+    // Display registers (PMODE..BGCOLOR): the GS stage applies EE writes to them in stream order (see
+    // writeDisplayReg). CSR, IMR, BUSDIR and SIGLBLID stay immediate.
+    inline bool isGsDisplayReg(uint32_t addr)
+    {
+        return ((addr - PS2_GS_PRIV_REG_BASE) & ~0x7u) <= 0x00E0u;
+    }
+
+    // CSR writes that clear SIGNAL/FINISH (bits 0..1) or request FLUSH/RESET (bits 8..9) must come after the queued GS
+    // work; acknowledging VSINT and the other interrupt bits does not.
+    inline bool csrWriteNeedsDrain(uint64_t value)
+    {
+        return (value & 0x303ull) != 0ull;
+    }
