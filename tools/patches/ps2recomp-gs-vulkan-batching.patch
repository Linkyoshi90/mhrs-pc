+void GSVulkanBackend::flushRasterBatchLocked() const
+{
+    VkState &vk = *m_vk;
+    if (!vk.batchOpen)
+        return;
+    // Mirror the current CLUT (widened u16 -> u32) for the indexed fetch path. Flush
+    // points precede every LoadClut, so one mirror per batch sees the right palette.
+    uint32_t *clutDst = static_cast<uint32_t *>(vk.clutMapped);
+    const auto &clut = m_cpu.clutEntries();
+    for (size_t i = 0; i < clut.size(); ++i)
+        clutDst[i] = clut[i];
+
+    vkEndCommandBuffer(vk.commandBuffer);
+    vkResetFences(vk.device, 1, &vk.fence);
+    VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &vk.commandBuffer;
+    if (vkQueueSubmit(vk.queue, 1, &si, vk.fence) != VK_SUCCESS ||
+        vkWaitForFences(vk.device, 1, &vk.fence, VK_TRUE, UINT64_MAX) != VK_SUCCESS)
+        std::cerr << "[gs-vulkan] raster batch submit/wait failed" << std::endl;
+    vk.batchOpen = false;
+    vk.batchCount = 0;
+}
+
+void GSVulkanBackend::flushRasterBatch() const
+{
+    if (!m_gpuOk || !m_vk)
+        return;
+    std::lock_guard<std::mutex> gpuLock(m_gpuMutex);
+    flushRasterBatchLocked();
+}
+
+uint32_t GSVulkanBackend::recordRasterDispatchLocked(bool useTrianglePipeline,
+                                                     const void *params,
+                                                     size_t paramsSize,
+                                                     uint32_t groupsX,
+                                                     uint32_t groupsY)
+{
+    VkState &vk = *m_vk;
+    if (!vk.batchOpen)
+    {
+        vkResetCommandBuffer(vk.commandBuffer, 0);
+        VkCommandBufferBeginInfo bi{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+        bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+        if (vkBeginCommandBuffer(vk.commandBuffer, &bi) != VK_SUCCESS)
+            return UINT32_MAX;
+        vk.batchOpen = true;
+        vk.batchCount = 0;
+    }
+    if (vk.batchCount >= VkState::kParamsSlotCount)
+    {
+        flushRasterBatchLocked();
+        return recordRasterDispatchLocked(useTrianglePipeline, params, paramsSize, groupsX, groupsY);
+    }
+    const uint32_t slotOffset = vk.batchCount * VkState::kParamsSlotStride;
+    std::memcpy(static_cast<uint8_t *>(vk.paramsMapped) + slotOffset, params, paramsSize);
+    vkCmdBindPipeline(vk.commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE,
+                      useTrianglePipeline ? vk.trianglePipeline : vk.rasterPipeline);
+    vkCmdBindDescriptorSets(vk.commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, vk.pipelineLayout,
+                            0, 1, &vk.descriptorSet, 1, &slotOffset);
+    vkCmdDispatch(vk.commandBuffer, groupsX, groupsY, 1);
+    // Serialize against the next dispatch: z-test/blending/texture-fetch read VRAM
+    // written by earlier primitives in the same batch.
+    VkMemoryBarrier mb{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+    mb.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    mb.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    vkCmdPipelineBarrier(vk.commandBuffer, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &mb, 0, nullptr, 0, nullptr);
+    ++vk.batchCount;
+    return slotOffset;
+}
