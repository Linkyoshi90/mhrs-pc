 #include <chrono>
+// Game frames for the HUD (F3): the game writes DISPFB1 once a frame, so count those and keep the longest gap.
+std::atomic<uint64_t> g_gameFrames{0}, g_gameFrameMaxNs{0};
+static void countGameFrame()
+{
+    static int64_t lastNs = 0;
+    const int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                            std::chrono::steady_clock::now().time_since_epoch()).count();
+    if (lastNs != 0)
+    {
+        const uint64_t gap = static_cast<uint64_t>(now - lastNs);
+        uint64_t prev = g_gameFrameMaxNs.load(std::memory_order_relaxed);
+        while (gap > prev && !g_gameFrameMaxNs.compare_exchange_weak(prev, gap, std::memory_order_relaxed))
+        {
+        }
+    }
+    lastNs = now;
+    g_gameFrames.fetch_add(1, std::memory_order_relaxed);
+}
