+    // The 6-pair copy loop LeanAccess::scaleOffsetLoop runs: node n has its pairs at cycles 0..5, saves vf06 at 3,
+    // loops to itself, and no FMAC but the MADD at 1 queues a flag entry. -1 if not, else whether the MADD does.
+    int scaleOffsetHead(const Program &program, size_t n)
+    {
+        static constexpr uint32_t kWords[6][2] = {
+            {0x81E64B7Du, 0x01C502BCu}, {0x12021001u, 0x01C431E9u}, {0x81E82B7Cu, 0x0189413Eu},
+            {0x81E61B7Cu, 0x000002FFu}, {0x520207FBu, 0x000002FFu}, {0x81C43B7Du, 0x000002FFu}};
+        const Node &x = program.nodes[n];
+        if (x.pairs.size() != 6u || !x.exitCommits.empty() || x.exit.kind != Exit::Cond || x.exit.rel != 6u ||
+            x.exit.pc != x.pc || x.exit.targets.empty() || x.exit.targets[0] != static_cast<int>(n))
+            return -1;
+        int maddFlags = 0;
+        for (size_t i = 0; i < 6u; ++i)
+        {
+            const PairCode &p = x.pairs[i];
+            if (p.pc != x.pc + 8u * i || p.lower != kWords[i][0] || p.upper != kWords[i][1] || p.issue != i || p.from != i ||
+                !p.commits.empty() || p.kick || p.saveUpper != 0u || p.saveLower != (i == 3u ? 15u : 0u) || p.viPending || p.saveVi)
+                return -1;
+            if (i == 1u)
+                maddFlags = p.fmacFlags && !p.elide ? 1 : 0;
+            else if (p.fmacFlags && !p.elide)
+                return -1;
+        }
+        return maddFlags;
+    }
