+
+        tc.Run("player 2 defaults are player 1's gamepad bindings on the second gamepad", [](TestCase &t)
+               {
+            const PadControls d = ps2PadDefaultControls();
+            t.Equals(d.gamepad, 0, "player 1 uses the first gamepad");
+            t.Equals(d.p2.gamepad, 1, "player 2 uses the second gamepad");
+            for (size_t target = 0; target < PadTargetCount; ++target)
+            {
+                std::vector<PadInput> padHalf;
+                if (target < PadSkipMovie)
+                    for (const PadInput &input : d.bind[target])
+                        if (input.kind == PadInput::PadButton || input.kind == PadInput::PadAxis)
+                            padHalf.push_back(input);
+                t.IsTrue(d.p2.bind[target] == padHalf, std::string("player 2 default of ") + ps2PadTargetName(target));
+            }
+            t.IsTrue(!d.p2.bind[PadCross].empty(), "player 2 has a cross binding");
+
+            PadControls c = ps2PadDefaultControls();
+            const auto errors = ps2PadParseControls("cross = P\ngamepad = -1\ndeadzone = 0.3\n", c);
+            t.Equals(errors.size(), static_cast<size_t>(0), "a player 1 file has no errors");
+            t.Equals(c.gamepad, -1, "gamepad = -1 means no gamepad");
+            for (size_t target = 0; target < PadTargetCount; ++target)
+                t.IsTrue(c.p2.bind[target] == d.p2.bind[target], std::string("a file without p2_ lines keeps player 2's ") + ps2PadTargetName(target));
+            t.IsTrue(sameSettings(c.p2, d.p2), "a file without p2_ lines keeps player 2's settings");
+        });
+
+        tc.Run("p2_ lines set player 2 and leave player 1 alone", [](TestCase &t)
+               {
+            const PadControls d = ps2PadDefaultControls();
+            PadControls c = ps2PadDefaultControls();
+            const auto errors = ps2PadParseControls(
+                "p2_cross = P, pad:b\np2_gamepad = -1\np2_deadzone = 0.3\np2_sensitivity = 2\np2_invert_y = 1\n"
+                "p2_skip_movie = Q\np2_mouse_look = 3\n", c);
+            t.Equals(errors.size(), static_cast<size_t>(2), "p2_skip_movie and p2_mouse_look are not player 2 names");
+            t.Equals(c.p2.bind[PadCross].size(), static_cast<size_t>(2), "p2_cross takes its two inputs");
+            t.IsTrue(c.p2.bind[PadCross][0] == PadInput{PadInput::Key, 'P', 0}, "p2_cross binds the key P");
+            t.Equals(c.p2.gamepad, -1, "p2_gamepad is read");
+            t.Equals(c.p2.deadzone, 0.3f, "p2_deadzone is read");
+            t.Equals(c.p2.sensitivity, 2.0f, "p2_sensitivity is read");
+            t.IsTrue(c.p2.invertY, "p2_invert_y is read");
+            t.IsTrue(c.p2.bind[PadSkipMovie].empty(), "player 2 has no movie skip");
+            for (size_t target = 0; target < PadTargetCount; ++target)
+                t.IsTrue(c.bind[target] == d.bind[target], std::string("player 1 keeps ") + ps2PadTargetName(target));
+            t.IsTrue(sameSettings(c, d), "player 1 keeps its settings");
+            t.Equals(c.mouseLook, d.mouseLook, "mouse_look is untouched");
+        });
+
+        tc.Run("a controls file with player 2 changes reads back the same", [](TestCase &t)
+               {
+            PadControls c = ps2PadDefaultControls();
+            const auto setup = ps2PadParseControls(
+                "gamepad = 2\nr1 = mouse:left\np2_cross = P, pad:b\np2_move_up = W\np2_r1 =\np2_gamepad = -1\n"
+                "p2_deadzone = 0.35\np2_sensitivity = 1.5\np2_invert_y = 1\n", c);
+            t.Equals(setup.size(), static_cast<size_t>(0), "the setup text is valid");
+            const std::string text = ps2PadFormatControls(c);
+            t.IsTrue(text.find("p2_skip_movie") == std::string::npos && text.find("p2_mouse_look") == std::string::npos,
+                     "player 1 only names are not written for player 2");
+            PadControls back = ps2PadDefaultControls();
+            back.p2.bind[PadCross].clear();
+            back.p2.gamepad = 3;
+            const auto errors = ps2PadParseControls(text, back);
+            t.Equals(errors.size(), static_cast<size_t>(0), "the written file has no errors");
+            for (size_t target = 0; target < PadTargetCount; ++target)
+            {
+                t.IsTrue(back.bind[target] == c.bind[target], std::string("player 1 ") + ps2PadTargetName(target) + " survives");
+                t.IsTrue(back.p2.bind[target] == c.p2.bind[target], std::string("player 2 ") + ps2PadTargetName(target) + " survives");
+            }
+            t.IsTrue(sameSettings(back, c), "player 1 settings survive");
+            t.IsTrue(sameSettings(back.p2, c.p2), "player 2 settings survive");
+            t.Equals(back.p2.gamepad, -1, "p2_gamepad = -1 survives");
