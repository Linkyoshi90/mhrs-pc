+        tc.Run("pad port 2 is connected only with a player 2 device, and the players stay apart", [](TestCase &t)
+               {
+            std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0);
+            R5900Context ctx;
+            PSPadBackend backend;
+            uint8_t data[32];
+            ps2PadSetInputSource(heldKeyInput);
+            g_heldKey = 0;
+
+            // Defaults: no window, so no gamepad is plugged in; player 2 has no keys.
+            ps2PadSetControls(ps2PadDefaultControls());
+            t.IsTrue(backend.readState(0, 0, data, sizeof(data)), "port 1 always has a controller");
+            const uint8_t idle[8] = {0x01, 0x73, 0xFF, 0xFF, 0x80, 0x80, 0x80, 0x80};
+            t.IsTrue(std::equal(idle, idle + 8, data), "port 1 idle state is unchanged");
+            g_heldKey = 'X';
+            backend.readState(0, 0, data, sizeof(data));
+            t.Equals(static_cast<uint16_t>(data[2] | (data[3] << 8)), static_cast<uint16_t>(0xFFFFu & ~kPadBtnCross), "X still presses cross on port 1");
+            g_heldKey = 'W';
+            backend.readState(0, 0, data, sizeof(data));
+            t.Equals(data[7], static_cast<uint8_t>(0x00), "W still pushes port 1's left stick up");
+            g_heldKey = 0;
+
+            t.IsTrue(!ps2PadConnected(1), "port 2 is empty without a player 2 device");
+            t.IsTrue(!backend.readState(1, 0, data, sizeof(data)), "an empty port 2 has no pad state");
+            ps2_stubs::scePadInit(rdram.data(), &ctx, nullptr);
+            openPadPort(ctx, rdram, 0);
+            openPadPort(ctx, rdram, 1);
+            t.Equals(padGetState(ctx, rdram, 0), static_cast<uint32_t>(6), "port 1 is STABLE");
+            t.Equals(padGetState(ctx, rdram, 1), static_cast<uint32_t>(0), "an empty port 2 is DISCONNECTED");
+            setRegU32(ctx, 4, 1u);
+            setRegU32(ctx, 5, 0u);
+            setRegU32(ctx, 6, kPadDataAddr);
+            ps2_stubs::scePadRead(rdram.data(), &ctx, nullptr);
+            t.Equals(static_cast<uint32_t>(getRegU32(&ctx, 2)), static_cast<uint32_t>(0), "scePadRead fails on an empty port 2");
+
+            PadControls c = ps2PadDefaultControls();
+            c.p2.gamepad = -1;
+            ps2PadSetControls(c);
+            t.IsTrue(!ps2PadConnected(1), "p2_gamepad = -1 without keys leaves port 2 empty");
+
+            c.p2.bind[PadCross] = {PadInput{PadInput::Key, 'P', 0}};
+            ps2PadSetControls(c);
+            t.IsTrue(ps2PadConnected(1), "a player 2 key binding connects port 2");
+            t.Equals(padGetState(ctx, rdram, 1), static_cast<uint32_t>(6), "port 2 with a key binding is STABLE");
+            t.IsTrue(backend.readState(1, 0, data, sizeof(data)), "port 2 has pad state");
+            t.Equals(static_cast<uint16_t>(data[2] | (data[3] << 8)), static_cast<uint16_t>(0xFFFF), "port 2 idle has no buttons");
+
+            g_heldKey = 'P';
+            backend.readState(0, 0, data, sizeof(data));
+            t.Equals(static_cast<uint16_t>(data[2] | (data[3] << 8)), static_cast<uint16_t>(0xFFFF), "player 2's key does not press port 1");
+            backend.readState(1, 0, data, sizeof(data));
+            t.Equals(static_cast<uint16_t>(data[2] | (data[3] << 8)), static_cast<uint16_t>(0xFFFFu & ~kPadBtnCross), "player 2's key presses cross on port 2");
+
+            g_heldKey = 'X';
+            backend.readState(0, 0, data, sizeof(data));
+            t.Equals(static_cast<uint16_t>(data[2] | (data[3] << 8)), static_cast<uint16_t>(0xFFFFu & ~kPadBtnCross), "player 1's key presses cross on port 1");
+            backend.readState(1, 0, data, sizeof(data));
+            t.Equals(static_cast<uint16_t>(data[2] | (data[3] << 8)), static_cast<uint16_t>(0xFFFF), "player 1's key does not press port 2");
+
+            g_heldKey = 0;
+            ps2PadSetInputSource(nullptr);
+            ps2PadSetControls(ps2PadDefaultControls());
+            closePadPort(ctx, rdram, 0);
+            closePadPort(ctx, rdram, 1);
+        });
     });
