+    // Host input for the pad state tests: only the key in g_heldKey is down.
+    int g_heldKey = 0;
+    float heldKeyInput(const PadInput &input, int /*gamepad*/)
+    {
+        return input.kind == PadInput::Key && input.code == g_heldKey ? 1.0f : 0.0f;
+    }
+
+    uint32_t padGetState(R5900Context &ctx, std::vector<uint8_t> &rdram, uint32_t port)
+    {
+        setRegU32(ctx, 4, port);
+        setRegU32(ctx, 5, 0u);
+        ps2_stubs::scePadGetState(rdram.data(), &ctx, nullptr);
+        return static_cast<uint32_t>(getRegU32(&ctx, 2));
+    }
+
+    bool sameSettings(const PadPlayer &a, const PadPlayer &b)
+    {
+        return a.deadzone == b.deadzone && a.sensitivity == b.sensitivity && a.invertY == b.invertY && a.gamepad == b.gamepad;
+    }
 }
 
