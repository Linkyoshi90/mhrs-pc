+bool GSVulkanBackend::VkState::createBuffer(VkDeviceSize size, VkBufferUsageFlags usage, bool hostVisible, VkBuffer &outBuffer, void **outMapped)
+{
+    VkBufferCreateInfo bufferInfo{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+    bufferInfo.size = size;
+    bufferInfo.usage = usage;
+    bufferInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    if (vkCreateBuffer(device, &bufferInfo, nullptr, &outBuffer) != VK_SUCCESS)
+        return false;
+    allocations.emplace_back(outBuffer, VK_NULL_HANDLE);
+
+    VkMemoryRequirements reqs{};
+    vkGetBufferMemoryRequirements(device, outBuffer, &reqs);
+    VkPhysicalDeviceMemoryProperties props{};
+    vkGetPhysicalDeviceMemoryProperties(phys, &props);
+    // Host buffers are read and written by the CPU backend: uncached (write-combined)
+    // memory makes every read a bus round trip, so prefer HOST_CACHED.
+    const VkMemoryPropertyFlags host = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+    const VkMemoryPropertyFlags wanted[2] = {hostVisible ? (host | VK_MEMORY_PROPERTY_HOST_CACHED_BIT) : VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+                                             hostVisible ? host : 0u};
+    uint32_t typeIndex = UINT32_MAX;
+    for (const VkMemoryPropertyFlags flags : wanted)
+        for (uint32_t i = 0; i < props.memoryTypeCount && typeIndex == UINT32_MAX; ++i)
+            if ((reqs.memoryTypeBits & (1u << i)) && (props.memoryTypes[i].propertyFlags & flags) == flags)
+                typeIndex = i;
+    if (typeIndex == UINT32_MAX)
+        return false;
+
+    VkMemoryAllocateInfo allocInfo{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    allocInfo.allocationSize = reqs.size;
+    allocInfo.memoryTypeIndex = typeIndex;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    if (vkAllocateMemory(device, &allocInfo, nullptr, &memory) != VK_SUCCESS)
+        return false;
+    allocations.back().second = memory;
+    if (vkBindBufferMemory(device, outBuffer, memory, 0) != VK_SUCCESS)
+        return false;
+    return !outMapped || vkMapMemory(device, memory, 0, size, 0, outMapped) == VK_SUCCESS;
+}
