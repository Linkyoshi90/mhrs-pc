+bool GSVulkanBackend::VkState::createStream(Stream &stream, uint32_t stride, uint32_t capacity)
+{
+    stream.stride = stride;
+    void *mapped = nullptr;
+    const VkDeviceSize size = static_cast<VkDeviceSize>(stride) * capacity;
+    if (!createBuffer(size, VK_BUFFER_USAGE_TRANSFER_SRC_BIT, true, stream.host, &mapped) ||
+        !createBuffer(size, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT, false, stream.dev, nullptr))
+        return false;
+    stream.mapped = static_cast<uint8_t *>(mapped);
+    return true;
