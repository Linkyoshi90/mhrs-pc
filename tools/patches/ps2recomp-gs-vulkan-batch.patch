         });
+
+        tc.Run("Vulkan batch raster matches the CPU backend on overlapping primitives", [](TestCase &t)
+        {
+            // Without a Vulkan device the Vulkan backend is the CPU backend and this passes trivially.
+            static char rasterEnv[] = "PS2X_VK_RASTER=1";
+            putenv(rasterEnv);
+            constexpr uint32_t kTexCt32 = 8192u, kTexT8 = 8256u, kClut = 16380u; // palette in the last VRAM page
+
+            auto scene = [&](GSRasterBackend &backend, std::vector<uint8_t> &vram)
+            {
+                backend.Initialize(vram.data(), static_cast<uint32_t>(vram.size()));
+                uint32_t seed = 12345u;
+                auto rnd = [&](uint32_t n)
+                {
+                    seed = seed * 1664525u + 1013904223u;
+                    return (seed >> 8) % n;
+                };
+                auto upload = [&](uint32_t dbp, uint8_t psm, uint32_t bytes)
+                {
+                    GSTransferCommand command;
+                    command.bitbltbuf.dbp = dbp;
+                    command.bitbltbuf.dbw = 1;
+                    command.bitbltbuf.dpsm = psm;
+                    command.trxreg.rrw = 16;
+                    command.trxreg.rrh = 16;
+                    command.direction = 0;
+                    std::vector<uint8_t> data(bytes);
+                    for (uint8_t &byte : data)
+                        byte = static_cast<uint8_t>(rnd(256u));
+                    backend.BeginTransfer(command);
+                    backend.UploadImage(data.data(), bytes);
+                };
+                upload(kTexCt32, GS_PSM_CT32, 1024u);
+                upload(kTexT8, GS_PSM_T8, 256u);
+                upload(kClut, GS_PSM_CT32, 1024u);
+
+                for (uint32_t i = 0; i < 400u; ++i)
+                {
+                    GSPrimitiveBatch batch;
+                    GSContext &ctx = batch.state.context;
+                    ctx.frame.fbw = 2;
+                    ctx.scissor = {0, 127, 0, 63};
+                    ctx.zbuf.zbp = 4;
+                    ctx.zbuf.psm = GS_PSM_Z32;
+                    ctx.zbuf.zmask = rnd(4u) == 0u;
+                    ctx.test = rnd(4u) == 0u ? 0x30000ull : 0x50000ull; // depth always / greater-or-equal
+                    ctx.alpha = 0x44ull;                                 // (Cs - Cd) * As + Cd
+                    const bool sprite = rnd(3u) == 0u;
+                    batch.state.prim.type = i == 150u ? GS_PRIM_LINE : (sprite ? GS_PRIM_SPRITE : GS_PRIM_TRIANGLE);
+                    batch.state.prim.abe = rnd(2u) != 0u;
+                    batch.state.prim.iip = rnd(2u) != 0u;
+                    batch.state.prim.tme = rnd(2u) != 0u;
+                    batch.state.prim.fst = rnd(2u) != 0u;
+                    batch.state.linearFilter = rnd(2u) != 0u;
+                    batch.state.textureWidth = batch.state.textureHeight = 16;
+                    ctx.tex0.tbw = 1;
+                    ctx.tex0.tw = ctx.tex0.th = 4;
+                    ctx.tex0.tcc = 1;
+                    if (rnd(2u) != 0u)
+                    {
+                        ctx.tex0.tbp0 = kTexT8;
+                        ctx.tex0.psm = GS_PSM_T8;
+                        ctx.tex0.cbp = kClut;
+                        ctx.tex0.cld = 1;
+                        if (batch.state.prim.tme)
+                            backend.LoadClut(ctx.tex0, batch.state.texclut);
+                    }
+                    else
+                        ctx.tex0.tbp0 = kTexCt32;
+                    batch.vertexCount = (sprite || i == 150u) ? 2 : 3;
+                    for (uint32_t k = 0; k < batch.vertexCount; ++k)
+                    {
+                        GSVertex &v = batch.vertices[k];
+                        v.x = static_cast<float>(rnd(144u)) - 8.0f + static_cast<float>(rnd(16u)) / 16.0f;
+                        v.y = static_cast<float>(rnd(80u)) - 8.0f + static_cast<float>(rnd(16u)) / 16.0f;
+                        v.z = rnd(0x1000000u);
+                        v.r = static_cast<uint8_t>(rnd(256u));
+                        v.g = static_cast<uint8_t>(rnd(256u));
+                        v.b = static_cast<uint8_t>(rnd(256u));
+                        v.a = static_cast<uint8_t>(rnd(256u));
+                        v.s = static_cast<float>(rnd(1000u)) / 1000.0f;
+                        v.t = static_cast<float>(rnd(1000u)) / 1000.0f;
+                        v.u = static_cast<uint16_t>(rnd(256u));
+                        v.v = static_cast<uint16_t>(rnd(256u));
+                    }
+                    if (i == 250u)
+                        upload(kTexCt32, GS_PSM_CT32, 1024u); // later primitives see the new texels, earlier ones the old
+                    backend.Submit(batch);
+                }
+            };
+
+            std::vector<uint8_t> cpuVram(4u * 1024u * 1024u), vkVram(cpuVram.size());
+            GSCpuBackend cpu;
+            GSVulkanBackend vk;
+            scene(cpu, cpuVram);
+            scene(vk, vkVram);
+            uint32_t drawn = 0u, wrong = 0u;
+            for (uint32_t y = 0; y < 64u; ++y)
+            {
+                for (uint32_t x = 0; x < 128u; ++x)
+                {
+                    const uint32_t a = cpu.ReadVram(GS_PSM_CT32, 0u, 2u, x, y);
+                    const uint32_t b = vk.ReadVram(GS_PSM_CT32, 0u, 2u, x, y);
+                    drawn += a != 0u ? 1u : 0u;
+                    for (uint32_t shift = 0; shift < 32u; shift += 8u)
+                    {
+                        const int delta = static_cast<int>((a >> shift) & 0xFFu) - static_cast<int>((b >> shift) & 0xFFu);
+                        if (delta < -2 || delta > 2) // a GPU may round a float differently, no more
+                        {
+                            ++wrong;
+                            break;
+                        }
+                    }
+                }
+            }
+            t.IsTrue(drawn > 4000u, "the scene should cover most of the frame");
+            t.Equals(wrong, 0u, "Vulkan batch raster should match the CPU backend pixel for pixel, up to rounding");
+        });
     });
 }
