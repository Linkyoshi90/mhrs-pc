index 0000000..be71451
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/shaders/raster_batch.comp
@@ -0,0 +1,152 @@
+#version 450
+
+// Batch rasterizer for the Vulkan GS backend: one dispatch per batch of sprites and
+// triangles that share a frame and depth buffer. A workgroup is one 8x8 pixel tile; every
+// invocation walks the tile's list in draw order, so overlapping primitives keep PS2 order.
+// Mirrors GSCpuBackend::DrawSprite / DrawTriangle.
+
+#extension GL_EXT_shader_explicit_arithmetic_types_float64 : enable
+#extension GL_GOOGLE_include_directive : enable
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+#include "gs_raster_common.glsl"
+
+layout(push_constant) uniform Push
+{
+    uint tileBase;  // first tile header word of the batch in tiles[]
+    uint tileCount;
+} pc;
+
+void drawSprite(int x, int y)
+{
+    uint r = gm.vertR, g = gm.vertG, b = gm.vertB, a = gm.vertA;
+
+    if (pr.tme != 0u)
+    {
+        // precise: no FMA contraction — must round like the CPU's scalar float ops
+        precise const float ty = (float(y - gm.unclippedY0) + 0.5) / gm.spriteH;
+        precise const float tx = (float(x - gm.unclippedX0) + 0.5) / gm.spriteW;
+        precise const float texVf = gm.v0f + (gm.v1f - gm.v0f) * ty;
+        precise const float texUf = gm.u0f + (gm.u1f - gm.u0f) * tx;
+
+        uint texel;
+        if (pr.fst != 0u)
+        {
+            // precise: texUf * 16 + 0.5 must not fuse into an FMA (CPU rounds as two ops)
+            precise const float fixedUf = texUf * 16.0 + 0.5;
+            precise const float fixedVf = texVf * 16.0 + 0.5;
+            const uint sampleU = uint(clampInt(int(fixedUf), 0, 65535));
+            const uint sampleV = uint(clampInt(int(fixedVf), 0, 65535));
+            texel = sampleTexture(0.0, 0.0, 1.0, sampleU, sampleV);
+        }
+        else
+        {
+            texel = sampleTexture(texUf / float(pr.texW), texVf / float(pr.texH), 1.0, 0u, 0u);
+        }
+        combineTexture(texel & 0xFFu, (texel >> 8u) & 0xFFu, (texel >> 16u) & 0xFFu, (texel >> 24u) & 0xFFu, r, g, b, a);
+    }
+
+    writePixelPipe(x, y, gm.z1, r, g, b, a, gm.vertFog);
+}
+
+void drawTriangle(int x, int y)
+{
+    // Edge functions at pixel centers — same operation order as the CPU path
+    // (precise: no FMA contraction, rounding must match the scalar float ops).
+    precise const float px = float(x) + 0.5;
+    precise const float py = float(y) + 0.5;
+    precise const float dx = px - gm.fx2;
+    precise const float rowTerm0 = (gm.fx2 - gm.fx1) * (py - gm.fy2);
+    precise const float rowTerm1 = (gm.fx0 - gm.fx2) * (py - gm.fy2);
+    precise const float w0 = ((gm.edgeA0 * dx + rowTerm0) * gm.winding) * gm.invAbsDenom;
+    precise const float w1 = ((gm.edgeA1 * dx + rowTerm1) * gm.winding) * gm.invAbsDenom;
+    precise const float w2 = (1.0 - w0) - w1;
+    if (w0 < -0.0001 || w1 < -0.0001 || w2 < -0.0001)
+        return;
+
+    uint r, g, b, a;
+    if (pr.iip != 0u)
+    {
+        precise const float ir = (gm.attrR0 * w0 + gm.attrR1 * w1) + gm.attrR2 * w2;
+        precise const float ig = (gm.attrG0 * w0 + gm.attrG1 * w1) + gm.attrG2 * w2;
+        precise const float ib = (gm.attrB0 * w0 + gm.attrB1 * w1) + gm.attrB2 * w2;
+        precise const float ia = (gm.attrA0 * w0 + gm.attrA1 * w1) + gm.attrA2 * w2;
+        r = clampU8(int(ir));
+        g = clampU8(int(ig));
+        b = clampU8(int(ib));
+        a = clampU8(int(ia));
+    }
+    else
+    {
+        // Flat shading: vertex 2 color (exact small ints in float).
+        r = uint(gm.attrR2);
+        g = uint(gm.attrG2);
+        b = uint(gm.attrB2);
+        a = uint(gm.attrA2);
+    }
+
+    if (pr.tme != 0u)
+    {
+        precise const float isv = (gm.attrS0 * w0 + gm.attrS1 * w1) + gm.attrS2 * w2;
+        precise const float itv = (gm.attrT0 * w0 + gm.attrT1 * w1) + gm.attrT2 * w2;
+        uint texel;
+        if (pr.fst != 0u)
+        {
+            // FST interpolates the raw 4.12 fixed-point UVs; the CPU truncates to u16.
+            texel = sampleTexture(0.0, 0.0, 1.0, uint(int(isv)) & 0xFFFFu, uint(int(itv)) & 0xFFFFu);
+        }
+        else
+        {
+            // The GS DDA interpolates homogeneous S, T, Q; texel coordinates come from
+            // S/Q and T/Q only after interpolation (done inside sampleTexture).
+            precise const float iqv = (gm.attrQ0 * w0 + gm.attrQ1 * w1) + gm.attrQ2 * w2;
+            texel = sampleTexture(isv, itv, iqv, 0u, 0u);
+        }
+        combineTexture(texel & 0xFFu, (texel >> 8u) & 0xFFu, (texel >> 16u) & 0xFFu, (texel >> 24u) & 0xFFu, r, g, b, a);
+    }
+
+    // Fog is always interpolated, independent of IIP.
+    precise const float fogf = (gm.attrFog0 * w0 + gm.attrFog1 * w1) + gm.attrFog2 * w2;
+    const uint fog = clampU8(int(fogf));
+
+    // Z in double precision like the CPU; trunc(z + 0.5) matches static_cast<u32>.
+    // precise: no reassociation/FMA of the double chain — 1 ulp flips the truncated Z.
+    precise const float64_t zw0 = gm.triZ0 * float64_t(w0);
+    precise const float64_t zw1 = gm.triZ1 * float64_t(w1);
+    precise const float64_t zw2 = gm.triZ2 * float64_t(w2);
+    precise const float64_t z = (zw0 + zw1) + zw2;
+    // static_cast<u32> on x86 truncates toward zero and wraps two's-complement;
+    // GLSL's uint() is undefined for negatives, so wrap explicitly.
+    float64_t zt = trunc(z + 0.5);
+    if (zt < 0.0)
+        zt += 4294967296.0;
+    const uint zValue = uint(min(zt, 4294967295.0));
+
+    writePixelPipe(x, y, zValue, r, g, b, a, fog);
+}
+
+void main()
+{
+    // Dispatched as (min(tileCount, 256), ceil(tileCount / 256), 1) workgroups.
+    const uint tile = gl_WorkGroupID.y * 256u + gl_WorkGroupID.x;
+    if (tile >= pc.tileCount)
+        return;
+    const uint header = pc.tileBase + tile * 3u;
+    const uint key = tiles[header];
+    const int x = int(key & 0xFFu) * 8 + int(gl_LocalInvocationID.x);
+    const int y = int(key >> 8u) * 8 + int(gl_LocalInvocationID.y);
+    const uint first = tiles[header + 1u];
+    const uint end = first + tiles[header + 2u];
+    for (uint i = first; i < end; ++i)
+    {
+        geomIndex = tiles[i];
+        if (x < gm.minX || x > gm.maxX || y < gm.minY || y > gm.maxY)
+            continue;
+        stateIndex = gm.state;
+        if (gm.kind == 0u)
+            drawSprite(x, y);
+        else
+            drawTriangle(x, y);
+    }
+}
