+    {
+        const uint32_t push[3] = {first * (kPageBytes / 4u), count * (kPageBytes / 4u), scale};
+        vkCmdPushConstants(cb, pipelineLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(push), push);
+        vkCmdDispatch(cb, (push[1] + 63u) / 64u, 1, 1);
+    });
+    barrier(cb);
+}
