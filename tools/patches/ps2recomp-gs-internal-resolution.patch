+// Refills the high-resolution copy of pages from their native words (recorded in order with the draws).
+void GSVulkanBackend::VkState::upsample(VkCommandBuffer cb, const PageSet &pages)
+{
+    vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, upsamplePipeline);
+    vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, pipelineLayout, 0, 1, &descriptorSet, 0, nullptr);
