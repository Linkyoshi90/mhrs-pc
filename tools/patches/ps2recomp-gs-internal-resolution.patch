index 0000000..8fb1bac
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/shaders/shadow_upsample.comp
@@ -0,0 +1,35 @@
+#version 450
+
+// Internal resolution: makes the high-resolution copy of GS memory pages valid again from their native words
+// (every sample of a word gets the word), before a high-resolution draw writes into them.
+
+layout(local_size_x = 64) in;
+
+layout(set = 0, binding = 0, std430) readonly buffer Vram
+{
+    uint vram[];
+};
+
+layout(set = 0, binding = 6, std430) writeonly buffer Shadow
+{
+    uint shadow[];
+};
+
+layout(push_constant) uniform Push
+{
+    uint firstWord;
+    uint wordCount;
+    uint scale;
+} pc;
+
+void main()
+{
+    const uint i = gl_GlobalInvocationID.x;
+    if (i >= pc.wordCount)
+        return;
+    const uint word = pc.firstWord + i;
+    const uint value = vram[word];
+    const uint samples = pc.scale * pc.scale;
+    for (uint k = 0u; k < samples; ++k)
+        shadow[word * samples + k] = value;
+}
