@@ -0,0 +1,75 @@
+#version 450
+
+// Internal resolution: the display buffer (CT32/CT24) at scale x its size, packed RGBA8, from the high-resolution
+// copy of GS memory where its page is valid and from native GS memory (each pixel repeated) where it is not.
+
+layout(local_size_x = 64) in;
+
+layout(set = 0, binding = 0, std430) readonly buffer Vram
+{
+    uint vram[];
+};
+
+layout(set = 0, binding = 1, std430) writeonly buffer OutPixels
+{
+    uint outPixels[];
+};
+
+layout(set = 0, binding = 6, std430) readonly buffer Shadow
+{
+    uint shadow[];
+};
+
+layout(push_constant) uniform Push
+{
+    uint basePtr; // blocks
+    uint fbw;
+    uint psm;     // 0 = CT32, 1 = CT24
+    uint width;   // native display size
+    uint height;
+    uint originX;
+    uint originY;
+    uint flags;   // bit0: preserveAlpha
+    uint scale;
+    uint valid[16];
+} pc;
+
+const uint BlockTableC32[32] = uint[](
+    0u, 1u, 4u, 5u, 16u, 17u, 20u, 21u,
+    2u, 3u, 6u, 7u, 18u, 19u, 22u, 23u,
+    8u, 9u, 12u, 13u, 24u, 25u, 28u, 29u,
+    10u, 11u, 14u, 15u, 26u, 27u, 30u, 31u);
+
+const uint ColumnTable32[64] = uint[](
+    0u, 1u, 4u, 5u, 8u, 9u, 12u, 13u,
+    2u, 3u, 6u, 7u, 10u, 11u, 14u, 15u,
+    16u, 17u, 20u, 21u, 24u, 25u, 28u, 29u,
+    18u, 19u, 22u, 23u, 26u, 27u, 30u, 31u,
+    32u, 33u, 36u, 37u, 40u, 41u, 44u, 45u,
+    34u, 35u, 38u, 39u, 42u, 43u, 46u, 47u,
+    48u, 49u, 52u, 53u, 56u, 57u, 60u, 61u,
+    50u, 51u, 54u, 55u, 58u, 59u, 62u, 63u);
+
+void main()
+{
+    const uint outW = pc.width * pc.scale;
+    const uint gid = gl_GlobalInvocationID.y * 65535u * 64u + gl_GlobalInvocationID.x;
+    if (gid >= outW * pc.height * pc.scale)
+        return;
+    const uint ox = gid % outW;
+    const uint oy = gid / outW;
+    const uint sx = pc.originX + ox / pc.scale;
+    const uint sy = pc.originY + oy / pc.scale;
+    const uint page = (pc.basePtr >> 5u) + (sy >> 5u) * pc.fbw + (sx >> 6u);
+    const uint block = BlockTableC32[((sy >> 3u) & 3u) * 8u + ((sx >> 3u) & 7u)];
+    const uint column = ColumnTable32[(sy & 7u) * 8u + (sx & 7u)];
+    const uint addr = (page * 2048u + ((pc.basePtr & 31u) + block) * 64u + column) & 0xFFFFFu;
+    const uint vpage = addr >> 11u;
+    uint word;
+    if (((pc.valid[vpage >> 5u] >> (vpage & 31u)) & 1u) != 0u)
+        word = shadow[addr * pc.scale * pc.scale + (oy % pc.scale) * pc.scale + (ox % pc.scale)];
+    else
+        word = vram[addr];
+    const uint alpha = ((pc.flags & 1u) != 0u && pc.psm == 0u) ? (word >> 24u) : 255u;
+    outPixels[gid] = (word & 0x00FFFFFFu) | (alpha << 24u);
+}
