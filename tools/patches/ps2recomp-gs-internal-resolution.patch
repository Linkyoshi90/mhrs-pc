+#ifndef GS_HIRES_H
+#define GS_HIRES_H
+
+#include <cstdint>
+#include <vector>
+
+// Internal resolution of the Vulkan GS backend: PS2X_VK_SCALE=2..4 draws 32-bit frame buffers at that many times
+// the native resolution as well, and each present publishes the display at that size (packed RGBA8, width x
+// height) for the window. 1 (the default) or no Vulkan: nothing is published.
+uint32_t gsHiresScale();
+void gsHiresPublish(std::vector<uint8_t> &&pixels, uint32_t width, uint32_t height);
+// The frame published since the last call, if any (pixels is swapped with it).
+bool gsHiresTake(std::vector<uint8_t> &pixels, uint32_t &width, uint32_t &height);
+
+#endif
