     }
 
+    void writeNamedIrx(TestHost &host, uint32_t address, const char *moduleName)
+    {
+        constexpr uint32_t codeOffset = 0x100u;
+        constexpr uint32_t iopModOffset = 0xC0u;
+        constexpr uint32_t loadAddress = 0x00010000u;
+
+        ElfHeader header{};
+        header.ident[0] = 0x7Fu;
+        header.ident[1] = 'E';
+        header.ident[2] = 'L';
+        header.ident[3] = 'F';
+        header.ident[4] = 1u;
+        header.ident[5] = 1u;
+        header.ident[6] = 1u;
+        header.type = 2u;
+        header.machine = 8u;
+        header.version = 1u;
+        header.entry = loadAddress;
+        header.phoff = sizeof(ElfHeader);
+        header.ehsize = sizeof(ElfHeader);
+        header.phentsize = sizeof(ProgramHeader);
+        header.phnum = 2u;
+
+        const uint32_t code[] = {
+            0x03E00008u, // jr   ra
+            0x24020002u, // addiu v0, zero, 2 (REMOVABLE_RESIDENT_END: stays loaded)
+        };
+        // IOPMOD: moduleinfo, entry, gp, text/data/bss sizes, u16 version, then the name.
+        std::vector<uint8_t> iopMod(0x1Au + std::strlen(moduleName) + 1u, 0u);
+        const uint32_t entry = loadAddress;
+        std::memcpy(iopMod.data() + 4u, &entry, sizeof(entry));
+        std::memcpy(iopMod.data() + 0x1Au, moduleName, std::strlen(moduleName));
+
+        ProgramHeader iopModule{};
+        iopModule.type = 0x70000080u; // PT_SCE_IOPMOD
+        iopModule.offset = iopModOffset;
+        iopModule.filesz = static_cast<uint32_t>(iopMod.size());
+        iopModule.memsz = iopModule.filesz;
+        iopModule.align = 4u;
+
+        ProgramHeader program{};
+        program.type = 1u;
+        program.offset = codeOffset;
+        program.vaddr = loadAddress;
+        program.paddr = loadAddress;
+        program.filesz = sizeof(code);
+        program.memsz = sizeof(code);
+        program.flags = 5u;
+        program.align = 4u;
+
+        std::memset(host.guest.data() + address, 0, codeOffset + sizeof(code));
+        std::memcpy(host.guest.data() + address, &header, sizeof(header));
+        std::memcpy(host.guest.data() + address + sizeof(header), &iopModule, sizeof(iopModule));
+        std::memcpy(host.guest.data() + address + sizeof(header) + sizeof(iopModule), &program, sizeof(program));
+        std::memcpy(host.guest.data() + address + iopModOffset, iopMod.data(), iopMod.size());
+        std::memcpy(host.guest.data() + address + codeOffset, code, sizeof(code));
+    }
+
     void writeRpcServerIrx(TestHost &host,
                            uint32_t address,
                            uint32_t sid = 0xF00DCAFEu)
@@ -1179,6 +1237,20 @@ int main()
         }
     }
 
+    // SearchModuleByName finds loaded modules by their IOPMOD name, not their file name.
+    {
+        TestHost namedHost(0x20000u);
+        IopSubsystem namedIop(namedHost);
+        writeNamedIrx(namedHost, 0x100u, "sio2man");
+        const ModuleLoadResult sio2man = namedIop.loadModuleBuffer(0x100u);
+        writeNamedIrx(namedHost, 0x100u, "multitap_manager");
+        const ModuleLoadResult mtap = namedIop.loadModuleBuffer(0x100u);
+        if (!expect(sio2man.moduleId > 0 && mtap.moduleId > 0, "named test modules must load")) return 1;
+        if (!expect(namedIop.searchModuleByName("sio2man") == sio2man.moduleId, "search must find sio2man by IOPMOD name")) return 1;
+        if (!expect(namedIop.searchModuleByName("multitap_manager") == mtap.moduleId, "search must find multitap_manager")) return 1;
+        if (!expect(namedIop.searchModuleByName("padman") < 0, "unknown module names must not match")) return 1;
+    }
+
     std::cout << "ps2xIOP emulator smoke tests passed\n";
     return 0;
 }
