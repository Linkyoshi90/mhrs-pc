+    // int sceSifSearchModuleByName(const char *name): IOP module id, or KE_UNKNOWN_MODULE (-202).
+    void sceSifSearchModuleByName(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        constexpr int32_t kUnknownModule = -202;
+        std::string name;
+        for (uint32_t address = getRegU32(ctx, 4); name.size() < 64u; ++address)
+        {
+            const uint8_t *c = getConstMemPtr(rdram, address);
+            if (!c || *c == 0u)
+                break;
+            name.push_back(static_cast<char>(*c));
+        }
+        const int32_t id = runtime && !name.empty() ? runtime->iopSubsystem().searchModuleByName(name) : -1;
+        setReturnS32(ctx, id >= 0 ? id : kUnknownModule);
+    }
