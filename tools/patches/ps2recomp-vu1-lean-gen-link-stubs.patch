+// Link stubs for ps2x_vu1_lean_gen: ps2_runtime references the recompiled-function
+// table that only exists in generated runner code (ps2xRuntime/src/runner/, produced
+// per game by ps2_recomp). The lean VU1 generator never looks up recompiled EE
+// functions, so empty tables are enough to link standalone.
+#include "ps2_runtime.h"
+
+extern const uint32_t g_ps2RecompiledFunctionTableBase = 0u;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = 0u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = 0u;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[1] = {};
