+    // Host implementation of a hot IRX function. When a module named `module` loads and the FNV-1a hash of
+    // the words at base+offset, each ANDed with its mask (clear bits = relocated fields), equals `maskedHash`,
+    // the entry instruction is replaced by a trap that runs `call` instead of interpreting the guest code and
+    // then returns to $ra. `call` gets the entry address, the 32 GPRs and physical IOP RAM, and returns the
+    // guest cycles to charge. A hash keeps the original code out of the caller's sources.
+    struct NativeFunction
+    {
+        std::string module; // IRX file name, case-insensitive, ";1" suffix ignored (e.g. "SNDDRV.IRX")
+        uint32_t offset = 0;
+        std::vector<uint32_t> masks; // one per instruction word covered by the check
+        uint32_t maskedHash = 0;
+        std::function<uint32_t(uint32_t entry, uint32_t *gpr, std::span<uint8_t> ram)> call;
+    };
+
+    // FNV-1a over (word & mask) for each word, as used by NativeFunction::maskedHash.
+    inline uint32_t nativeMaskedHash(const uint32_t *words, const uint32_t *masks, size_t count)
+    {
+        uint32_t hash = 2166136261u;
+        for (size_t i = 0; i < count; ++i)
+        {
+            const uint32_t value = words[i] & masks[i];
+            for (int b = 0; b < 4; ++b)
+                hash = (hash ^ ((value >> (8 * b)) & 0xFFu)) * 16777619u;
+        }
+        return hash;
+    }
